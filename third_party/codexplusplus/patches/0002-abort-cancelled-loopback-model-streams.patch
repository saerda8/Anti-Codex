+async fn wait_for_downstream_disconnect<R>(reader: &mut R)
+where
+    R: tokio::io::AsyncRead + Unpin,
+{
+    let mut byte = [0_u8; 1];
+    loop {
+        match reader.read(&mut byte).await {
+            Ok(0) | Err(_) => return,
+            Ok(_) => {}
+        }
+    }
+}
+
+fn request_wants_stream(request_json: Option<&serde_json::Value>) -> bool {
+    request_json
+        .and_then(|request| request.get("stream"))
+        .and_then(serde_json::Value::as_bool)
+        .unwrap_or(false)
+}
+
+async fn collect_abortive_body(
+    response: hyper::Response<hyper::body::Incoming>,
+) -> anyhow::Result<Vec<u8>> {
+    Ok(response.into_body().collect().await?.to_bytes().to_vec())
+}
+
+async fn try_handle_abortive_protocol_proxy_stream(
+    stream: &mut tokio::net::TcpStream,
+    request_body: &str,
+    request_user_agent: Option<&str>,
+    request_json: Option<&serde_json::Value>,
+    method: &str,
+    path: &str,
+    remote_addr_text: Option<String>,
+) -> anyhow::Result<bool> {
+    let open_upstream = crate::protocol_proxy::open_abortive_loopback_responses_proxy_request(
+        request_body,
+        request_user_agent,
+    );
+    let open_result = tokio::select! {
+        result = open_upstream => result,
+        _ = wait_for_downstream_disconnect(stream) => return Ok(true),
+    };
+    let upstream = match open_result {
+        Ok(Some(upstream)) => upstream,
+        Ok(None) => return Ok(false),
+        Err(error) => {
+            let body = serde_json::to_vec(
+                &serde_json::json!({ "status": "failed", "message": error.to_string() }),
+            )?;
+            write_http_response(
+                stream,
+                "502 Bad Gateway",
+                "application/json; charset=utf-8",
+                &body,
+            )
+            .await?;
+            log_helper_response(
+                "helper.protocol_proxy_failed",
+                method,
+                path,
+                "502 Bad Gateway",
+                remote_addr_text,
+            );
+            stream.shutdown().await?;
+            return Ok(true);
+        }
+    };
+    let status = upstream.status();
+    if !upstream.is_success() {
+        let status_code = upstream.status_code;
+        let content_type = upstream.content_type.clone();
+        let upstream_body = collect_abortive_body(upstream.response).await?;
+        let error = crate::protocol_proxy::responses_error_from_upstream(
+            status_code,
+            &content_type,
+            &upstream_body,
+        );
+        let body = serde_json::to_vec(&error)?;
+        write_http_response(stream, &status, "application/json; charset=utf-8", &body).await?;
+        log_helper_response(
+            "helper.protocol_proxy_upstream_error",
+            method,
+            path,
+            &status,
+            remote_addr_text,
+        );
+        stream.shutdown().await?;
+        return Ok(true);
+    }
+
+    write_http_stream_headers(stream, "200 OK", "text/event-stream; charset=utf-8").await?;
+    let wire_api = upstream.wire_api;
+    let mut upstream_body = upstream.response.into_body();
+    let (mut downstream_reader, mut downstream_writer) = stream.split();
+    if wire_api == crate::protocol_proxy::UpstreamWireApi::Responses {
+        loop {
+            tokio::select! {
+                frame = upstream_body.frame() => match frame {
+                    Some(Ok(frame)) => {
+                        if let Ok(bytes) = frame.into_data() {
+                            downstream_writer.write_all(&bytes).await?;
+                        }
+                    }
+                    Some(Err(error)) => return Err(error.into()),
+                    None => break,
+                },
+                _ = wait_for_downstream_disconnect(&mut downstream_reader) => return Ok(true),
+            }
+        }
+    } else {
+        let mut converter = request_json
+            .map(crate::protocol_proxy::ChatSseToResponsesConverter::with_request)
+            .unwrap_or_default();
+        let mut stream_failed = false;
+        loop {
+            tokio::select! {
+                frame = upstream_body.frame() => match frame {
+                    Some(Ok(frame)) => {
+                        if let Ok(bytes) = frame.into_data() {
+                            let converted = converter.push_bytes(&bytes);
+                            if !converted.is_empty() {
+                                downstream_writer.write_all(&converted).await?;
+                            }
+                        }
+                    }
+                    Some(Err(error)) => {
+                        let failed = converter.fail(
+                            format!("Stream error: {error}"),
+                            Some("stream_error".to_string()),
+                        );
+                        if !failed.is_empty() {
+                            downstream_writer.write_all(&failed).await?;
+                        }
+                        stream_failed = true;
+                        break;
+                    }
+                    None => break,
+                },
+                _ = wait_for_downstream_disconnect(&mut downstream_reader) => return Ok(true),
+            }
+        }
+        if !stream_failed {
+            let tail = converter.finish();
+            if !tail.is_empty() {
+                downstream_writer.write_all(&tail).await?;
+            }
+        }
+    }
+    log_helper_response(
+        "helper.protocol_proxy_stream_ok",
+        method,
+        path,
+        "200 OK",
+        remote_addr_text,
+    );
+    downstream_writer.shutdown().await?;
+    Ok(true)
+}
+
+async fn try_handle_abortive_chat_completions_proxy_stream(
+    stream: &mut tokio::net::TcpStream,
+    request_body: &str,
+    request_user_agent: Option<&str>,
+    method: &str,
+    path: &str,
+    remote_addr_text: Option<String>,
+) -> anyhow::Result<bool> {
+    let open_upstream =
+        crate::protocol_proxy::open_abortive_loopback_chat_completions_proxy_request(
+            request_body,
+            request_user_agent,
+        );
+    let open_result = tokio::select! {
+        result = open_upstream => result,
+        _ = wait_for_downstream_disconnect(stream) => return Ok(true),
+    };
+    let upstream = match open_result {
+        Ok(Some(upstream)) => upstream,
+        Ok(None) => return Ok(false),
+        Err(error) => {
+            let body = serde_json::to_vec(
+                &serde_json::json!({ "status": "failed", "message": error.to_string() }),
+            )?;
+            write_http_response(
+                stream,
+                "502 Bad Gateway",
+                "application/json; charset=utf-8",
+                &body,
+            )
+            .await?;
+            log_helper_response(
+                "helper.chat_completions_proxy_failed",
+                method,
+                path,
+                "502 Bad Gateway",
+                remote_addr_text,
+            );
+            stream.shutdown().await?;
+            return Ok(true);
+        }
+    };
+    let status = upstream.status();
+    let content_type = if upstream.content_type.is_empty() {
+        "application/json; charset=utf-8".to_string()
+    } else {
+        upstream.content_type.clone()
+    };
+    if !upstream.is_stream || !upstream.is_success() {
+        let is_success = upstream.is_success();
+        let body = collect_abortive_body(upstream.response).await?;
+        write_http_response(stream, &status, &content_type, &body).await?;
+        log_helper_response(
+            if is_success {
+                "helper.chat_completions_proxy_ok"
+            } else {
+                "helper.chat_completions_proxy_upstream_error"
+            },
+            method,
+            path,
+            &status,
+            remote_addr_text,
+        );
+        stream.shutdown().await?;
+        return Ok(true);
+    }
+
+    write_http_stream_headers(stream, &status, &content_type).await?;
+    let mut upstream_body = upstream.response.into_body();
+    let (mut downstream_reader, mut downstream_writer) = stream.split();
+    loop {
+        tokio::select! {
+            frame = upstream_body.frame() => match frame {
+                Some(Ok(frame)) => {
+                    if let Ok(bytes) = frame.into_data() {
+                        downstream_writer.write_all(&bytes).await?;
+                    }
+                }
+                Some(Err(error)) => return Err(error.into()),
+                None => break,
+            },
+            _ = wait_for_downstream_disconnect(&mut downstream_reader) => return Ok(true),
+        }
+    }
+    log_helper_response(
+        "helper.chat_completions_proxy_stream_ok",
+        method,
+        path,
+        &status,
+        remote_addr_text,
+    );
+    downstream_writer.shutdown().await?;
+    Ok(true)
+}
