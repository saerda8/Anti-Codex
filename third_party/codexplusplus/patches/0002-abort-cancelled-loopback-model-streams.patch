+        .headers()
+        .get(hyper::header::CONTENT_TYPE)
+        .and_then(|value| value.to_str().ok())
+        .unwrap_or("")
+        .to_string();
+    Ok(Some(AbortiveUpstreamProxyResponse {
+        status_code,
+        content_type,
+        is_stream: true,
+        wire_api: UpstreamWireApi::ChatCompletions,
+        response: upstream,
+    }))
