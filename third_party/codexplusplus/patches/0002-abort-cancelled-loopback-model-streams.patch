diff --git a/crates/codex-plus-core/src/abortive_http.rs b/crates/codex-plus-core/src/abortive_http.rs
new file mode 100644
index 0000000..1de0caf
--- /dev/null
+++ b/crates/codex-plus-core/src/abortive_http.rs
@@ -0,0 +1,132 @@
+use std::error::Error;
+use std::future::Future;
+use std::net::IpAddr;
+use std::pin::Pin;
+use std::task::{Context, Poll};
+use std::time::Duration;
+
+use anyhow::Context as _;
+use bytes::Bytes;
+use http_body_util::Full;
+use hyper::header::{ACCEPT, AUTHORIZATION, CACHE_CONTROL, CONTENT_TYPE, USER_AGENT};
+use hyper::{Method, Request, Uri};
+use hyper_util::client::legacy::Client;
+use hyper_util::client::legacy::connect::HttpConnector;
+use hyper_util::rt::{TokioExecutor, TokioIo};
+use tokio::net::TcpStream;
+use tower_service::Service;
+
+type BoxError = Box<dyn Error + Send + Sync>;
+
+#[derive(Clone, Debug)]
+struct AbortiveLoopbackConnector {
+    inner: HttpConnector,
+}
+
+impl AbortiveLoopbackConnector {
+    fn new() -> Self {
+        let mut inner = HttpConnector::new();
+        inner.enforce_http(true);
+        Self { inner }
+    }
+}
+
+impl Service<Uri> for AbortiveLoopbackConnector {
+    type Response = TokioIo<TcpStream>;
+    type Error = BoxError;
+    type Future = Pin<Box<dyn Future<Output = Result<Self::Response, Self::Error>> + Send>>;
+
+    fn poll_ready(&mut self, cx: &mut Context<'_>) -> Poll<Result<(), Self::Error>> {
+        self.inner
+            .poll_ready(cx)
+            .map_err(|error| Box::new(error) as BoxError)
+    }
+
+    fn call(&mut self, uri: Uri) -> Self::Future {
+        let future = self.inner.call(uri);
+        Box::pin(async move {
+            let stream = future.await.map_err(|error| Box::new(error) as BoxError)?;
+            stream
+                .inner()
+                .set_zero_linger()
+                .context("failed to enable abortive close on loopback model connection")?;
+            Ok(stream)
+        })
+    }
+}
+
+pub fn supports(endpoint: &str) -> bool {
+    let Ok(uri) = endpoint.parse::<Uri>() else {
+        return false;
+    };
+    if uri.scheme_str() != Some("http") {
+        return false;
+    }
+    let Some(host) = uri.host() else {
+        return false;
+    };
+    let host = host
+        .strip_prefix('[')
+        .and_then(|host| host.strip_suffix(']'))
+        .unwrap_or(host);
+    host.eq_ignore_ascii_case("localhost")
+        || host
+            .parse::<IpAddr>()
+            .is_ok_and(|address| address.is_loopback())
+}
+
+pub async fn post_json(
+    endpoint: &str,
+    api_key: &str,
+    user_agent: &str,
+    body: &serde_json::Value,
+    timeout: Duration,
+) -> anyhow::Result<hyper::Response<hyper::body::Incoming>> {
+    anyhow::ensure!(
+        supports(endpoint),
+        "abortive model transport only supports HTTP loopback endpoints"
+    );
+    let uri = endpoint
+        .parse::<Uri>()
+        .context("invalid loopback model endpoint")?;
+    let mut request = Request::builder()
+        .method(Method::POST)
+        .uri(uri)
+        .header(AUTHORIZATION, format!("Bearer {}", api_key.trim()))
+        .header(CONTENT_TYPE, "application/json")
+        .header(ACCEPT, "text/event-stream")
+        .header(CACHE_CONTROL, "no-cache");
+    if !user_agent.trim().is_empty() {
+        request = request.header(USER_AGENT, user_agent.trim());
+    }
+    let request = request
+        .body(Full::new(Bytes::from(serde_json::to_vec(body)?)))
+        .context("failed to build loopback model request")?;
+    let client = Client::builder(TokioExecutor::new())
+        .pool_max_idle_per_host(0)
+        .build(AbortiveLoopbackConnector::new());
+    tokio::time::timeout(timeout, client.request(request))
+        .await
+        .with_context(|| {
+            format!(
+                "loopback model request exceeded {} seconds before response headers",
+                timeout.as_secs()
+            )
+        })?
+        .context("loopback model request failed")
+}
+
+#[cfg(test)]
+mod tests {
+    use super::supports;
+
+    #[test]
+    fn only_plain_http_loopback_endpoints_are_supported() {
+        assert!(supports("http://127.0.0.1:57321/v1/chat/completions"));
+        assert!(supports("http://[::1]:57321/v1/chat/completions"));
+        assert!(supports("http://localhost:57321/v1/chat/completions"));
+        assert!(!supports("https://127.0.0.1/v1/chat/completions"));
+        assert!(!supports("http://example.com/v1/chat/completions"));
+        assert!(!supports("not a URL"));
+    }
+}
