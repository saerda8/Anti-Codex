+fn relay_profile_by_id(settings: &BackendSettings, id: &str) -> Option<RelayProfile> {
+    settings
+        .relay_profiles
+        .iter()
+        .find(|profile| profile.id == id)
+        .cloned()
+}
+
+fn relay_model_list_contains(profile: &RelayProfile, model: &str) -> bool {
+    profile
+        .model_list
+        .split(['\r', '\n', ','])
+        .map(str::trim)
+        .any(|entry| entry == model)
+}
+
+fn metadata_marks_codex_compaction(metadata: &Value) -> bool {
+    metadata
+        .get("request_kind")
+        .and_then(Value::as_str)
+        .is_some_and(|kind| kind == CODEX_COMPACTION_REQUEST_KIND)
+}
+
+fn request_is_codex_compaction(request_json: &Value) -> bool {
+    let Some(metadata) = request_json
+        .get("client_metadata")
+        .and_then(Value::as_object)
+        .and_then(|client_metadata| client_metadata.get(CODEX_TURN_METADATA_KEY))
+    else {
+        return false;
+    };
+
+    match metadata {
+        Value::String(serialized) => serde_json::from_str::<Value>(serialized)
+            .ok()
+            .as_ref()
+            .is_some_and(metadata_marks_codex_compaction),
+        Value::Object(_) => metadata_marks_codex_compaction(metadata),
+        _ => false,
+    }
+}
+
+fn anticodex_model_is_routable(settings: &BackendSettings, model: &str) -> bool {
+    if model == ANTICODEX_THIRD_PARTY_MODEL_SLOT
+        || model.starts_with(ANTICODEX_THIRD_PARTY_MODEL_PREFIX)
+    {
+        return true;
+    }
+    relay_profile_by_id(settings, ANTICODEX_ANTIGRAVITY_RELAY_ID)
+        .as_ref()
+        .is_some_and(|relay| {
+            model == ANTICODEX_ANTIGRAVITY_MODEL_SLOT || relay_model_list_contains(relay, model)
+        })
+}
+
+fn align_codex_compaction_model_with_selected(
+    settings: &BackendSettings,
+    request_json: &mut Value,
+    selected_model: Option<&str>,
+) -> bool {
+    if !request_is_codex_compaction(request_json) {
+        return false;
+    }
+    if request_json
+        .get("model")
+        .and_then(Value::as_str)
+        .is_some_and(|model| anticodex_model_is_routable(settings, model.trim()))
+    {
+        return false;
+    }
+    let Some(selected_model) = selected_model
+        .map(str::trim)
+        .filter(|model| !model.is_empty())
+        .filter(|model| anticodex_model_is_routable(settings, model))
+    else {
+        return false;
+    };
+    if request_json.get("model").and_then(Value::as_str) == Some(selected_model) {
+        return false;
+    }
+    request_json["model"] = Value::String(selected_model.to_string());
+    true
+}
+
+fn align_codex_compaction_model_with_live_selection(
+    settings: &BackendSettings,
+    request_json: &mut Value,
+) -> bool {
+    if !request_is_codex_compaction(request_json) {
+        return false;
+    }
+    let config_path = crate::codex_home::default_codex_home_dir().join("config.toml");
+    let selected_model = std::fs::read_to_string(config_path)
+        .ok()
+        .and_then(|contents| crate::relay_config::root_key_string(&contents, "model"));
+    align_codex_compaction_model_with_selected(settings, request_json, selected_model.as_deref())
+}
+
+fn select_anticodex_relay_for_model(
+    settings: &BackendSettings,
+    request_json: &mut Value,
+) -> anyhow::Result<Option<RelayProfile>> {
+    let Some(requested_model) = request_json
+        .get("model")
+        .and_then(Value::as_str)
+        .map(str::trim)
+        .filter(|model| !model.is_empty())
+        .map(str::to_string)
+    else {
+        return Ok(None);
+    };
+
+    if requested_model == ANTICODEX_THIRD_PARTY_MODEL_SLOT
+        || requested_model.starts_with(ANTICODEX_THIRD_PARTY_MODEL_PREFIX)
+    {
+        let relay = relay_profile_by_id(settings, ANTICODEX_THIRD_PARTY_RELAY_ID)
+            .ok_or_else(|| anyhow::anyhow!("Anti-Codex third-party relay is not configured"))?;
+        let upstream_model = requested_model
+            .strip_prefix(ANTICODEX_THIRD_PARTY_MODEL_PREFIX)
+            .filter(|model| !model.is_empty())
+            .unwrap_or(relay.test_model.trim());
+        if upstream_model.is_empty() {
+            anyhow::bail!("Anti-Codex third-party model is not configured");
+        }
+        request_json["model"] = Value::String(upstream_model.to_string());
+        return Ok(Some(relay));
+    }
+
+    let Some(relay) = relay_profile_by_id(settings, ANTICODEX_ANTIGRAVITY_RELAY_ID) else {
+        if requested_model == ANTICODEX_ANTIGRAVITY_MODEL_SLOT {
+            anyhow::bail!("Anti-Codex Antigravity relay is not configured");
+        }
+        return Ok(None);
+    };
+    if requested_model == ANTICODEX_ANTIGRAVITY_MODEL_SLOT {
+        let upstream_model = relay.test_model.trim();
+        if upstream_model.is_empty() {
+            anyhow::bail!("Anti-Codex Antigravity model is not configured");
+        }
+        request_json["model"] = Value::String(upstream_model.to_string());
+        return Ok(Some(relay));
+    }
+    if relay_model_list_contains(&relay, &requested_model) {
+        return Ok(Some(relay));
+    }
+    Ok(None)
+}
