+        assert_eq!(relay.id, ANTICODEX_ANTIGRAVITY_RELAY_ID);
+        assert_eq!(request["model"], "claude-sonnet-4-6");
+    }
+
+    #[test]
+    fn compaction_ignores_an_unroutable_live_selection() {
