+fn accumulate_streamed_identity(current: &mut String, fragment: &str) {
+    if fragment.is_empty() || fragment == current {
+        return;
+    }
+    if fragment.starts_with(current.as_str()) {
+        current.clear();
+    }
+    current.push_str(fragment);
