+fn request_has_apply_patch_tool(tools: Option<&Value>) -> bool {
+    tools.and_then(Value::as_array).is_some_and(|tools| {
+        tools.iter().any(|tool| {
+            if tool.as_str() == Some("apply_patch") {
+                return true;
+            }
+            let name = tool
+                .get("name")
+                .or_else(|| tool.pointer("/function/name"))
+                .and_then(Value::as_str)
+                .unwrap_or("");
+            !name.is_empty()
+                && detect_codex_custom_tool_kind(tool, name) == CodexCustomToolKind::ApplyPatch
+        })
+    })
+}
+
+fn guide_command_tools_away_from_file_edits(tools: &mut [Value]) {
+    const GUIDANCE: &str = "Do not use this command tool for file edits when apply_patch tools are available; call the apply_patch structured tools directly. Use this command tool only for commands, builds, tests, and inspection.";
+
+    for tool in tools {
+        let Some(function) = tool.get_mut("function").and_then(Value::as_object_mut) else {
+            continue;
+        };
+        let name = function.get("name").and_then(Value::as_str).unwrap_or("");
+        if !matches!(name, "exec_command" | "shell_command") {
+            continue;
+        }
+        let current = function
+            .get("description")
+            .and_then(Value::as_str)
+            .unwrap_or("")
+            .trim();
+        let description = if current.is_empty() {
+            GUIDANCE.to_string()
+        } else {
+            format!("{current} {GUIDANCE}")
+        };
+        function.insert("description".to_string(), Value::String(description));
+    }
 }
 
