+fn align_codex_compaction_model_with_selected(
+    settings: &BackendSettings,
+    request_json: &mut Value,
+    turn_metadata: Option<&str>,
+    selected_model: Option<&str>,
+) -> bool {
+    if !request_is_codex_compaction(request_json, turn_metadata) {
+        return false;
+    }
+    if request_json
+        .get("model")
+        .and_then(Value::as_str)
+        .is_some_and(|model| anticodex_model_is_routable(settings, model.trim()))
+    {
+        return false;
+    }
+    let Some(selected_model) = selected_model
+        .map(str::trim)
+        .filter(|model| !model.is_empty())
+        .filter(|model| anticodex_model_is_routable(settings, model))
+    else {
+        return false;
+    };
+    if request_json.get("model").and_then(Value::as_str) == Some(selected_model) {
+        return false;
+    }
+    request_json["model"] = Value::String(selected_model.to_string());
+    true
+}
+
+fn align_codex_compaction_model_with_live_selection(
+    settings: &BackendSettings,
+    request_json: &mut Value,
+    turn_metadata: Option<&str>,
+) -> bool {
+    let codex_home = crate::codex_home::default_codex_home_dir();
+    align_codex_compaction_model_with_live_selection_from_home(
+        settings,
+        request_json,
+        turn_metadata,
+        &codex_home,
+    )
+}
+
+fn align_codex_compaction_model_with_live_selection_from_home(
+    settings: &BackendSettings,
+    request_json: &mut Value,
+    turn_metadata: Option<&str>,
+    codex_home: &Path,
+) -> bool {
+    if !request_is_codex_compaction(request_json, turn_metadata) {
+        return false;
+    }
+    if let Some(selected_model) = codex_compaction_thread_id(request_json, turn_metadata)
+        .and_then(|thread_id| latest_thread_model_from_rollout(codex_home, &thread_id))
+        .filter(|model| anticodex_model_is_routable(settings, model))
+    {
+        if request_json.get("model").and_then(Value::as_str) == Some(selected_model.as_str()) {
+            return false;
+        }
+        request_json["model"] = Value::String(selected_model);
+        return true;
+    }
+    let config_path = codex_home.join("config.toml");
+    let selected_model = std::fs::read_to_string(config_path)
+        .ok()
+        .and_then(|contents| crate::relay_config::root_key_string(&contents, "model"));
+    align_codex_compaction_model_with_selected(
+        settings,
+        request_json,
+        turn_metadata,
+        selected_model.as_deref(),
+    )
+}
