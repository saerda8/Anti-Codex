+        request_json,
+        policy_path,
+    )
+}
+
+fn apply_anticodex_prompt_policy_for_protocol(
+    relay_id: &str,
+    relay_protocol: RelayProtocol,
+    mut request_json: Value,
+    policy_path: Option<&Path>,
+) -> Value {
+    if !matches!(
+        relay_id,
+        ANTICODEX_ANTIGRAVITY_RELAY_ID | ANTICODEX_THIRD_PARTY_RELAY_ID
+    ) {
+        return request_json;
+    }
+    let Some(policy_path) = policy_path.filter(|path| valid_prompt_policy_path(path)) else {
+        return request_json;
+    };
+    let default_content = merged_native_prompt(&request_json);
+    let Some(policy) = read_anticodex_prompt_policy(Some(policy_path)) else {
+        record_native_prompt_snapshot(
+            policy_path,
+            relay_id,
+            relay_protocol,
+            &default_content,
+            &default_content,
+            "passthrough",
+        );
+        return request_json;
+    };
+    let system_is_default = policy.system.enabled && policy.system.content.is_none();
+    let developer_is_default = policy.developer.enabled && policy.developer.content.is_none();
+    let user_add_on = policy
+        .user
+        .enabled
+        .then_some(policy.user.content.as_deref().unwrap_or_default())
+        .filter(|content| !content.is_empty());
+    let mut policy_mode = if !system_is_default {
+        if policy.system.enabled {
+            "custom"
+        } else {
+            "disabled"
+        }
+    } else if !developer_is_default {
+        if policy.developer.enabled {
+            "legacy_developer_custom"
+        } else {
+            "legacy_developer_disabled"
+        }
+    } else {
+        "default"
+    }
+    .to_string();
+    if user_add_on.is_some() {
+        policy_mode.push_str("+user");
+    }
+    if system_is_default && developer_is_default && user_add_on.is_none() {
+        record_native_prompt_snapshot(
+            policy_path,
+            relay_id,
+            relay_protocol,
+            &default_content,
+            &default_content,
+            &policy_mode,
+        );
+        return request_json;
+    }
+
+    let appends_to_native_instructions =
+        system_is_default && (policy.developer.content.is_some() || user_add_on.is_some());
+    if appends_to_native_instructions && !supported_instruction_carrier(&request_json) {
+        record_native_prompt_snapshot(
+            policy_path,
+            relay_id,
+            relay_protocol,
+            &default_content,
+            &default_content,
+            "passthrough_unsupported",
+        );
+        return request_json;
+    }
+
+    if !system_is_default {
+        remove_instruction_carriers(&mut request_json);
+        if policy.system.enabled {
+            set_instructions(
+                &mut request_json,
+                policy.system.content.as_deref().unwrap_or_default(),
+            );
+        }
+    } else if !developer_is_default {
+        remove_developer_carriers(&mut request_json);
+        if policy.developer.enabled {
+            append_instructions(
+                &mut request_json,
+                policy.developer.content.as_deref().unwrap_or_default(),
+            );
+        }
+    }
+
+    if let Some(content) = user_add_on {
+        append_instructions(&mut request_json, content);
+    }
+    let effective_content = merged_native_prompt(&request_json);
+    record_native_prompt_snapshot(
+        policy_path,
+        relay_id,
+        relay_protocol,
+        &default_content,
+        &effective_content,
+        &policy_mode,
+    );
+    request_json
+}
+
+fn read_anticodex_prompt_policy(path: Option<&Path>) -> Option<AntiCodexPromptPolicy> {
+    let path = path.filter(|path| valid_prompt_policy_path(path))?;
+    let metadata = std::fs::metadata(path).ok()?;
+    if !metadata.is_file() || metadata.len() > ANTICODEX_PROMPT_POLICY_MAX_BYTES {
+        return None;
+    }
+    let value: Value = serde_json::from_str(&std::fs::read_to_string(path).ok()?).ok()?;
+    if value.get("schema").and_then(Value::as_str) != Some(ANTICODEX_PROMPT_POLICY_SCHEMA) {
+        return None;
+    }
+    Some(AntiCodexPromptPolicy {
+        system: parse_prompt_layer(value.get("codexSystem")?, true)?,
+        developer: value
+            .get("codexDeveloper")
+            .map(|value| parse_prompt_layer(value, true))
+            .unwrap_or(Some(AntiCodexPromptLayer {
+                enabled: true,
+                content: None,
+            }))?,
+        user: parse_prompt_layer(value.get("user")?, false)?,
+    })
+}
+
+fn valid_prompt_policy_path(path: &Path) -> bool {
+    path.is_absolute()
+        && path.file_name().and_then(|name| name.to_str()) == Some("prompt-policy.json")
+}
+
+fn record_native_prompt_snapshot(
+    policy_path: &Path,
+    relay_id: &str,
+    relay_protocol: RelayProtocol,
+    default_content: &str,
+    effective_content: &str,
+    policy_mode: &str,
+) {
+    let default_sha256 = format!("{:x}", Sha256::digest(default_content.as_bytes()));
+    let effective_sha256 = format!("{:x}", Sha256::digest(effective_content.as_bytes()));
+    let identity = AntiCodexPromptSnapshotIdentity {
+        relay_id: relay_id.to_string(),
+        protocol: relay_protocol,
+        default_sha256: default_sha256.clone(),
+        effective_sha256: effective_sha256.clone(),
+        policy_mode: policy_mode.to_string(),
+    };
+    let Ok(mut last_identity) = ANTICODEX_PROMPT_SNAPSHOT_IDENTITY.lock() else {
+        return;
+    };
+    if last_identity.as_ref() == Some(&identity) {
+        return;
+    }
+    let snapshot_path = policy_path.with_file_name(ANTICODEX_NATIVE_PROMPT_SNAPSHOT_FILE);
+    if let Some(existing) = std::fs::read(&snapshot_path)
+        .ok()
+        .and_then(|bytes| serde_json::from_slice::<Value>(&bytes).ok())
+    {
+        let same_snapshot = existing.get("relayId").and_then(Value::as_str) == Some(relay_id)
+            && existing.get("protocol").and_then(Value::as_str)
+                == Some(match relay_protocol {
+                    RelayProtocol::Responses => "responses",
+                    RelayProtocol::ChatCompletions => "chatCompletions",
+                })
+            && existing.get("defaultSha256").and_then(Value::as_str)
+                == Some(default_sha256.as_str())
+            && existing.get("effectiveSha256").and_then(Value::as_str)
+                == Some(effective_sha256.as_str())
+            && existing.get("policyMode").and_then(Value::as_str) == Some(policy_mode);
+        if same_snapshot {
+            *last_identity = Some(identity);
+            return;
+        }
+    }
+    let updated_at = SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .map(|duration| u64::try_from(duration.as_millis()).unwrap_or(u64::MAX))
+        .unwrap_or_default();
+    let snapshot = json!({
+        "schema": ANTICODEX_NATIVE_PROMPT_SNAPSHOT_SCHEMA,
+        "updatedAt": updated_at,
+        "relayId": relay_id,
+        "protocol": match relay_protocol {
+            RelayProtocol::Responses => "responses",
+            RelayProtocol::ChatCompletions => "chatCompletions",
+        },
+        "defaultContent": default_content,
+        "defaultSha256": default_sha256,
+        "effectiveContent": effective_content,
+        "effectiveSha256": effective_sha256,
+        "policyMode": policy_mode,
+    });
+    let Ok(bytes) = serde_json::to_vec_pretty(&snapshot) else {
+        return;
+    };
+    if crate::settings::atomic_write(&snapshot_path, &bytes).is_ok() {
+        *last_identity = Some(identity);
+    }
+}
+
+fn merged_native_prompt(body: &Value) -> String {
+    let mut chunks = Vec::new();
+    if let Some(instructions) = body.get("instructions") {
+        push_prompt_chunk(&mut chunks, instruction_text(instructions));
+    }
+    for key in ["input", "messages"] {
+        match body.get(key) {
+            Some(Value::Array(items)) => {
+                for item in items {
+                    push_instruction_message(&mut chunks, item);
+                }
+            }
+            Some(Value::Object(_)) => push_instruction_message(&mut chunks, &body[key]),
+            _ => {}
+        }
+    }
+    chunks.join("\n\n")
+}
+
+fn push_instruction_message(chunks: &mut Vec<String>, message: &Value) {
+    if !is_editable_instruction_message(message) {
+        return;
+    }
+    push_prompt_chunk(
+        chunks,
+        message
+            .get("content")
+            .map(instruction_text)
+            .unwrap_or_default(),
+    );
+}
+
+fn push_prompt_chunk(chunks: &mut Vec<String>, content: String) {
+    if !content.trim().is_empty() {
+        chunks.push(content);
+    }
+}
+
+fn parse_prompt_layer(value: &Value, nullable: bool) -> Option<AntiCodexPromptLayer> {
+    let value = value.as_object()?;
+    let enabled = match value.get("enabled") {
+        Some(Value::Bool(enabled)) => *enabled,
+        None => true,
+        Some(_) => return None,
+    };
+    let content = match value.get("content")? {
+        Value::Null if nullable => None,
+        Value::String(content) if content.chars().count() <= ANTICODEX_PROMPT_LAYER_MAX_CHARS => {
+            Some(content.clone())
+        }
+        _ => return None,
+    };
+    Some(AntiCodexPromptLayer { enabled, content })
+}
+
+fn supported_instruction_carrier(body: &Value) -> bool {
+    match body.get("instructions") {
+        None | Some(Value::Null | Value::String(_)) => true,
+        Some(Value::Array(parts)) => parts.iter().all(|part| {
+            part.as_str().is_some() || part.get("text").and_then(Value::as_str).is_some()
+        }),
+        Some(_) => false,
+    }
+}
+
+fn remove_instruction_carriers(body: &mut Value) {
+    if let Some(object) = body.as_object_mut() {
+        object.remove("instructions");
+    }
+    remove_developer_carriers(body);
+}
+
+fn remove_developer_carriers(body: &mut Value) {
+    for key in ["input", "messages"] {
+        let Some(value) = body.get_mut(key) else {
+            continue;
+        };
+        match value {
+            Value::Array(items) => items.retain(|item| !is_editable_instruction_message(item)),
+            Value::Object(_) if is_editable_instruction_message(value) => {
+                *value = Value::Array(Vec::new());
+            }
+            _ => {}
+        }
+    }
+}
+
+fn is_editable_instruction_message(message: &Value) -> bool {
+    message
+        .get("role")
+        .and_then(Value::as_str)
+        .is_some_and(|role| {
+            role.eq_ignore_ascii_case("system") || role.eq_ignore_ascii_case("developer")
+        })
+}
+
+fn set_instructions(body: &mut Value, content: &str) {
+    let Some(body) = body.as_object_mut() else {
+        return;
+    };
+    if content.is_empty() {
+        body.remove("instructions");
+    } else {
+        body.insert("instructions".to_string(), json!(content));
+    }
+}
+
+fn append_instructions(body: &mut Value, content: &str) {
+    if content.is_empty() {
+        return;
+    }
+    let current = body
+        .get("instructions")
+        .map(instruction_text)
+        .unwrap_or_default();
+    let combined = if current.is_empty() {
+        content.to_string()
+    } else {
+        format!("{current}\n\n{content}")
+    };
+    set_instructions(body, &combined);
+}
 
