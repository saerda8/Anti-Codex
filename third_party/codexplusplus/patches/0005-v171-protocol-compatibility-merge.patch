+    let writes_through_handle = [".write_text(", ".write_bytes(", ".truncate("]
+        .iter()
+        .any(|primitive| command.contains(primitive));
+    if writes_through_handle {
+        return true;
+    }
+
+    command.match_indices("open(").any(|(index, _)| {
+        let arguments = &command[index + "open(".len()..];
+        let arguments = arguments.split(')').next().unwrap_or(arguments);
+        [
+            "\"w\"", "'w'", "\"w+\"", "'w+'", "\"a\"", "'a'", "\"a+\"", "'a+'", "\"x\"", "'x'",
+            "\"x+\"", "'x+'", "\"r+\"", "'r+'",
