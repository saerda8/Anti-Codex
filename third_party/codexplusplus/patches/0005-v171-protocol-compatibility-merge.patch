+pub async fn open_cancel_aware_loopback_chat_completions_proxy_request(
+    body: &str,
+    original_user_agent: Option<&str>,
+) -> anyhow::Result<Option<AbortiveUpstreamProxyResponse>> {
+    let settings = SettingsStore::default().load().unwrap_or_default();
+    let relay = settings.active_relay_profile();
+    if relay.protocol != RelayProtocol::ChatCompletions {
+        anyhow::bail!("current relay does not use Chat Completions");
+    }
+    validate_upstream(&relay)?;
+    let request_json: Value = serde_json::from_str(body)?;
+    let is_stream = request_json
+        .get("stream")
+        .and_then(Value::as_bool)
+        .unwrap_or(false);
+    if !is_stream {
+        return Ok(None);
+    }
+    let endpoint = chat_completions_url(&relay.base_url);
+    if !crate::loopback_http::supports(&endpoint) {
+        return Ok(None);
+    }
+    let user_agent = effective_user_agent(&relay.user_agent, original_user_agent);
+    let upstream = crate::loopback_http::post_json(
+        &endpoint,
+        (!relay.uses_no_auth()).then_some(relay.api_key.trim()),
+        &user_agent,
+        None,
+        &request_json,
+        UPSTREAM_STREAM_HEADER_TIMEOUT,
+    )
+    .await?;
+    let status_code = upstream.status().as_u16();
+    let content_type = upstream
+        .headers()
+        .get(hyper::header::CONTENT_TYPE)
+        .and_then(|value| value.to_str().ok())
+        .unwrap_or("")
+        .to_string();
+    Ok(Some(AbortiveUpstreamProxyResponse {
+        status_code,
+        content_type,
+        is_stream: true,
+        wire_api: UpstreamWireApi::ChatCompletions,
+        compaction: false,
+        response: upstream,
+    }))
+}
