+#[test]
+fn chat_completion_response_command_policy_enforces_safety_when_apply_patch_is_available() {
+    let request = json!({
+        "model": "gpt-5-mini",
+        "tools": [
+            { "type": "custom", "name": "apply_patch" },
+            {
+                "type": "function",
+                "name": "shell_command",
+                "parameters": {
+                    "type": "object",
+                    "properties": { "command": { "type": "string" } },
+                    "required": ["command"]
+                }
+            }
+        ]
+    });
+    let convert_arguments = |command: &str| {
+        let converted = chat_completion_to_response_with_request(
+            json!({
+                "id": "chatcmpl_command_policy",
+                "created": 123,
+                "model": "gpt-5-mini",
+                "choices": [{
+                    "finish_reason": "tool_calls",
+                    "message": {
+                        "role": "assistant",
+                        "tool_calls": [{
+                            "id": "call_command_policy",
+                            "type": "function",
+                            "function": {
+                                "name": "shell_command",
+                                "arguments": json!({ "command": command }).to_string()
+                            }
+                        }]
+                    }
+                }]
+            }),
+            &request,
+        )
+        .unwrap();
+        serde_json::from_str::<Value>(converted["output"][0]["arguments"].as_str().unwrap())
+            .unwrap()
+    };
+
+    for blocked in [
+        "docker run --rm alpine echo unsafe",
+        "docker --context desktop-linux run --rm alpine echo unsafe",
+        "docker run --name cv_test --label com.anticodex.task-id=019ffc57-6a72-7f81-8ce8-8796485ca06d alpine",
+        "docker run --rm --name cv_test --label com.anticodex.task-id=019ffc57-6a72-7f81-8ce8-8796485ca06d alpine",
+        "docker container prune -f",
+        "docker ps --quiet | ForEach-Object { docker stop $_ }",
+        "docker run --name cv_test --label com.anticodex.task-id=not-a-task alpine",
+        "docker stop cv_check",
+        "docker rm -f cv_check cv_test_final",
+        "docker container rm --force cv_check",
+        r#"[System.IO.File]::WriteAllText(\"src/main.rs\", \"unsafe\")"#,
+    ] {
+        let arguments = convert_arguments(blocked);
+        let command = arguments["command"].as_str().unwrap();
+        assert!(command.contains("Anti-Codex command policy blocked"));
+        assert!(!command.contains(blocked));
+    }
+
+    let allowed = "docker run --rm --name anticodex-019ffc57-6a72-7f81-8ce8-8796485ca06d --label com.anticodex.task-id=019ffc57-6a72-7f81-8ce8-8796485ca06d alpine echo ok";
+    assert_eq!(convert_arguments(allowed)["command"], allowed);
+    assert_eq!(convert_arguments("cargo test")["command"], "cargo test");
+    assert_eq!(
+        convert_arguments("docker wait cv_check")["command"],
+        "docker wait cv_check"
+    );
+    assert_eq!(
+        convert_arguments("docker rm cv_check")["command"],
+        "docker rm cv_check"
+    );
+}
