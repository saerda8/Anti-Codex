+fn chat_sse_accumulates_fragmented_tool_identity_before_emitting_added() {
+    let assert_identity = |converted: &str, expected_call_id: &str, expected_name: &str| {
+        let events = converted
+            .lines()
+            .filter_map(|line| line.strip_prefix("data: "))
+            .filter(|data| *data != "[DONE]")
+            .map(|data| serde_json::from_str::<serde_json::Value>(data).unwrap())
+            .collect::<Vec<_>>();
+        let added = events
+            .iter()
+            .find(|event| event["type"] == "response.output_item.added")
+            .unwrap();
+        let done = events
+            .iter()
+            .find(|event| event["type"] == "response.output_item.done")
+            .unwrap();
+        let expected_item_id = format!("fc_{expected_call_id}");
+
+        assert_eq!(added["item"]["id"], expected_item_id);
+        assert_eq!(added["item"]["call_id"], expected_call_id);
+        assert_eq!(added["item"]["name"], expected_name);
+        assert_eq!(done["item"]["id"], expected_item_id);
+        assert_eq!(done["item"]["call_id"], expected_call_id);
+        assert_eq!(done["item"]["name"], expected_name);
+        for delta in events
+            .iter()
+            .filter(|event| event["type"] == "response.function_call_arguments.delta")
+        {
+            assert_eq!(delta["item_id"], expected_item_id);
+        }
+        assert_eq!(
+            events
+                .iter()
+                .filter(|event| event["type"] == "response.output_item.added")
+                .count(),
