+#[cfg(test)]
+fn apply_anticodex_prompt_policy_from_path(
+    relay_id: &str,
+    request_json: Value,
+    policy_path: Option<&Path>,
+) -> Value {
+    apply_anticodex_prompt_policy_for_protocol(
+        relay_id,
