+fn command_policy_violation(command: &str) -> Option<&'static str> {
+    let lower = command.to_ascii_lowercase();
+    let normalized = lower.split_whitespace().collect::<Vec<_>>().join(" ");
+    let mut has_quiet_container_list = false;
+    let mut has_container_mutation = false;
