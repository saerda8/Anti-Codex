+fn apply_anticodex_prompt_policy(relay: &RelayProfile, request_json: Value) -> Value {
+    let path = std::env::var_os(ANTICODEX_PROMPT_POLICY_PATH_ENV).map(PathBuf::from);
+    apply_anticodex_prompt_policy_for_protocol(
+        &relay.id,
+        relay.protocol,
+        request_json,
+        path.as_deref(),
+    )
+}
