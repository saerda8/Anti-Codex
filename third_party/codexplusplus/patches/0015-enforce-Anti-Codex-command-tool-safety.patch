+fn chat_completion_response_command_policy_checks_exec_command_cmd_arguments() {
+    let original = "docker run --rm alpine echo unsafe";
+    let converted = chat_completion_to_response_with_request(
+        json!({
+            "id": "chatcmpl_exec_command_policy",
+            "created": 123,
+            "model": "gpt-5-mini",
+            "choices": [{
+                "finish_reason": "tool_calls",
+                "message": {
+                    "role": "assistant",
+                    "tool_calls": [{
+                        "id": "call_exec_command_policy",
+                        "type": "function",
+                        "function": {
+                            "name": "exec_command",
+                            "arguments": json!({ "cmd": original }).to_string()
+                        }
+                    }]
+                }
+            }]
+        }),
+        &json!({
+            "model": "gpt-5-mini",
+            "tools": [
+                { "type": "custom", "name": "apply_patch" },
+                { "type": "function", "name": "exec_command", "parameters": {} }
