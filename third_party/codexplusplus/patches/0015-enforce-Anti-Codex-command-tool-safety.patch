+    )
+    .unwrap();
+
+    let arguments: Value =
+        serde_json::from_str(converted["output"][0]["arguments"].as_str().unwrap()).unwrap();
+    assert!(
+        arguments["cmd"]
+            .as_str()
+            .unwrap()
+            .contains("Anti-Codex command policy blocked")
+    );
+}
