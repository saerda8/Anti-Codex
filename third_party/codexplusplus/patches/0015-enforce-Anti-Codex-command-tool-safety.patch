+fn is_git_token(token: &str) -> bool {
+    let name = token
+        .rsplit(|character| character == '/' || character == '\\')
+        .next()
+        .unwrap_or(token);
+    matches!(name, "git" | "git.exe")
+}
+
+fn git_subcommand(tokens: &[String], git_index: usize) -> Option<(usize, &str)> {
+    let mut index = git_index + 1;
+    while index < tokens.len() {
+        let token = tokens[index].as_str();
+        if matches!(
+            token,
+            "-c" | "--git-dir" | "--work-tree" | "--namespace" | "--super-prefix"
+        ) {
+            index += 2;
+            continue;
+        }
+        if token.starts_with("--git-dir=")
+            || token.starts_with("--work-tree=")
+            || token.starts_with("--namespace=")
+            || token.starts_with("--super-prefix=")
+            || token.starts_with('-')
+        {
+            index += 1;
+            continue;
+        }
+        return Some((index, token));
+    }
+    None
+}
+
+fn command_segments(command: &str) -> Vec<Vec<String>> {
+    let mut segments = Vec::new();
+    let mut segment = Vec::new();
+    let mut token = String::new();
+    let mut quote = None;
+
+    let push_token = |segment: &mut Vec<String>, token: &mut String| {
+        let cleaned = token
+            .trim_matches(|character| {
+                matches!(
+                    character,
+                    '\'' | '"' | '(' | ')' | '{' | '}' | '[' | ']' | ',' | '`' | '$'
+                )
+            })
+            .to_string();
+        if !cleaned.is_empty() {
+            segment.push(cleaned);
+        }
+        token.clear();
+    };
+
+    for character in command.chars() {
+        if let Some(active_quote) = quote {
+            if character == active_quote {
+                quote = None;
+            } else {
+                token.push(character);
+            }
+            continue;
+        }
+        match character {
+            '\'' | '"' => quote = Some(character),
+            ';' | '|' | '&' => {
+                push_token(&mut segment, &mut token);
+                if !segment.is_empty() {
+                    segments.push(std::mem::take(&mut segment));
+                }
+            }
+            character if character.is_whitespace() => push_token(&mut segment, &mut token),
+            _ => token.push(character),
+        }
+    }
+    push_token(&mut segment, &mut token);
+    if !segment.is_empty() {
+        segments.push(segment);
+    }
+    segments
+}
+
+fn is_docker_token(token: &str) -> bool {
+    token == "docker"
+        || token == "docker.exe"
+        || token.ends_with("/docker")
+        || token.ends_with("\\docker.exe")
+}
+
+fn docker_subcommand(tokens: &[String], docker_index: usize) -> Option<(usize, &str)> {
+    let mut index = docker_index + 1;
+    while index < tokens.len() {
+        let token = tokens[index].as_str();
+        if docker_global_option_takes_value(token) {
+            index += 2;
+        } else if token.starts_with('-') {
+            index += 1;
+        } else {
+            return Some((index, token));
+        }
+    }
+    None
+}
+
+fn docker_global_option_takes_value(option: &str) -> bool {
+    matches!(
+        option,
+        "--config"
+            | "--context"
+            | "--host"
+            | "-h"
+            | "--log-level"
+            | "--tlscacert"
+            | "--tlscert"
+            | "--tlskey"
+    )
+}
+
+fn first_non_option(tokens: &[String]) -> Option<(usize, &str)> {
+    tokens
+        .iter()
+        .enumerate()
+        .find(|(_, token)| !token.starts_with('-'))
+        .map(|(index, token)| (index, token.as_str()))
+}
+
+fn option_value<'a>(tokens: &'a [String], option: &str) -> Option<&'a str> {
+    let prefix = format!("{option}=");
+    tokens.iter().enumerate().find_map(|(index, token)| {
+        let token = token.trim_matches(['\'', '"']);
+        let value = token.strip_prefix(&prefix).or_else(|| {
+            (token == option).then(|| tokens.get(index + 1).map_or("", String::as_str))
+        })?;
+        let value = value.trim_matches(['\'', '"']);
+        (!value.is_empty() && !value.starts_with('-')).then_some(value)
+    })
+}
+
+fn task_ownership_id(tokens: &[String]) -> Option<&str> {
+    tokens.iter().enumerate().find_map(|(index, token)| {
+        let token = token.trim_matches(['\'', '"']);
+        let value = token.strip_prefix("--label=").or_else(|| {
+            (token == "--label").then(|| tokens.get(index + 1).map_or("", String::as_str))
+        })?;
+        let task_id = value
+            .trim_matches(['\'', '"'])
+            .strip_prefix("com.anticodex.task-id=")?;
+        is_task_id(task_id).then_some(task_id)
+    })
+}
+
+fn task_container_name_matches_label(tokens: &[String]) -> bool {
+    let Some(name) = option_value(tokens, "--name") else {
+        return false;
+    };
+    task_ownership_id(tokens).is_some_and(|task_id| name == format!("anticodex-{task_id}"))
+}
+
+fn is_task_id(task_id: &str) -> bool {
+    let task_id = task_id.trim_matches(['\'', '"']);
+    task_id.len() == 36
+        && task_id.bytes().enumerate().all(|(index, byte)| {
+            if matches!(index, 8 | 13 | 18 | 23) {
+                byte == b'-'
+            } else {
+                byte.is_ascii_hexdigit()
+            }
+        })
+}
+
+fn has_quiet_option(tokens: &[String]) -> bool {
+    tokens.iter().any(|token| {
+        token == "--quiet"
+            || token == "-q"
+            || (token.starts_with('-')
+                && !token.starts_with("--")
+                && token.as_bytes()[1..].contains(&b'q'))
+    })
+}
