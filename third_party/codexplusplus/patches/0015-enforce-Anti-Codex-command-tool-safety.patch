+fn command_policy_violation(command: &str) -> Option<&'static str> {
+    let lower = command.to_ascii_lowercase();
+    let normalized = lower.split_whitespace().collect::<Vec<_>>().join(" ");
+    let mut has_quiet_container_list = false;
+    let mut has_container_mutation = false;
+
+    for segment in command_segments(&lower) {
+        for docker_index in segment
+            .iter()
+            .enumerate()
+            .filter_map(|(index, token)| is_docker_token(token).then_some(index))
+        {
+            let Some((subcommand_index, subcommand)) = docker_subcommand(&segment, docker_index)
+            else {
+                continue;
+            };
+            let end = segment[subcommand_index + 1..]
+                .iter()
+                .position(|token| is_docker_token(token))
+                .map_or(segment.len(), |offset| subcommand_index + 1 + offset);
+            let arguments = &segment[subcommand_index + 1..end];
+
+            match subcommand {
+                "run" | "create" => {
+                    if !arguments.iter().any(|argument| argument == "--rm") {
+                        return Some("docker run/create requires automatic cleanup");
+                    }
+                    if !task_container_name_matches_label(arguments) {
+                        return Some(
+                            "docker run/create container name and ownership label must identify the same current task; use --name anticodex-<current task id>",
+                        );
+                    }
+                }
+                "container" => {
+                    let Some((nested_index, nested)) = first_non_option(arguments) else {
+                        continue;
+                    };
+                    let nested_arguments = &arguments[nested_index + 1..];
+                    if nested == "prune" {
+                        return Some("global Docker cleanup is forbidden");
+                    }
+                    if nested == "create"
+                        && !nested_arguments.iter().any(|argument| argument == "--rm")
+                    {
+                        return Some("docker run/create requires automatic cleanup");
+                    }
+                    if nested == "create" && !task_container_name_matches_label(nested_arguments) {
+                        return Some(
+                            "docker run/create container name and ownership label must identify the same current task; use --name anticodex-<current task id>",
+                        );
+                    }
+                    if nested == "ls" && has_quiet_option(nested_arguments) {
+                        has_quiet_container_list = true;
+                    }
+                }
+                "system"
+                    if first_non_option(arguments).is_some_and(|(_, value)| value == "prune") =>
+                {
+                    return Some("global Docker cleanup is forbidden");
+                }
+                "ps" if has_quiet_option(arguments) => has_quiet_container_list = true,
+                "kill" | "stop" | "rm" => has_container_mutation = true,
+                _ => {}
+            }
+        }
+    }
+    if has_quiet_container_list && has_container_mutation {
+        return Some("global Docker cleanup is forbidden");
+    }
+    if normalized.contains("apply_patch") {
+        return Some("apply_patch must be called as a structured tool");
+    }
+    if git_worktree_mutation(&lower) {
+        return Some("git worktree edits must not bypass apply_patch");
+    }
+    if masked_test_pipeline_status(&normalized) {
+        return Some("test pipelines must preserve the producer exit status");
+    }
+    let direct_write = [
+        "set-content",
+        "add-content",
+        "out-file",
+        "writealltext",
+        "writeallbytes",
+        "appendalltext",
+        "sed -i",
+        "perl -pi",
+    ]
+    .iter()
+    .any(|primitive| normalized.contains(primitive));
+    let source_path = [
+        ".rs", ".toml", ".json", ".mjs", ".js", ".ts", ".tsx", ".jsx", ".py", ".ps1", ".md",
+        ".yml", ".yaml", ".css", ".html", ".xml", ".lock",
