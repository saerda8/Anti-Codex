+
+data: [DONE]
+
+"#,
+        &json!({
+            "model": "gpt-5-mini",
+            "tools": [
+                { "type": "custom", "name": "apply_patch" },
+                { "type": "function", "name": "shell_command", "parameters": {} }
+            ]
+        }),
+    );
+
+    assert!(converted.contains("Anti-Codex command policy blocked"));
+    assert!(!converted.contains("docker run --rm alpine echo unsafe"));
+
+    let allowed = "docker run --rm --name anticodex-019ffc57-6a72-7f81-8ce8-8796485ca06d --label com.anticodex.task-id=019ffc57-6a72-7f81-8ce8-8796485ca06d alpine echo ok";
+    let allowed_arguments = json!({ "command": allowed }).to_string();
+    let allowed_sse = format!(
+        "data: {}\n\ndata: [DONE]\n\n",
+        json!({
+            "id": "chatcmpl_command_policy_sse_allowed",
+            "model": "gpt-5-mini",
