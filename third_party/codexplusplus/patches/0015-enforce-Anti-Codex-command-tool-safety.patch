+    .iter()
+    .any(|extension| normalized.contains(extension));
+    if source_path && interpreter_stdin_source_write(&normalized) {
+        return Some("interpreter stdin source edits must use apply_patch");
+    }
+    if direct_write && source_path {
+        return Some("direct source or evidence edits must use apply_patch");
+    }
+    None
+}
