+        &json!({
+            "model": "gpt-5-mini",
+            "tools": [
+                { "type": "custom", "name": "apply_patch" },
+                { "type": "function", "name": "shell_command", "parameters": {} }
+            ]
+        }),
+    );
+    assert!(allowed_converted.contains(allowed));
+    assert!(!allowed_converted.contains("Anti-Codex command policy blocked"));
+}
