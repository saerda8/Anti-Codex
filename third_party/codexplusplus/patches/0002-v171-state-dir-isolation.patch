+fn explicit_app_state_dir(value: Option<std::ffi::OsString>) -> Option<PathBuf> {
+    let path = PathBuf::from(value?);
+    (!path.as_os_str().is_empty() && path.is_absolute()).then_some(path)
+}
+
+pub fn configured_app_state_dir() -> Option<PathBuf> {
+    explicit_app_state_dir(std::env::var_os(APP_STATE_DIR_ENV))
+}
+
+pub fn isolated_instance_mode() -> bool {
+    configured_app_state_dir().is_some()
+}
 
