+fn codex_turn_metadata_value(request_json: &Value, turn_metadata: Option<&str>) -> Option<Value> {
+    if let Some(metadata) =
+        turn_metadata.and_then(|serialized| serde_json::from_str::<Value>(serialized).ok())
+    {
+        return Some(metadata);
+    }
+    let metadata = request_json
+        .get("client_metadata")
+        .and_then(Value::as_object)
+        .and_then(|client_metadata| client_metadata.get(CODEX_TURN_METADATA_KEY))?;
+    match metadata {
+        Value::String(serialized) => serde_json::from_str::<Value>(serialized).ok(),
+        Value::Object(_) => Some(metadata.clone()),
+        _ => None,
+    }
+}
