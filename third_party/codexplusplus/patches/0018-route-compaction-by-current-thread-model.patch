+fn newest_thread_rollout_in(
+    directory: &Path,
+    filename_suffix: &str,
+    remaining_depth: usize,
+    newest: &mut Option<(SystemTime, PathBuf)>,
+) {
+    let Ok(entries) = std::fs::read_dir(directory) else {
+        return;
+    };
+    for entry in entries.flatten() {
+        let Ok(file_type) = entry.file_type() else {
+            continue;
+        };
+        let path = entry.path();
+        if file_type.is_dir() && remaining_depth > 0 {
+            newest_thread_rollout_in(&path, filename_suffix, remaining_depth - 1, newest);
+            continue;
+        }
+        if !file_type.is_file()
+            || !entry
+                .file_name()
+                .to_string_lossy()
+                .ends_with(filename_suffix)
+        {
+            continue;
+        }
+        let modified = entry
+            .metadata()
+            .and_then(|metadata| metadata.modified())
+            .unwrap_or(UNIX_EPOCH);
+        if newest
+            .as_ref()
+            .is_none_or(|(current_modified, _)| modified > *current_modified)
+        {
+            *newest = Some((modified, path));
+        }
+    }
+}
+
+fn latest_thread_rollout_path(codex_home: &Path, thread_id: &str) -> Option<PathBuf> {
+    let mut newest = None;
+    newest_thread_rollout_in(
+        &codex_home.join("sessions"),
+        &format!("-{thread_id}.jsonl"),
+        ANTICODEX_SESSION_TREE_DEPTH,
+        &mut newest,
+    );
+    newest.map(|(_, path)| path)
+}
+
+fn read_rollout_tail(path: &Path) -> Option<String> {
+    let mut file = std::fs::File::open(path).ok()?;
+    let length = file.metadata().ok()?.len();
+    let start = length.saturating_sub(ANTICODEX_THREAD_SELECTION_TAIL_BYTES);
+    file.seek(SeekFrom::Start(start)).ok()?;
+    let mut bytes = Vec::with_capacity((length - start) as usize);
+    file.read_to_end(&mut bytes).ok()?;
+    if start > 0 {
+        let first_newline = bytes.iter().position(|byte| *byte == b'\n')?;
+        bytes.drain(..=first_newline);
+    }
+    Some(String::from_utf8_lossy(&bytes).into_owned())
+}
+
+fn latest_thread_model_from_rollout(codex_home: &Path, thread_id: &str) -> Option<String> {
+    let rollout = latest_thread_rollout_path(codex_home, thread_id)?;
+    let tail = read_rollout_tail(&rollout)?;
+    for line in tail.lines().rev() {
+        let Ok(record) = serde_json::from_str::<Value>(line) else {
+            continue;
+        };
+        let payload = record.get("payload").and_then(Value::as_object);
+        if payload
+            .and_then(|value| value.get("type"))
+            .and_then(Value::as_str)
+            != Some("thread_settings_applied")
+        {
+            continue;
+        }
+        let Some(model) = payload
+            .and_then(|value| value.get("thread_settings"))
+            .and_then(Value::as_object)
+            .and_then(|settings| settings.get("model"))
+            .and_then(Value::as_str)
+            .map(str::trim)
+            .filter(|model| !model.is_empty())
+        else {
+            continue;
+        };
+        return Some(model.to_string());
+    }
+    None
+}
