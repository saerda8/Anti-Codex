+pub fn build_macos_cleanup_command(
+    app_dir: &Path,
+    policy: MacosCleanupPolicy,
+) -> Option<Vec<String>> {
+    if policy == MacosCleanupPolicy::SkipQuitBecauseAlreadyRunning {
+        return None;
+    }
+    let app_name = app_dir
+        .file_stem()
+        .and_then(|value| value.to_str())
+        .unwrap_or("Codex");
+    Some(vec![
+        "osascript".to_string(),
+        "-e".to_string(),
+        format!(
+            r#"tell application "{}" to quit"#,
+            app_name.replace('"', "\\\"")
+        ),
+    ])
+}
