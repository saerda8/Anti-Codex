+
+pub fn supports(endpoint: &str) -> bool {
+    let Ok(uri) = endpoint.parse::<Uri>() else {
+        return false;
+    };
+    if uri.scheme_str() != Some("http") {
+        return false;
+    }
+    let Some(host) = uri.host() else {
+        return false;
+    };
+    let host = host
+        .strip_prefix('[')
+        .and_then(|host| host.strip_suffix(']'))
+        .unwrap_or(host);
+    host.eq_ignore_ascii_case("localhost")
+        || host
+            .parse::<IpAddr>()
+            .is_ok_and(|address| address.is_loopback())
+}
+
+pub async fn post_json(
+    endpoint: &str,
+    bearer_token: Option<&str>,
+    user_agent: &str,
+    beta_features: Option<&str>,
+    body: &serde_json::Value,
+    timeout: Duration,
+) -> anyhow::Result<hyper::Response<hyper::body::Incoming>> {
+    anyhow::ensure!(
+        supports(endpoint),
+        "cancel-aware model transport only supports HTTP loopback endpoints"
+    );
+    let uri = endpoint
+        .parse::<Uri>()
+        .context("invalid loopback model endpoint")?;
+    let mut request = Request::builder()
+        .method(Method::POST)
+        .uri(uri)
+        .header(CONTENT_TYPE, "application/json")
+        .header(ACCEPT, "text/event-stream")
+        .header(CACHE_CONTROL, "no-cache");
+    if let Some(token) = bearer_token.filter(|token| !token.trim().is_empty()) {
+        request = request.header(AUTHORIZATION, format!("Bearer {}", token.trim()));
+    }
+    if !user_agent.trim().is_empty() {
+        request = request.header(USER_AGENT, user_agent.trim());
+    }
+    if let Some(beta_features) = beta_features.filter(|value| !value.trim().is_empty()) {
+        request = request.header("x-codex-beta-features", beta_features.trim());
+    }
+    let request = request
+        .body(Full::new(Bytes::from(serde_json::to_vec(body)?)))
+        .context("failed to build loopback model request")?;
+    let mut connector = HttpConnector::new();
+    connector.enforce_http(true);
+    let client = Client::builder(TokioExecutor::new())
+        .pool_max_idle_per_host(0)
+        .build(connector);
+    tokio::time::timeout(timeout, client.request(request))
+        .await
+        .with_context(|| {
+            format!(
+                "loopback model request exceeded {} seconds before response headers",
+                timeout.as_secs()
+            )
+        })?
+        .context("loopback model request failed")
+}
+
+#[cfg(test)]
+mod tests {
+    use super::{post_json, supports};
+    use tokio::io::{AsyncReadExt, AsyncWriteExt};
+
+    #[test]
+    fn only_plain_http_loopback_endpoints_are_supported() {
+        assert!(supports("http://127.0.0.1:57321/v1/chat/completions"));
+        assert!(supports("http://[::1]:57321/v1/chat/completions"));
+        assert!(supports("http://localhost:57321/v1/chat/completions"));
+        assert!(!supports("https://127.0.0.1/v1/chat/completions"));
+        assert!(!supports("http://example.com/v1/chat/completions"));
+        assert!(!supports("not a URL"));
+    }
+    #[tokio::test]
+    async fn post_json_forwards_beta_features_header() {
+        let listener = tokio::net::TcpListener::bind(("127.0.0.1", 0))
+            .await
+            .unwrap();
+        let address = listener.local_addr().unwrap();
+        let server = tokio::spawn(async move {
+            let (mut stream, _) = listener.accept().await.unwrap();
+            let mut bytes = Vec::new();
+            let mut chunk = [0_u8; 1024];
+            loop {
+                let read = stream.read(&mut chunk).await.unwrap();
+                if read == 0 {
+                    break;
+                }
+                bytes.extend_from_slice(&chunk[..read]);
+                if bytes.windows(4).any(|window| window == b"\r\n\r\n") {
+                    break;
+                }
+            }
+            let headers = String::from_utf8_lossy(&bytes).to_ascii_lowercase();
+            assert!(headers.contains("x-codex-beta-features: responses=v2"));
+            stream
+                .write_all(b"HTTP/1.1 200 OK\r\nContent-Length: 0\r\nConnection: close\r\n\r\n")
+                .await
+                .unwrap();
+        });
+        let response = post_json(
+            &format!("http://{address}/v1/responses"),
+            None,
+            "unit-test",
+            Some("responses=v2"),
+            &serde_json::json!({"stream": true}),
+            std::time::Duration::from_secs(5),
+        )
+        .await
+        .unwrap();
+        assert_eq!(response.status(), 200);
+        server.await.unwrap();
+    }
+}
