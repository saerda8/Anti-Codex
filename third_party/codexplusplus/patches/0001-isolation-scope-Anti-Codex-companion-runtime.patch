+impl CodexToolContext {
+    fn is_custom_tool_proxy(&self, upstream_name: &str) -> bool {
+        self.custom_tools.contains_key(upstream_name)
+    }
+
+    fn is_tool_search_proxy(&self, upstream_name: &str) -> bool {
+        self.custom_tools.get(upstream_name).map(|spec| spec.kind)
+            == Some(CodexCustomToolKind::ToolSearch)
+    }
+
+    fn original_custom_tool_name(&self, upstream_name: &str) -> String {
+        self.custom_tools
+            .get(upstream_name)
+            .map(|spec| spec.openai_name.clone())
+            .unwrap_or_else(|| upstream_name.to_string())
+    }
+
+    fn openai_name_for_function_tool(&self, upstream_name: &str) -> (String, String) {
+        let Some(spec) = self.function_tools.get(upstream_name) else {
+            return (upstream_name.to_string(), String::new());
+        };
+        let name = if spec.name.is_empty() {
+            upstream_name.to_string()
+        } else {
+            spec.name.clone()
+        };
+        (name, spec.namespace.clone())
+    }
+
+    fn enforces_command_policy_for(&self, upstream_name: &str) -> bool {
+        if !self
+            .custom_tools
+            .values()
+            .any(|spec| spec.kind == CodexCustomToolKind::ApplyPatch)
+        {
+            return false;
+        }
+        let (name, namespace) = self.openai_name_for_function_tool(upstream_name);
+        namespace.is_empty() && matches!(name.as_str(), "exec_command" | "shell_command")
+    }
+
+    fn command_policy_checked_arguments(&self, upstream_name: &str, arguments: &str) -> String {
+        if !self.enforces_command_policy_for(upstream_name) {
+            return arguments.to_string();
+        }
+        let Ok(mut value) = serde_json::from_str::<Value>(arguments) else {
+            return arguments.to_string();
+        };
+        let Some(object) = value.as_object_mut() else {
+            return arguments.to_string();
+        };
+        let Some((field, command)) = ["command", "cmd"].into_iter().find_map(|field| {
+            object
+                .get(field)
+                .and_then(Value::as_str)
+                .map(|command| (field, command.to_string()))
+        }) else {
+            return arguments.to_string();
+        };
+        let Some(reason) = command_policy_violation(&command) else {
+            return arguments.to_string();
+        };
+        object.insert(
+            field.to_string(),
+            Value::String(format!(
+                "echo \"Anti-Codex command policy blocked: {reason}\"; exit 125"
+            )),
+        );
+        serde_json::to_string(&value).unwrap_or_else(|_| arguments.to_string())
+    }
+}
