+        let temp = tempfile::tempdir().unwrap();
+        let log_path = temp.path().join("diagnostic.log");
+        crate::diagnostic_log::set_diagnostic_log_path_for_tests(Some(log_path));
+        struct RestoreLog;
+        impl Drop for RestoreLog {
