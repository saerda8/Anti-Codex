+            .iter()
+            .enumerate()
+            .map(|(index, thread_settings)| {
+                json!({
+                    "timestamp": format!("2026-08-14T07:41:{index:02}Z"),
+                    "type": "event_msg",
+                    "payload": {
+                        "type": "thread_settings_applied",
+                        "thread_settings": thread_settings,
