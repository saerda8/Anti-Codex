+fn validate_isolated_launch_app_path(
+    isolated_instance: bool,
+    app_path: &str,
+) -> anyhow::Result<Option<PathBuf>> {
+    if !isolated_instance {
+        return Ok((!app_path.trim().is_empty()).then(|| PathBuf::from(app_path.trim())));
+    }
+    let app_path = Path::new(app_path);
+    let validated = codex_plus_core::app_paths::validate_isolated_copied_app_dir(app_path)?;
+    Ok(Some(validated))
+}
+
+fn stop_validated_restart_targets<Validate, StopLauncher, StopCodex>(
+    isolated_instance: bool,
+    app_path: &str,
+    validate: Validate,
+    stop_launcher: StopLauncher,
+    stop_codex: StopCodex,
+) -> anyhow::Result<()>
+where
+    Validate: FnOnce(bool, &str) -> anyhow::Result<Option<PathBuf>>,
+    StopLauncher: FnOnce(&Path),
+    StopCodex: FnOnce(&Path),
+{
+    let validated_app_path = validate(isolated_instance, app_path)?;
+    let launcher_path = codex_plus_core::install::companion_binary_path(SILENT_BINARY);
+    stop_launcher(&launcher_path);
+    if let Some(app_path) = validated_app_path.as_deref() {
+        stop_codex(app_path);
+    }
+    Ok(())
+}
