+fn metadata_marks_codex_compaction(metadata: &Value) -> bool {
+    metadata
+        .get("request_kind")
+        .and_then(Value::as_str)
+        .is_some_and(|kind| kind == CODEX_COMPACTION_REQUEST_KIND)
+}
+
+fn serialized_metadata_marks_codex_compaction(serialized: &str) -> bool {
+    serde_json::from_str::<Value>(serialized)
+        .ok()
+        .as_ref()
+        .is_some_and(metadata_marks_codex_compaction)
+}
+
+fn request_is_codex_compaction(request_json: &Value, turn_metadata: Option<&str>) -> bool {
+    if turn_metadata.is_some_and(serialized_metadata_marks_codex_compaction) {
+        return true;
+    }
+    let Some(metadata) = request_json
+        .get("client_metadata")
+        .and_then(Value::as_object)
+        .and_then(|client_metadata| client_metadata.get(CODEX_TURN_METADATA_KEY))
+    else {
+        return false;
+    };
+
+    match metadata {
+        Value::String(serialized) => serialized_metadata_marks_codex_compaction(serialized),
+        Value::Object(_) => metadata_marks_codex_compaction(metadata),
+        _ => false,
+    }
+}
+
+fn codex_turn_metadata_value(request_json: &Value, turn_metadata: Option<&str>) -> Option<Value> {
+    if let Some(metadata) =
+        turn_metadata.and_then(|serialized| serde_json::from_str::<Value>(serialized).ok())
+    {
+        return Some(metadata);
+    }
+    let metadata = request_json
+        .get("client_metadata")
+        .and_then(Value::as_object)
+        .and_then(|client_metadata| client_metadata.get(CODEX_TURN_METADATA_KEY))?;
+    match metadata {
+        Value::String(serialized) => serde_json::from_str::<Value>(serialized).ok(),
+        Value::Object(_) => Some(metadata.clone()),
+        _ => None,
+    }
+}
+
+fn codex_compaction_thread_id(request_json: &Value, turn_metadata: Option<&str>) -> Option<String> {
+    let metadata = codex_turn_metadata_value(request_json, turn_metadata)?;
+    if !metadata_marks_codex_compaction(&metadata) {
+        return None;
+    }
+    let raw_id = metadata
+        .get("thread_id")
+        .or_else(|| metadata.get("session_id"))
+        .and_then(Value::as_str)?;
+    uuid::Uuid::parse_str(raw_id).ok().map(|id| id.to_string())
+}
+
+fn newest_thread_rollout_in(
+    directory: &Path,
+    filename_suffix: &str,
+    remaining_depth: usize,
+    newest: &mut Option<(SystemTime, PathBuf)>,
+) {
+    let Ok(entries) = std::fs::read_dir(directory) else {
+        return;
+    };
+    for entry in entries.flatten() {
+        let Ok(file_type) = entry.file_type() else {
+            continue;
+        };
+        let path = entry.path();
+        if file_type.is_dir() && remaining_depth > 0 {
+            newest_thread_rollout_in(&path, filename_suffix, remaining_depth - 1, newest);
+            continue;
+        }
+        if !file_type.is_file()
+            || !entry
+                .file_name()
+                .to_string_lossy()
+                .ends_with(filename_suffix)
+        {
+            continue;
+        }
+        let modified = entry
+            .metadata()
+            .and_then(|metadata| metadata.modified())
+            .unwrap_or(UNIX_EPOCH);
+        if newest
+            .as_ref()
+            .is_none_or(|(current_modified, _)| modified > *current_modified)
+        {
+            *newest = Some((modified, path));
+        }
+    }
+}
+
+fn latest_thread_rollout_path(codex_home: &Path, thread_id: &str) -> Option<PathBuf> {
+    let mut newest = None;
+    newest_thread_rollout_in(
+        &codex_home.join("sessions"),
+        &format!("-{thread_id}.jsonl"),
+        ANTICODEX_SESSION_TREE_DEPTH,
+        &mut newest,
+    );
+    newest.map(|(_, path)| path)
+}
+
+fn read_rollout_tail(path: &Path) -> Option<String> {
+    let mut file = std::fs::File::open(path).ok()?;
+    let length = file.metadata().ok()?.len();
+    let start = length.saturating_sub(ANTICODEX_THREAD_SELECTION_TAIL_BYTES);
+    file.seek(SeekFrom::Start(start)).ok()?;
+    let mut bytes = Vec::with_capacity((length - start) as usize);
+    file.read_to_end(&mut bytes).ok()?;
+    if start > 0 {
+        let first_newline = bytes.iter().position(|byte| *byte == b'\n')?;
+        bytes.drain(..=first_newline);
+    }
+    Some(String::from_utf8_lossy(&bytes).into_owned())
+}
+
+fn latest_thread_model_from_rollout(codex_home: &Path, thread_id: &str) -> Option<String> {
+    let rollout = latest_thread_rollout_path(codex_home, thread_id)?;
+    let tail = read_rollout_tail(&rollout)?;
+    for line in tail.lines().rev() {
+        let Ok(record) = serde_json::from_str::<Value>(line) else {
+            continue;
+        };
+        let payload = record.get("payload").and_then(Value::as_object);
+        if payload
+            .and_then(|value| value.get("type"))
+            .and_then(Value::as_str)
+            != Some("thread_settings_applied")
+        {
+            continue;
+        }
+        let Some(model) = payload
+            .and_then(|value| value.get("thread_settings"))
+            .and_then(Value::as_object)
+            .and_then(|settings| settings.get("model"))
+            .and_then(Value::as_str)
+            .map(str::trim)
+            .filter(|model| !model.is_empty())
+        else {
+            continue;
+        };
+        return Some(model.to_string());
+    }
+    None
+}
+
+fn anticodex_model_is_routable(settings: &BackendSettings, model: &str) -> bool {
+    if model == ANTICODEX_THIRD_PARTY_MODEL_SLOT
+        || model.starts_with(ANTICODEX_THIRD_PARTY_MODEL_PREFIX)
+    {
+        return true;
+    }
+    relay_profile_by_id(settings, ANTICODEX_ANTIGRAVITY_RELAY_ID)
+        .as_ref()
+        .is_some_and(|relay| {
+            model == ANTICODEX_ANTIGRAVITY_MODEL_SLOT || relay_model_list_contains(relay, model)
+        })
+}
