+                "type": "message",
+                "role": "user",
+                "content": [{ "type": "input_text", "text": "look at this" }]
+            },
+            {
+                "type": "function_call",
+                "call_id": "call_1",
+                "name": "view_image",
+                "arguments": "{\"path\":\"shot.png\"}"
+            },
+            {
