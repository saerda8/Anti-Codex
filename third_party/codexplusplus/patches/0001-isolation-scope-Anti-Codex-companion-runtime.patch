+#[cfg(windows)]
+pub fn find_codex_processes_from_snapshot_for_executable(
+    processes: &[crate::windows_integration::WindowsProcessInfo],
+    target_executable: &Path,
+) -> Vec<u32> {
+    let mut ids = processes
+        .iter()
+        .filter(|process| {
+            process
+                .executable_path
+                .as_deref()
+                .is_some_and(|path| process_path_is_in_app(path, target_executable))
+        })
+        .map(|process| process.process_id)
+        .collect::<Vec<_>>();
+    ids.sort_unstable();
+    ids.dedup();
+    ids
+}
