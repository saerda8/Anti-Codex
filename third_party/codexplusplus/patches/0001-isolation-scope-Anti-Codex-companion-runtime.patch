+const PATCH_TOOL_SYSTEM_GUIDANCE: &str = "When editing files, call the provided apply_patch structured function tool directly. Do not invoke apply_patch through exec_command, shell_command, PowerShell, cmd.exe, Bash, or another command wrapper. Use command tools only for inspection, builds, tests, and commands that are not file edits. Windows destructive filesystem safety: never translate or retry a blocked recursive delete or move through another shell. Keep the operation in one shell end-to-end and first verify that every resolved absolute target remains inside the intended workspace or an explicitly named target directory. In PowerShell, use Remove-Item with -LiteralPath; never fall back to cmd.exe /c, rmdir, or rd after a policy rejection. Do not change global toolchain defaults, user environment, PATH, registry state, or installed software unless the user explicitly requested that exact change. Query only specifically named non-secret environment variables; never enumerate all environment variables. Command timeout safety: a timeout only means the caller stopped waiting; it does not mean the process or container exited. Before any retry, verify that the prior process or container has exited. Do not retry while it is still running or create duplicate work. If it is still running after a timeout, wait for the same instance to finish and collect its result. Never stop, kill, or remove a still-running process or container merely to retry. Do not change a container name to bypass a name conflict, and do not create a replacement. Container ownership safety: every docker run or docker create command must include an explicit --name and --label com.anticodex.task-id=<current task id>; never use a Docker-generated container name. If the current task ID is unavailable, do not create a container. Never stop, kill, remove, or prune all Docker containers, and never use unfiltered docker ps -q, docker kill or docker stop over every listed ID, docker container prune, or docker system prune. Inspect first and operate only on the exact container created for the current task, proven by its recorded container ID and task-specific ownership label. Containers from other projects are user-owned and must remain untouched. If ownership cannot be proven, report the blocker and do not change any container.";
+
+fn command_policy_violation(command: &str) -> Option<&'static str> {
+    let lower = command.to_ascii_lowercase();
+    let normalized = lower.split_whitespace().collect::<Vec<_>>().join(" ");
+    let mut has_quiet_container_list = false;
+    let mut has_container_mutation = false;
+
+    for segment in command_segments(&lower) {
+        for docker_index in segment
+            .iter()
+            .enumerate()
+            .filter_map(|(index, token)| is_docker_token(token).then_some(index))
+        {
+            let Some((subcommand_index, subcommand)) = docker_subcommand(&segment, docker_index)
+            else {
+                continue;
+            };
+            let end = segment[subcommand_index + 1..]
+                .iter()
+                .position(|token| is_docker_token(token))
+                .map_or(segment.len(), |offset| subcommand_index + 1 + offset);
+            let arguments = &segment[subcommand_index + 1..end];
+
+            match subcommand {
+                "run" | "create" => {
+                    if !arguments.iter().any(|argument| argument == "--rm") {
+                        return Some("docker run/create requires automatic cleanup");
+                    }
+                    if !task_container_name_matches_label(arguments) {
+                        return Some(
+                            "docker run/create container name and ownership label must identify the same current task; use --name anticodex-<current task id>",
+                        );
+                    }
+                }
+                "container" => {
+                    let Some((nested_index, nested)) = first_non_option(arguments) else {
+                        continue;
+                    };
+                    let nested_arguments = &arguments[nested_index + 1..];
+                    if nested == "prune" {
+                        return Some("global Docker cleanup is forbidden");
+                    }
+                    if nested == "create"
+                        && !nested_arguments.iter().any(|argument| argument == "--rm")
+                    {
+                        return Some("docker run/create requires automatic cleanup");
+                    }
+                    if nested == "create" && !task_container_name_matches_label(nested_arguments) {
+                        return Some(
+                            "docker run/create container name and ownership label must identify the same current task; use --name anticodex-<current task id>",
+                        );
+                    }
+                    if matches!(nested, "kill" | "stop" | "restart")
+                        || (nested == "rm" && has_force_option(nested_arguments))
+                    {
+                        return Some(
+                            "stopping or force-removing a Docker container is forbidden; wait for it to exit",
+                        );
+                    }
+                    if nested == "rm" {
+                        has_container_mutation = true;
+                    }
+                    if nested == "ls" && has_quiet_option(nested_arguments) {
+                        has_quiet_container_list = true;
+                    }
+                }
+                "system"
+                    if first_non_option(arguments).is_some_and(|(_, value)| value == "prune") =>
+                {
+                    return Some("global Docker cleanup is forbidden");
+                }
+                "ps" if has_quiet_option(arguments) => has_quiet_container_list = true,
+                "kill" | "stop" | "restart" => {
+                    return Some(
+                        "stopping or force-removing a Docker container is forbidden; wait for it to exit",
+                    );
+                }
+                "rm" if has_force_option(arguments) => {
+                    return Some(
+                        "stopping or force-removing a Docker container is forbidden; wait for it to exit",
+                    );
+                }
+                "rm" => has_container_mutation = true,
+                _ => {}
+            }
+        }
+    }
+    if has_quiet_container_list && has_container_mutation {
+        return Some("global Docker cleanup is forbidden");
+    }
+    if normalized.contains("apply_patch") {
+        return Some("apply_patch must be called as a structured tool");
+    }
+    if git_worktree_mutation(&lower) {
+        return Some("git worktree edits must not bypass apply_patch");
+    }
+    if masked_test_pipeline_status(&normalized) {
+        return Some("test pipelines must preserve the producer exit status");
+    }
+    let direct_write = [
+        "set-content",
+        "add-content",
+        "out-file",
+        "writealltext",
+        "writeallbytes",
+        "appendalltext",
+        "sed -i",
+        "perl -pi",
+    ]
+    .iter()
+    .any(|primitive| normalized.contains(primitive));
+    let source_path = [
+        ".rs", ".toml", ".json", ".mjs", ".js", ".ts", ".tsx", ".jsx", ".py", ".ps1", ".md",
+        ".yml", ".yaml", ".css", ".html", ".xml", ".lock",
+    ]
+    .iter()
+    .any(|extension| normalized.contains(extension));
+    if source_path && interpreter_stdin_source_write(&normalized) {
+        return Some("interpreter stdin source edits must use apply_patch");
+    }
+    if direct_write && source_path {
+        return Some("direct source or evidence edits must use apply_patch");
+    }
+    None
+}
+
+fn interpreter_stdin_source_write(command: &str) -> bool {
+    let python_stdin = ["| python -", "| python.exe -", "| py -", "| py.exe -"]
+        .iter()
+        .any(|pipe| command.contains(pipe));
+    if !python_stdin {
+        return false;
+    }
+
+    let writes_through_handle = [".write_text(", ".write_bytes(", ".truncate("]
+        .iter()
+        .any(|primitive| command.contains(primitive));
+    if writes_through_handle {
+        return true;
+    }
+
+    command.match_indices("open(").any(|(index, _)| {
+        let arguments = &command[index + "open(".len()..];
+        let arguments = arguments.split(')').next().unwrap_or(arguments);
+        [
+            "\"w\"", "'w'", "\"w+\"", "'w+'", "\"a\"", "'a'", "\"a+\"", "'a+'", "\"x\"", "'x'",
+            "\"x+\"", "'x+'", "\"r+\"", "'r+'",
+        ]
+        .iter()
+        .any(|mode| arguments.contains(mode))
+    })
+}
+
+fn git_worktree_mutation(command: &str) -> bool {
+    command_segments(command).iter().any(|segment| {
+        segment
+            .iter()
+            .enumerate()
+            .filter_map(|(index, token)| is_git_token(token).then_some(index))
+            .any(|git_index| {
+                let Some((subcommand_index, subcommand)) = git_subcommand(segment, git_index)
+                else {
+                    return false;
+                };
+                if subcommand == "apply" {
+                    let arguments = &segment[subcommand_index + 1..];
+                    let explicitly_applies = arguments.iter().any(|argument| argument == "--apply");
+                    let read_only = arguments.iter().any(|argument| {
+                        matches!(
+                            argument.as_str(),
+                            "--check" | "--stat" | "--numstat" | "--summary"
+                        )
+                    });
+                    return explicitly_applies || !read_only;
+                }
+                matches!(
+                    subcommand,
+                    "am" | "checkout"
+                        | "checkout-index"
+                        | "cherry-pick"
+                        | "clean"
+                        | "merge"
+                        | "mv"
+                        | "rebase"
+                        | "reset"
+                        | "restore"
+                        | "revert"
+                        | "rm"
+                        | "stash"
+                        | "switch"
+                )
+            })
+    })
+}
+
+fn masked_test_pipeline_status(command: &str) -> bool {
+    let tees_output = command.contains("| tee ") || command.contains("|tee ");
+    if !tees_output || command.contains("pipefail") {
+        return false;
+    }
+    [
+        "cargo test",
+        "cargo nextest",
+        "node --test",
+        "npm test",
+        "pnpm test",
+        "pytest",
+        "go test",
+        "dotnet test",
+    ]
+    .iter()
+    .any(|test_command| command.contains(test_command))
+}
+
+fn is_git_token(token: &str) -> bool {
+    let name = token
+        .rsplit(|character| character == '/' || character == '\\')
+        .next()
+        .unwrap_or(token);
+    matches!(name, "git" | "git.exe")
+}
+
+fn git_subcommand(tokens: &[String], git_index: usize) -> Option<(usize, &str)> {
+    let mut index = git_index + 1;
+    while index < tokens.len() {
+        let token = tokens[index].as_str();
+        if matches!(
+            token,
+            "-c" | "--git-dir" | "--work-tree" | "--namespace" | "--super-prefix"
+        ) {
+            index += 2;
+            continue;
+        }
+        if token.starts_with("--git-dir=")
+            || token.starts_with("--work-tree=")
+            || token.starts_with("--namespace=")
+            || token.starts_with("--super-prefix=")
+            || token.starts_with('-')
+        {
+            index += 1;
+            continue;
+        }
+        return Some((index, token));
+    }
+    None
+}
+
+fn command_segments(command: &str) -> Vec<Vec<String>> {
+    let mut segments = Vec::new();
+    let mut segment = Vec::new();
+    let mut token = String::new();
+    let mut quote = None;
+
+    let push_token = |segment: &mut Vec<String>, token: &mut String| {
+        let cleaned = token
+            .trim_matches(|character| {
+                matches!(
+                    character,
+                    '\'' | '"' | '(' | ')' | '{' | '}' | '[' | ']' | ',' | '`' | '$'
+                )
+            })
+            .to_string();
+        if !cleaned.is_empty() {
+            segment.push(cleaned);
+        }
+        token.clear();
+    };
+
+    for character in command.chars() {
+        if let Some(active_quote) = quote {
+            if character == active_quote {
+                quote = None;
+            } else {
+                token.push(character);
+            }
+            continue;
+        }
+        match character {
+            '\'' | '"' => quote = Some(character),
+            ';' | '|' | '&' => {
+                push_token(&mut segment, &mut token);
+                if !segment.is_empty() {
+                    segments.push(std::mem::take(&mut segment));
+                }
+            }
+            character if character.is_whitespace() => push_token(&mut segment, &mut token),
+            _ => token.push(character),
+        }
+    }
+    push_token(&mut segment, &mut token);
+    if !segment.is_empty() {
+        segments.push(segment);
+    }
+    segments
+}
+
+fn is_docker_token(token: &str) -> bool {
+    token == "docker"
+        || token == "docker.exe"
+        || token.ends_with("/docker")
+        || token.ends_with("\\docker.exe")
+}
+
+fn docker_subcommand(tokens: &[String], docker_index: usize) -> Option<(usize, &str)> {
+    let mut index = docker_index + 1;
+    while index < tokens.len() {
+        let token = tokens[index].as_str();
+        if docker_global_option_takes_value(token) {
+            index += 2;
+        } else if token.starts_with('-') {
+            index += 1;
+        } else {
+            return Some((index, token));
+        }
+    }
+    None
+}
+
+fn docker_global_option_takes_value(option: &str) -> bool {
+    matches!(
+        option,
+        "--config"
+            | "--context"
+            | "--host"
+            | "-h"
+            | "--log-level"
+            | "--tlscacert"
+            | "--tlscert"
+            | "--tlskey"
+    )
+}
+
+fn first_non_option(tokens: &[String]) -> Option<(usize, &str)> {
+    tokens
+        .iter()
+        .enumerate()
+        .find(|(_, token)| !token.starts_with('-'))
+        .map(|(index, token)| (index, token.as_str()))
+}
+
+fn option_value<'a>(tokens: &'a [String], option: &str) -> Option<&'a str> {
+    let prefix = format!("{option}=");
+    tokens.iter().enumerate().find_map(|(index, token)| {
+        let token = token.trim_matches(['\'', '"']);
+        let value = token.strip_prefix(&prefix).or_else(|| {
+            (token == option).then(|| tokens.get(index + 1).map_or("", String::as_str))
+        })?;
+        let value = value.trim_matches(['\'', '"']);
+        (!value.is_empty() && !value.starts_with('-')).then_some(value)
+    })
+}
+
+fn task_ownership_id(tokens: &[String]) -> Option<&str> {
+    tokens.iter().enumerate().find_map(|(index, token)| {
+        let token = token.trim_matches(['\'', '"']);
+        let value = token.strip_prefix("--label=").or_else(|| {
+            (token == "--label").then(|| tokens.get(index + 1).map_or("", String::as_str))
+        })?;
+        let task_id = value
+            .trim_matches(['\'', '"'])
+            .strip_prefix("com.anticodex.task-id=")?;
+        is_task_id(task_id).then_some(task_id)
+    })
+}
+
+fn task_container_name_matches_label(tokens: &[String]) -> bool {
+    let Some(name) = option_value(tokens, "--name") else {
+        return false;
+    };
+    task_ownership_id(tokens).is_some_and(|task_id| name == format!("anticodex-{task_id}"))
+}
+
+fn is_task_id(task_id: &str) -> bool {
+    let task_id = task_id.trim_matches(['\'', '"']);
+    task_id.len() == 36
+        && task_id.bytes().enumerate().all(|(index, byte)| {
+            if matches!(index, 8 | 13 | 18 | 23) {
+                byte == b'-'
+            } else {
+                byte.is_ascii_hexdigit()
+            }
+        })
+}
+
+fn has_quiet_option(tokens: &[String]) -> bool {
+    tokens.iter().any(|token| {
+        token == "--quiet"
+            || token == "-q"
+            || (token.starts_with('-')
+                && !token.starts_with("--")
+                && token.as_bytes()[1..].contains(&b'q'))
+    })
+}
+
+fn has_force_option(tokens: &[String]) -> bool {
+    tokens.iter().any(|token| {
+        token == "--force"
+            || token.starts_with("--force=")
+            || (token.starts_with('-')
+                && !token.starts_with("--")
+                && token.as_bytes()[1..].contains(&b'f'))
+    })
+}
+
+fn request_has_apply_patch_tool(tools: Option<&Value>) -> bool {
+    tools.and_then(Value::as_array).is_some_and(|tools| {
+        tools.iter().any(|tool| {
+            if tool.as_str() == Some("apply_patch") {
+                return true;
+            }
+            let name = tool
+                .get("name")
+                .or_else(|| tool.pointer("/function/name"))
+                .and_then(Value::as_str)
+                .unwrap_or("");
+            !name.is_empty()
+                && detect_codex_custom_tool_kind(tool, name) == CodexCustomToolKind::ApplyPatch
+        })
+    })
+}
+
+fn guide_command_tools_away_from_file_edits(tools: &mut [Value]) {
+    const GUIDANCE: &str = "Do not use this command tool for file edits when apply_patch tools are available; call the apply_patch structured tools directly. Use this command tool only for commands, builds, tests, and inspection. Never translate or retry a blocked recursive delete or move through another shell. On Windows, keep destructive filesystem work in one shell end-to-end, verify every resolved absolute target first, use PowerShell Remove-Item with -LiteralPath, and never fall back to cmd.exe /c, rmdir, or rd after a policy rejection. Never change global toolchain defaults or enumerate all environment variables without an explicit user request.";
+
+    for tool in tools {
+        let Some(function) = tool.get_mut("function").and_then(Value::as_object_mut) else {
+            continue;
+        };
+        let name = function.get("name").and_then(Value::as_str).unwrap_or("");
+        if !matches!(name, "exec_command" | "shell_command") {
+            continue;
+        }
+        let current = function
+            .get("description")
+            .and_then(Value::as_str)
+            .unwrap_or("")
+            .trim();
+        let description = if current.is_empty() {
+            GUIDANCE.to_string()
+        } else {
+            format!("{current} {GUIDANCE}")
+        };
+        function.insert("description".to_string(), Value::String(description));
+    }
+}
+
+fn detect_codex_custom_tool_kind(tool: &Value, name: &str) -> CodexCustomToolKind {
+    if name == "apply_patch" {
+        return CodexCustomToolKind::ApplyPatch;
+    }
+    if let Some(definition) = tool.pointer("/format/definition").and_then(Value::as_str) {
+        if definition.contains("begin_patch")
+            && definition.contains("end_patch")
+            && definition.contains("add_hunk")
+        {
+            return CodexCustomToolKind::ApplyPatch;
+        }
+    }
+    if matches!(
+        tool.get("type").and_then(Value::as_str),
+        Some("web_search" | "local_shell" | "computer_use")
+    ) {
+        CodexCustomToolKind::BuiltIn
+    } else {
+        CodexCustomToolKind::Raw
+    }
+}
+
+fn responses_function_tool_to_chat_tool(tool: &Value) -> Option<Value> {
+    if tool.get("type").and_then(Value::as_str) != Some("function") {
+        return None;
+    }
+    if tool.get("function").is_some() {
+        let mut chat_tool = tool.clone();
+        if let Some(strict) = tool.get("strict").cloned() {
+            if let Some(function) = chat_tool.get_mut("function").and_then(Value::as_object_mut) {
+                function.entry("strict".to_string()).or_insert(strict);
+            }
+            if let Some(object) = chat_tool.as_object_mut() {
+                object.remove("strict");
+            }
+        }
+        if let Some(function) = chat_tool.get_mut("function").and_then(Value::as_object_mut) {
+            let normalized =
+                normalize_chat_tool_parameters(function.get("parameters").unwrap_or(&json!({})));
+            function.insert("parameters".to_string(), normalized);
+        }
+        return Some(chat_tool);
+    }
+    let mut function = json!({
+        "name": tool.get("name").and_then(Value::as_str).unwrap_or(""),
+        "description": tool.get("description").cloned().unwrap_or(Value::Null),
+        "parameters": normalize_chat_tool_parameters(tool.get("parameters").unwrap_or(&json!({})))
+    });
+    if let Some(strict) = tool.get("strict") {
+        function["strict"] = strict.clone();
+    }
+    Some(json!({
+        "type": "function",
+        "function": function
+    }))
+}
+
+fn namespace_tool_to_chat_tools(namespace_tool: &Value, context: &CodexToolContext) -> Vec<Value> {
+    let namespace = namespace_tool
+        .get("name")
+        .and_then(Value::as_str)
+        .unwrap_or("");
+    let namespace_description = namespace_tool
+        .get("description")
+        .and_then(Value::as_str)
+        .unwrap_or("");
+    let Some(children) = namespace_tool.get("tools").and_then(Value::as_array) else {
+        return Vec::new();
+    };
+    let mut converted = Vec::new();
+    for child in children {
+        if child.get("type").and_then(Value::as_str) != Some("function") {
+            continue;
+        }
+        let Some(name) = child
+            .get("name")
+            .and_then(Value::as_str)
+            .filter(|v| !v.is_empty())
+        else {
+            continue;
+        };
+        let flat = flatten_namespace_tool_name(namespace, name);
+        if namespace != ""
+            && context
+                .function_tools
+                .get(&flat)
+                .is_some_and(|spec| spec.namespace.is_empty())
+        {
+            continue;
+        }
+        let description = combine_namespace_description(
+            namespace_description,
+            child
+                .get("description")
+                .and_then(Value::as_str)
+                .unwrap_or(""),
+        );
+        let mut function = json!({
+            "name": flat,
+            "parameters": normalize_chat_tool_parameters(child.get("parameters").unwrap_or(&json!({})))
+        });
+        if !description.is_empty() {
+            function["description"] = json!(description);
+        }
+        converted.push(json!({
+            "type": "function",
+            "function": function
+        }));
+    }
+    converted
+}
+
+fn normalize_chat_tool_parameters(parameters: &Value) -> Value {
+    let mut normalized = if parameters.is_object() {
+        parameters.clone()
+    } else {
+        json!({})
+    };
+    // 裸 `$ref` 已经是完整 schema，补默认字段会人为制造 sibling。
+    let is_bare_ref = normalized
+        .as_object()
+        .is_some_and(|object| object.len() == 1 && object.contains_key("$ref"));
+    if !is_bare_ref {
+        // `type: null` 与缺失等价：严格供应商（如 deepseek）会以
+        // `got 'type: null'` 拒绝整个请求（issue #2247）。
+        if normalized.get("type").is_none_or(Value::is_null) {
+            normalized["type"] = json!("object");
+        }
+        if normalized.get("properties").is_none() {
+            normalized["properties"] = json!({});
+        }
+        if normalized.get("required").is_none() {
+            normalized["required"] = json!([]);
+        }
+    }
+    inline_ref_siblings(&normalized)
+}
+
+fn inline_ref_siblings(root: &Value) -> Value {
+    let defs = root.get("$defs").and_then(Value::as_object);
+    let mut resolving = Vec::new();
+    normalize_schema_value(root, defs, &mut resolving).unwrap_or_else(|_| root.clone())
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+enum LocalRefNormalizationError {
+    Cycle,
+}
+
+fn normalize_schema_value(
+    node: &Value,
+    defs: Option<&Map<String, Value>>,
+    resolving: &mut Vec<String>,
+) -> Result<Value, LocalRefNormalizationError> {
+    match node {
+        Value::Array(items) => Ok(Value::Array(
+            items
+                .iter()
+                .map(|item| normalize_schema_value(item, defs, resolving))
+                .collect::<Result<Vec<_>, _>>()?,
+        )),
+        Value::Object(object) => normalize_schema_object(object, defs, resolving),
+        _ => Ok(node.clone()),
+    }
+}
+
+fn normalize_schema_object(
+    object: &Map<String, Value>,
+    defs: Option<&Map<String, Value>>,
+    resolving: &mut Vec<String>,
+) -> Result<Value, LocalRefNormalizationError> {
+    if object.len() > 1
+        && let Some(reference) = object.get("$ref").and_then(Value::as_str)
+        && let Some(name) = local_definition_name(reference)
+    {
+        match resolve_local_definition(name, defs, resolving)? {
+            Some(Value::Object(mut merged)) if merged.get("$ref").is_none() => {
+                for (key, value) in object {
+                    if key != "$ref" {
+                        merged.insert(key.clone(), normalize_schema_value(value, defs, resolving)?);
+                    }
+                }
+                return Ok(Value::Object(merged));
+            }
+            Some(_) | None => {}
+        }
+    }
+
+    let mut normalized = Map::new();
+    for (key, value) in object {
+        // JSON Schema 的 type 必须是字符串，null 恒非法，剥掉等价于未声明。
+        if key == "type" && value.is_null() {
+            continue;
+        }
+        normalized.insert(key.clone(), normalize_schema_value(value, defs, resolving)?);
+    }
+    Ok(Value::Object(normalized))
+}
+
+fn resolve_local_definition(
+    name: &str,
+    defs: Option<&Map<String, Value>>,
+    resolving: &mut Vec<String>,
+) -> Result<Option<Value>, LocalRefNormalizationError> {
+    let Some(defs) = defs else {
+        return Ok(None);
+    };
+    let Some(target) = defs.get(name) else {
+        return Ok(None);
+    };
+    if resolving.iter().any(|current| current == name) {
+        return Err(LocalRefNormalizationError::Cycle);
+    }
+
+    resolving.push(name.to_string());
+    let resolved = if let Some(alias) = bare_local_ref_name(target) {
+        resolve_local_definition(alias, Some(defs), resolving)
+    } else {
+        normalize_schema_value(target, Some(defs), resolving).map(Some)
+    };
+    resolving.pop();
+    resolved
+}
+
+fn bare_local_ref_name(node: &Value) -> Option<&str> {
+    let object = node.as_object()?;
+    if object.len() != 1 {
+        return None;
+    }
+    local_definition_name(object.get("$ref")?.as_str()?)
+}
+
+fn local_definition_name(reference: &str) -> Option<&str> {
+    let name = reference.strip_prefix("#/$defs/")?;
+    if name.is_empty() || name.contains('/') {
+        return None;
+    }
+    Some(name)
+}
+
+fn generic_custom_proxy_tool(name: &str, description: &str) -> Value {
