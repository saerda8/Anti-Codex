+    let namespace = item.get("namespace").and_then(Value::as_str).unwrap_or("");
+    if name.is_empty() {
+        String::new()
+    } else if namespace.is_empty() {
+        name.to_string()
+    } else {
+        flatten_namespace_tool_name(namespace, name)
+    }
