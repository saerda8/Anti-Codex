+pub async fn open_cancel_aware_loopback_responses_proxy_request(
+    body: &str,
+    original_user_agent: Option<&str>,
+    request_path: &str,
+    turn_metadata: Option<&str>,
+) -> anyhow::Result<Option<AbortiveUpstreamProxyResponse>> {
+    let mut request_json: Value = serde_json::from_str(body)?;
+    let is_stream = request_json
+        .get("stream")
+        .and_then(Value::as_bool)
+        .unwrap_or(false);
+    if !is_stream {
+        return Ok(None);
+    }
+
+    let settings = SettingsStore::default().load().unwrap_or_default();
+    let mut request_json = request_json;
+    let compaction_model_aligned = align_codex_compaction_model_with_live_selection(
+        &settings,
+        &mut request_json,
+        turn_metadata,
+    );
+    let directed_relay = select_anticodex_relay_for_model(&settings, &mut request_json)?;
+    let source_model = request_json
+        .get("model")
+        .and_then(Value::as_str)
+        .map(str::trim)
+        .unwrap_or("")
+        .to_string();
+    let model_route = if directed_relay.is_none() {
+        select_model_route(&settings, &source_model)?
+    } else {
+        None
+    };
+    if let Some(route) = &model_route
+        && route.upstream_model != source_model
+    {
+        request_json["model"] = Value::String(route.upstream_model.clone());
+    }
+    let model = (!source_model.trim().is_empty()).then(|| source_model.clone());
+    let context = RotationContext {
+        conversation_id: conversation_id_from_responses_request(&request_json),
+        model,
+    };
+    let (relay, relays) = if let Some(relay) = directed_relay.as_ref() {
+        (relay.clone(), vec![relay.clone()])
+    } else if let Some(route) = &model_route {
+        (route.relay.clone(), vec![route.relay.clone()])
+    } else {
+        let relay = crate::relay_rotation::select_relay_for_request(&settings, context)?;
+        let mut relays = vec![relay.clone()];
+        relays.extend(crate::relay_rotation::fallback_relays_after(
+            &settings, &relay.id,
+        )?);
+        (relay, relays)
+    };
+    debug_assert_eq!(
+        relays.first().map(|item| item.id.as_str()),
+        Some(relay.id.as_str())
+    );
+    let candidate_count = relays.len();
+    for (attempt, relay) in relays.into_iter().enumerate() {
+        validate_upstream(&relay)?;
+        let model_override = aggregate_upstream_model_override(&settings, &relay);
+        let (endpoint, upstream_body, wire_api, compaction) = upstream_request_parts(
+            &relay,
+            request_json.clone(),
+            request_path,
+            model_override.as_deref(),
+        )
+        .await?;
+        if !crate::loopback_http::supports(&endpoint) {
+            return Ok(None);
+        }
+        let has_more_candidates = attempt + 1 < candidate_count;
+        let user_agent = effective_user_agent(&relay.user_agent, original_user_agent);
+        let _ = crate::diagnostic_log::append_diagnostic_log(
+            "protocol_proxy.upstream_request",
+            json!({
+                "relayId": relay.id,
+                "relayName": relay.name,
+                "endpoint": endpoint,
+                "wireApi": wire_api,
+                "stream": true,
+                "transport": "cancel_aware_loopback",
+                "attempt": attempt + 1,
+                "candidateCount": candidate_count,
+                "compactionModelAligned": compaction_model_aligned,
+                "requestTools": request_tool_audit(&request_json),
+                "upstreamTools": request_tool_audit(&upstream_body),
+                "headerTimeoutSeconds": UPSTREAM_STREAM_HEADER_TIMEOUT.as_secs(),
+                "modelRoute": model_route.as_ref().map(|route| json!({
+                    "sourceRelayId": route.source_relay_id,
+                    "sourceModel": route.source_model,
+                    "targetRelayId": route.relay.id,
+                    "upstreamModel": route.upstream_model
+                }))
+            }),
+        );
+        let upstream = match crate::loopback_http::post_json(
+            &endpoint,
+            (!relay.uses_no_auth()).then_some(relay.api_key.trim()),
+            &user_agent,
+            &upstream_body,
+            UPSTREAM_STREAM_HEADER_TIMEOUT,
+        )
+        .await
+        {
+            Ok(upstream) => upstream,
+            Err(error) => {
+                let _ = crate::diagnostic_log::append_diagnostic_log(
+                    "protocol_proxy.upstream_request_failed",
+                    json!({
+                        "relayId": relay.id,
+                        "relayName": relay.name,
+                        "endpoint": endpoint,
+                        "wireApi": wire_api,
+                        "stream": true,
+                        "transport": "cancel_aware_loopback",
+                        "attempt": attempt + 1,
+                        "candidateCount": candidate_count,
+                        "headerTimeoutSeconds": UPSTREAM_STREAM_HEADER_TIMEOUT.as_secs(),
+                        "willFailover": has_more_candidates,
+                        "error": error.to_string()
+                    }),
+                );
+                crate::relay_rotation::record_relay_request_failure(&settings);
+                if has_more_candidates {
+                    continue;
+                }
+                return Err(error).with_context(|| {
+                    format!(
+                        "provider '{}' loopback request failed, endpoint: {}",
+                        relay.name, endpoint
+                    )
+                });
+            }
+        };
+        let status_code = upstream.status().as_u16();
+        let content_type = upstream
+            .headers()
+            .get(hyper::header::CONTENT_TYPE)
+            .and_then(|value| value.to_str().ok())
+            .unwrap_or("")
+            .to_string();
+        let _ = crate::diagnostic_log::append_diagnostic_log(
+            "protocol_proxy.upstream_response",
+            json!({
+                "relayId": relay.id,
+                "relayName": relay.name,
+                "endpoint": endpoint,
+                "wireApi": wire_api,
+                "stream": true,
+                "transport": "cancel_aware_loopback",
+                "statusCode": status_code,
+                "attempt": attempt + 1,
+                "candidateCount": candidate_count,
+                "headerTimeoutSeconds": UPSTREAM_STREAM_HEADER_TIMEOUT.as_secs(),
+                "willFailover": has_more_candidates && !(200..300).contains(&status_code)
+            }),
+        );
+        crate::relay_rotation::record_relay_request_event(
+            &settings,
+            if (200..300).contains(&status_code) {
+                RotationEvent::Success
+            } else {
+                RotationEvent::Failure
+            },
+        );
+        if (200..300).contains(&status_code) || !has_more_candidates {
+            return Ok(Some(AbortiveUpstreamProxyResponse {
+                status_code,
+                content_type,
+                is_stream: true,
+                wire_api,
+                compaction,
+                response: upstream,
+            }));
+        }
+        let _ = crate::diagnostic_log::append_diagnostic_log(
+            "protocol_proxy.upstream_failover",
+            json!({
+                "relayId": relay.id,
+                "relayName": relay.name,
+                "endpoint": endpoint,
+                "wireApi": wire_api,
+                "stream": true,
+                "transport": "cancel_aware_loopback",
+                "statusCode": status_code,
+                "attempt": attempt + 1,
+                "candidateCount": candidate_count,
+                "headerTimeoutSeconds": UPSTREAM_STREAM_HEADER_TIMEOUT.as_secs()
+            }),
+        );
+    }
+    anyhow::bail!("no usable loopback provider candidate")
+}
