+    #[test]
+    fn explicit_copied_executable_must_be_an_exe_inside_the_selected_app_directory() {
+        let temp = tempfile::tempdir().unwrap();
+        let app_dir = temp.path().join("copied-app");
+        let outside_dir = temp.path().join("outside");
+        std::fs::create_dir_all(&app_dir).unwrap();
+        std::fs::create_dir_all(&outside_dir).unwrap();
+        let branded = app_dir.join("Anti-Codex.exe");
+        let outside = outside_dir.join("Anti-Codex.exe");
+        let not_executable = app_dir.join("Anti-Codex.txt");
+        std::fs::write(&branded, "").unwrap();
+        std::fs::write(&outside, "").unwrap();
+        std::fs::write(&not_executable, "").unwrap();
+
+        assert_eq!(
+            explicit_codex_executable(&app_dir, branded.clone().into_os_string()),
+            Some(branded)
+        );
+        assert_eq!(
+            explicit_codex_executable(&app_dir, outside.into_os_string()),
+            None
+        );
+        assert_eq!(
+            explicit_codex_executable(&app_dir, not_executable.into_os_string()),
+            None
+        );
+        assert_eq!(
+            explicit_codex_executable(&app_dir, "relative.exe".into()),
+            None
+        );
+        assert_eq!(configured_codex_executable_from_value(&app_dir, None), None);
+        assert_eq!(
+            configured_codex_executable_from_value(&app_dir, Some("relative.exe".into())),
+            Some(std::path::PathBuf::new())
+        );
+    }
