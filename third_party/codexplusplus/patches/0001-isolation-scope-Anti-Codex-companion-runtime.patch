+) -> Vec<u32> {
+    let target_executable = if target_app_path.extension() == Some(std::ffi::OsStr::new("exe")) {
+        target_app_path.to_path_buf()
+    } else {
+        crate::app_paths::build_codex_executable(target_app_path)
