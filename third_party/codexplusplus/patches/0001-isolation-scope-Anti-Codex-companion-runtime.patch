+async fn try_handle_cancel_aware_protocol_proxy_stream(
+    stream: &mut tokio::net::TcpStream,
+    request_body: &str,
+    request_user_agent: Option<&str>,
+    request_turn_metadata: Option<&str>,
+    request_json: Option<&serde_json::Value>,
+    method: &str,
+    path: &str,
+    remote_addr_text: Option<String>,
+) -> anyhow::Result<bool> {
+    let open_upstream = crate::protocol_proxy::open_cancel_aware_loopback_responses_proxy_request(
+        request_body,
+        request_user_agent,
+        path,
+        request_turn_metadata,
+    );
+    let open_result = tokio::select! {
+        result = open_upstream => result,
+        _ = wait_for_downstream_disconnect(stream) => return Ok(true),
+    };
+    let upstream = match open_result {
+        Ok(Some(upstream)) => upstream,
+        Ok(None) => return Ok(false),
+        Err(error) => {
+            let body = serde_json::to_vec(
+                &serde_json::json!({ "status": "failed", "message": error.to_string() }),
+            )?;
+            write_http_response(
+                stream,
+                "502 Bad Gateway",
+                "application/json; charset=utf-8",
+                &body,
+            )
+            .await?;
+            log_helper_response(
+                "helper.protocol_proxy_failed",
+                method,
+                path,
+                "502 Bad Gateway",
+                remote_addr_text,
+            );
+            stream.shutdown().await?;
+            return Ok(true);
+        }
+    };
+    let status = upstream.status();
+    if !upstream.is_success() {
+        let status_code = upstream.status_code;
+        let content_type = upstream.content_type.clone();
+        let upstream_body = collect_loopback_body(upstream.response).await?;
+        if let Some(body) = crate::protocol_proxy::responses_terminal_failure_sse_from_upstream(
+            request_json,
+            status_code,
+            &content_type,
+            &upstream_body,
+        ) {
+            write_http_stream_headers(stream, "200 OK", "text/event-stream; charset=utf-8").await?;
+            stream.write_all(&body).await?;
+            log_helper_response(
+                "helper.protocol_proxy_upstream_error",
+                method,
+                path,
+                &status,
+                remote_addr_text,
+            );
+            stream.shutdown().await?;
+            return Ok(true);
+        }
+        let error = crate::protocol_proxy::responses_error_from_upstream(
+            status_code,
+            &content_type,
+            &upstream_body,
+        );
+        let body = serde_json::to_vec(&error)?;
+        write_http_response(stream, &status, "application/json; charset=utf-8", &body).await?;
+        log_helper_response(
+            "helper.protocol_proxy_upstream_error",
+            method,
+            path,
+            &status,
+            remote_addr_text,
+        );
+        stream.shutdown().await?;
+        return Ok(true);
+    }
+
+    write_http_stream_headers(stream, "200 OK", "text/event-stream; charset=utf-8").await?;
+    let wire_api = upstream.wire_api;
+    let mut upstream_body = upstream.response.into_body();
+    let (mut downstream_reader, mut downstream_writer) = stream.split();
+    if upstream.compaction {
+        let mut converter = crate::protocol_proxy::CompactionSseConverter::new(
+            request_json
+                .and_then(|request| request.get("model"))
+                .and_then(serde_json::Value::as_str)
+                .unwrap_or(""),
+        );
+        if wire_api != crate::protocol_proxy::UpstreamWireApi::Responses {
+            converter = converter.with_chat_upstream();
+        }
+        loop {
+            tokio::select! {
+                frame = with_upstream_stream_idle_timeout(upstream_body.frame(), UPSTREAM_STREAM_IDLE_TIMEOUT) => match frame {
+                    Ok(Some(Ok(frame))) => {
+                        if let Ok(bytes) = frame.into_data() {
+                            converter.push_upstream_bytes(&bytes);
+                        }
+                    }
+                    Ok(Some(Err(error))) => {
+                        converter.fail(format!("Stream error: {error}"), None);
+                        break;
+                    }
+                    Ok(None) => break,
+                    Err(_) => {
+                        converter.fail(
+                            format!("Upstream stream timed out after {} seconds without data", UPSTREAM_STREAM_IDLE_TIMEOUT.as_secs()),
+                            Some("stream_timeout".to_string()),
+                        );
+                        log_helper_response(
+                            "helper.protocol_proxy_stream_timeout",
+                            method,
+                            path,
+                            "504 Gateway Timeout",
+                            remote_addr_text.clone(),
+                        );
+                        break;
+                    }
+                },
+                _ = wait_for_downstream_disconnect(&mut downstream_reader) => return Ok(true),
+            }
+        }
+        let payload = converter.finish();
+        if !payload.is_empty() {
+            downstream_writer.write_all(&payload).await?;
+        }
+        log_helper_response(
+            "helper.protocol_proxy_compaction_ok",
+            method,
+            path,
+            "200 OK",
+            remote_addr_text,
+        );
+        downstream_writer.shutdown().await?;
+        return Ok(true);
+    }
+    if wire_api == crate::protocol_proxy::UpstreamWireApi::Responses {
+        loop {
+            tokio::select! {
+                frame = with_upstream_stream_idle_timeout(upstream_body.frame(), UPSTREAM_STREAM_IDLE_TIMEOUT) => match frame {
+                    Ok(Some(Ok(frame))) => {
+                        if let Ok(bytes) = frame.into_data() {
+                            downstream_writer.write_all(&bytes).await?;
+                        }
+                    }
+                    Ok(Some(Err(error))) => return Err(error.into()),
+                    Ok(None) => break,
+                    Err(_) => {
+                        log_helper_response(
+                            "helper.protocol_proxy_stream_timeout",
+                            method,
+                            path,
+                            "504 Gateway Timeout",
+                            remote_addr_text,
+                        );
+                        downstream_writer.shutdown().await?;
+                        return Ok(true);
+                    }
+                },
+                _ = wait_for_downstream_disconnect(&mut downstream_reader) => return Ok(true),
+            }
+        }
+    } else {
+        let mut converter = request_json
+            .map(crate::protocol_proxy::ChatSseToResponsesConverter::with_request)
+            .unwrap_or_default();
+        let mut stream_failed = false;
+        loop {
+            tokio::select! {
+                frame = with_upstream_stream_idle_timeout(upstream_body.frame(), UPSTREAM_STREAM_IDLE_TIMEOUT) => match frame {
+                    Ok(Some(Ok(frame))) => {
+                        if let Ok(bytes) = frame.into_data() {
+                            let converted = converter.push_bytes(&bytes);
+                            if !converted.is_empty() {
+                                downstream_writer.write_all(&converted).await?;
+                            }
+                        }
+                    }
+                    Ok(Some(Err(error))) => {
+                        let failed = converter.fail(
+                            format!("Stream error: {error}"),
+                            Some("stream_error".to_string()),
+                        );
+                        if !failed.is_empty() {
+                            downstream_writer.write_all(&failed).await?;
+                        }
+                        stream_failed = true;
+                        break;
+                    }
+                    Ok(None) => break,
+                    Err(_) => {
+                        let failed = converter.fail(
+                            format!(
+                                "Upstream stream timed out after {} seconds without data",
+                                UPSTREAM_STREAM_IDLE_TIMEOUT.as_secs()
+                            ),
+                            Some("stream_timeout".to_string()),
+                        );
+                        if !failed.is_empty() {
+                            downstream_writer.write_all(&failed).await?;
+                        }
+                        log_helper_response(
+                            "helper.protocol_proxy_stream_timeout",
+                            method,
+                            path,
+                            "504 Gateway Timeout",
+                            remote_addr_text,
+                        );
+                        downstream_writer.shutdown().await?;
+                        return Ok(true);
+                    }
+                },
+                _ = wait_for_downstream_disconnect(&mut downstream_reader) => return Ok(true),
+            }
+        }
+        if !stream_failed {
+            let tail = converter.finish();
+            if !tail.is_empty() {
+                downstream_writer.write_all(&tail).await?;
+            }
+        }
+    }
+    log_helper_response(
+        "helper.protocol_proxy_stream_ok",
+        method,
+        path,
+        "200 OK",
+        remote_addr_text,
+    );
+    downstream_writer.shutdown().await?;
+    Ok(true)
+}
+
+async fn try_handle_cancel_aware_chat_completions_proxy_stream(
+    stream: &mut tokio::net::TcpStream,
+    request_body: &str,
+    request_user_agent: Option<&str>,
+    method: &str,
+    path: &str,
+    remote_addr_text: Option<String>,
+) -> anyhow::Result<bool> {
+    let open_upstream =
+        crate::protocol_proxy::open_cancel_aware_loopback_chat_completions_proxy_request(
+            request_body,
+            request_user_agent,
+        );
+    let open_result = tokio::select! {
+        result = open_upstream => result,
+        _ = wait_for_downstream_disconnect(stream) => return Ok(true),
+    };
+    let upstream = match open_result {
+        Ok(Some(upstream)) => upstream,
+        Ok(None) => return Ok(false),
+        Err(error) => {
+            let body = serde_json::to_vec(
+                &serde_json::json!({ "status": "failed", "message": error.to_string() }),
+            )?;
+            write_http_response(
+                stream,
+                "502 Bad Gateway",
+                "application/json; charset=utf-8",
+                &body,
+            )
+            .await?;
+            log_helper_response(
+                "helper.chat_completions_proxy_failed",
+                method,
+                path,
+                "502 Bad Gateway",
+                remote_addr_text,
+            );
+            stream.shutdown().await?;
+            return Ok(true);
+        }
+    };
+    let status = upstream.status();
+    let content_type = if upstream.content_type.is_empty() {
+        "application/json; charset=utf-8".to_string()
+    } else {
+        upstream.content_type.clone()
+    };
+    if !upstream.is_stream || !upstream.is_success() {
+        let is_success = upstream.is_success();
+        let body = collect_loopback_body(upstream.response).await?;
+        write_http_response(stream, &status, &content_type, &body).await?;
+        log_helper_response(
+            if is_success {
+                "helper.chat_completions_proxy_ok"
+            } else {
+                "helper.chat_completions_proxy_upstream_error"
+            },
+            method,
+            path,
+            &status,
+            remote_addr_text,
+        );
+        stream.shutdown().await?;
+        return Ok(true);
+    }
+
+    write_http_stream_headers(stream, &status, &content_type).await?;
+    let mut upstream_body = upstream.response.into_body();
+    let (mut downstream_reader, mut downstream_writer) = stream.split();
+    loop {
+        tokio::select! {
+            frame = with_upstream_stream_idle_timeout(upstream_body.frame(), UPSTREAM_STREAM_IDLE_TIMEOUT) => match frame {
+                Ok(Some(Ok(frame))) => {
+                    if let Ok(bytes) = frame.into_data() {
+                        downstream_writer.write_all(&bytes).await?;
+                    }
+                }
+                Ok(Some(Err(error))) => return Err(error.into()),
+                Ok(None) => break,
+                Err(_) => {
+                    log_helper_response(
+                        "helper.chat_completions_proxy_stream_timeout",
+                        method,
+                        path,
+                        "504 Gateway Timeout",
+                        remote_addr_text,
+                    );
+                    downstream_writer.shutdown().await?;
+                    return Ok(true);
+                }
+            },
+            _ = wait_for_downstream_disconnect(&mut downstream_reader) => return Ok(true),
+        }
+    }
+    log_helper_response(
+        "helper.chat_completions_proxy_stream_ok",
+        method,
+        path,
+        &status,
+        remote_addr_text,
+    );
+    downstream_writer.shutdown().await?;
+    Ok(true)
+}
