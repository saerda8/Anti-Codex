+fn patch_proxy_description(description: &str, action: &str, default_description: &str) -> String {
+    const DIRECT_TOOL_GUIDANCE: &str = "Call this structured function tool directly when it matches the file edit. Do not run apply_patch through shell_command, exec_command, PowerShell, cmd.exe, Bash, or another command-line wrapper, especially on Windows.";
+    let base = if description.trim().is_empty() {
+        default_description.to_string()
+    } else {
+        format!("{} (proxy action: {action})", description.trim())
+    };
+    format!("{base} {DIRECT_TOOL_GUIDANCE}")
+}
