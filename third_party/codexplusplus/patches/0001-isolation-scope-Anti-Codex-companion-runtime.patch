+pub(crate) fn has_version_suffix(base_url: &str) -> bool {
+    let segment = base_url.rsplit('/').next().unwrap_or(base_url);
+    let Some(rest) = segment.strip_prefix('v') else {
+        return false;
+    };
+    rest.chars().next().is_some_and(|ch| ch.is_ascii_digit())
+}
