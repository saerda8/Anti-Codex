+async fn with_upstream_stream_idle_timeout<F>(
+    future: F,
+    idle_timeout: std::time::Duration,
+) -> Result<F::Output, tokio::time::error::Elapsed>
+where
+    F: Future,
+{
+    tokio::time::timeout(idle_timeout, future).await
+}
