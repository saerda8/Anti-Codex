-            if name.is_empty() {
-                return;
-            }
-            let call_id = item
-                .get("call_id")
-                .or_else(|| item.get("id"))
-                .and_then(Value::as_str)
-                .unwrap_or("");
-            if call_id.is_empty() {
-                return;
-            }
-            seen_tool_call_ids.insert(call_id.to_string());
-            pending_tool_calls.push(json!({
-                "id": call_id,
-                "type": "function",
