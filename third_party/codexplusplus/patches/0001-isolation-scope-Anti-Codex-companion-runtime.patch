+fn explicit_codex_executable(app_dir: &Path, value: OsString) -> Option<PathBuf> {
+    let executable = PathBuf::from(value);
+    if executable.as_os_str().is_empty()
+        || !executable.is_absolute()
+        || !executable
+            .extension()
+            .and_then(OsStr::to_str)
+            .is_some_and(|extension| extension.eq_ignore_ascii_case("exe"))
+        || !executable.is_file()
+    {
+        return None;
+    }
+    let canonical_app_dir = std::fs::canonicalize(app_dir).ok()?;
+    let canonical_executable = std::fs::canonicalize(&executable).ok()?;
+    (canonical_executable.parent() == Some(canonical_app_dir.as_path())).then_some(executable)
+}
+
+fn configured_codex_executable_from_value(
+    app_dir: &Path,
+    value: Option<OsString>,
+) -> Option<PathBuf> {
+    let value = value?;
+    Some(explicit_codex_executable(app_dir, value).unwrap_or_default())
+}
+
+pub fn configured_codex_executable(app_dir: &Path) -> Option<PathBuf> {
+    configured_codex_executable_from_value(app_dir, std::env::var_os(APP_EXECUTABLE_ENV))
+}
+
+pub fn validate_isolated_copied_app_dir(app_dir: &Path) -> anyhow::Result<PathBuf> {
+    let configured_executable = std::env::var_os(APP_EXECUTABLE_ENV)
+        .map(PathBuf::from)
+        .ok_or_else(|| anyhow::anyhow!("{APP_EXECUTABLE_ENV} is required for an isolated app"))?;
+    validate_isolated_copied_app_dir_against(app_dir, &configured_executable)
+}
+
+fn validate_isolated_copied_app_dir_against(
+    app_dir: &Path,
+    configured_executable: &Path,
+) -> anyhow::Result<PathBuf> {
+    if app_dir.as_os_str().is_empty() || !app_dir.is_absolute() || !app_dir.is_dir() {
+        anyhow::bail!("copied app path must be an existing absolute directory");
+    }
+    if configured_executable.as_os_str().is_empty()
+        || !configured_executable.is_absolute()
+        || !configured_executable.is_file()
+        || !configured_executable
+            .extension()
+            .and_then(OsStr::to_str)
+            .is_some_and(|extension| extension.eq_ignore_ascii_case("exe"))
+    {
+        anyhow::bail!("configured copied app executable is invalid");
+    }
+    let configured_app_dir = configured_executable
+        .parent()
+        .ok_or_else(|| anyhow::anyhow!("configured copied app executable has no parent"))?;
+    if !exact_app_path_matches(app_dir, configured_app_dir) {
+        anyhow::bail!("app path is not the exact configured Anti-Codex copied-app root");
+    }
+    reject_symlink_components(app_dir)?;
+    reject_symlink_components(configured_executable)?;
+    let canonical_app_dir = std::fs::canonicalize(app_dir)?;
+    let canonical_executable = std::fs::canonicalize(configured_executable)?;
+    if canonical_executable.parent() != Some(canonical_app_dir.as_path()) {
+        anyhow::bail!("app path is not the exact configured Anti-Codex copied-app root");
+    }
+    Ok(canonical_app_dir)
+}
