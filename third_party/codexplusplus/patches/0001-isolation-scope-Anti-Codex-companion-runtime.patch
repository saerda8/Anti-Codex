+fn explicit_codex_executable(app_dir: &Path, value: OsString) -> Option<PathBuf> {
+    let executable = PathBuf::from(value);
+    if executable.as_os_str().is_empty()
+        || !executable.is_absolute()
+        || !executable
+            .extension()
+            .and_then(OsStr::to_str)
+            .is_some_and(|extension| extension.eq_ignore_ascii_case("exe"))
+        || !executable.is_file()
+    {
+        return None;
+    }
+    let canonical_app_dir = std::fs::canonicalize(app_dir).ok()?;
+    let canonical_executable = std::fs::canonicalize(&executable).ok()?;
+    (canonical_executable.parent() == Some(canonical_app_dir.as_path())).then_some(executable)
+}
+
+fn configured_codex_executable_from_value(
+    app_dir: &Path,
+    value: Option<OsString>,
+) -> Option<PathBuf> {
+    let value = value?;
+    Some(explicit_codex_executable(app_dir, value).unwrap_or_default())
+}
+
+pub fn configured_codex_executable(app_dir: &Path) -> Option<PathBuf> {
+    configured_codex_executable_from_value(app_dir, std::env::var_os(APP_EXECUTABLE_ENV))
+}
