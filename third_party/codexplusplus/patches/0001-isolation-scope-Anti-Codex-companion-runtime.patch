-                    openai_name: name.to_string(),
-                    kind: CodexCustomToolKind::Raw,
-                    proxy_action: None,
-                },
-            );
-            context.has_custom_tools = true;
-            continue;
-        }
-        let tool_type = tool.get("type").and_then(Value::as_str).unwrap_or("");
-        match tool_type {
