+#[cfg(windows)]
+fn normalized_windows_path(path: &Path) -> String {
+    path.to_string_lossy()
+        .replace('/', "\\")
+        .trim_end_matches('\\')
+        .to_ascii_lowercase()
+}
+
+#[cfg(windows)]
+fn process_path_is_in_app(process_path: &Path, target_app_path: &Path) -> bool {
+    let process_path = normalized_windows_path(process_path);
+    let target_path = normalized_windows_path(target_app_path);
+    if target_path.ends_with(".exe") {
+        return process_path == target_path;
+    }
+    process_path == target_path || process_path.starts_with(&format!("{target_path}\\"))
+}
+
+#[cfg(windows)]
+pub fn find_codex_processes_from_snapshot_for_executable(
+    processes: &[crate::windows_integration::WindowsProcessInfo],
+    target_executable: &Path,
+) -> Vec<u32> {
+    let mut ids = processes
+        .iter()
+        .filter(|process| {
+            process
+                .executable_path
+                .as_deref()
+                .is_some_and(|path| process_path_is_in_app(path, target_executable))
+        })
+        .map(|process| process.process_id)
+        .collect::<Vec<_>>();
+    ids.sort_unstable();
+    ids.dedup();
+    ids
+}
+
+#[cfg(windows)]
+pub fn find_codex_processes_from_snapshot_for_app_path(
+    processes: &[crate::windows_integration::WindowsProcessInfo],
+    target_app_path: &Path,
+) -> Vec<u32> {
+    let target_executable = if target_app_path.extension() == Some(std::ffi::OsStr::new("exe")) {
+        target_app_path.to_path_buf()
+    } else {
+        crate::app_paths::build_codex_executable(target_app_path)
+    };
+    find_codex_processes_from_snapshot_for_executable(processes, &target_executable)
+}
+
+#[cfg(windows)]
+pub fn find_codex_processes_for_app_path(target_app_path: &Path) -> Vec<u32> {
+    let processes = crate::windows_integration::enumerate_processes();
+    find_codex_processes_from_snapshot_for_app_path(&processes, target_app_path)
+}
+
+#[cfg(not(windows))]
+pub fn find_codex_processes_for_app_path(_target_app_path: &Path) -> Vec<u32> {
+    Vec::new()
+}
