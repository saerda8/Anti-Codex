+async fn wait_for_downstream_disconnect<R>(reader: &mut R)
+where
+    R: tokio::io::AsyncRead + Unpin,
+{
+    let mut byte = [0_u8; 1];
+    loop {
+        match reader.read(&mut byte).await {
+            Ok(0) | Err(_) => return,
+            Ok(_) => {}
+        }
+    }
+}
