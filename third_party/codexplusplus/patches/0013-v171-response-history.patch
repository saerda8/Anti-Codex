+#[test]
+fn ttl_capacity_entry_size_collision_and_concurrent_writers_fail_closed() {
+    let root = TempDir::new().unwrap();
+    let now = Arc::new(AtomicU64::new(1_000));
+    let history = store(&root, None, limits(1), now.clone());
+    history
+        .persist_completed(&parent_request(), &parent_response())
+        .unwrap();
+    let other = json!({"id":"resp_other","status":"completed","output":[]});
+    assert!(matches!(
+        history.persist_completed(&json!({"input":"other"}), &other),
+        Err(ResponseHistoryError::Capacity { .. })
+    ));
+
+    assert_eq!(
+        history
+            .persist_completed(&parent_request(), &parent_response())
+            .unwrap(),
+        PersistOutcome::AlreadyPresent
+    );
+    let changed = json!({"id":"resp_parent","status":"completed","output":[]});
+    assert!(matches!(
+        history.persist_completed(&parent_request(), &changed),
+        Err(ResponseHistoryError::Collision { .. })
+    ));
+
+    now.store(31_001, Ordering::SeqCst);
+    let mut expired = json!({"previous_response_id":"resp_parent","input":"continue"});
+    assert!(matches!(
+        history.hydrate_request(&mut expired, MissingHistoryBehavior::Error),
+        Err(ResponseHistoryError::Missing { .. })
+    ));
+    assert_eq!(
+        history
+            .persist_completed(&json!({"input":"other"}), &other)
+            .unwrap(),
+        PersistOutcome::Saved
+    );
+
+    let tiny = ResponseHistoryLimits {
+        max_entry_bytes: 256,
+        ..limits(8)
+    };
+    let tiny_root = TempDir::new().unwrap();
+    let tiny_store = store(&tiny_root, Some("tiny"), tiny, now.clone());
+    let oversized = json!({
+        "id":"resp_large",
+        "status":"completed",
+        "output":[{"type":"message","role":"assistant","content":"x".repeat(1000)}]
+    });
+    assert!(matches!(
+        tiny_store.persist_completed(&json!({"input":"large"}), &oversized),
+        Err(ResponseHistoryError::EntryTooLarge { .. })
+    ));
+
+    let concurrent_root = TempDir::new().unwrap();
+    let concurrent = store(&concurrent_root, Some("concurrent"), limits(2), now);
+    let first = concurrent.clone();
+    let second = concurrent.clone();
+    let left = thread::spawn(move || {
+        first.persist_completed(
+            &json!({"input":"left"}),
+            &json!({"id":"resp_left","status":"completed","output":[]}),
+        )
+    });
+    let right = thread::spawn(move || {
+        second.persist_completed(
+            &json!({"input":"right"}),
+            &json!({"id":"resp_right","status":"completed","output":[]}),
+        )
+    });
+    assert!(left.join().unwrap().is_ok());
+    assert!(right.join().unwrap().is_ok());
+    assert_eq!(concurrent.committed_entry_count().unwrap(), 2);
+}
