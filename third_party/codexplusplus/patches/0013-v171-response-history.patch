+fn persist_response_history(
+    context: Option<&crate::protocol_proxy::UpstreamResponseHistory>,
+    response: &Value,
+) -> Result<(), crate::response_history::ResponseHistoryError> {
+    let Some(context) = context else {
+        return Ok(());
+    };
+    if !context.complete_chain {
+        return Ok(());
+    }
+    context
+        .store
+        .persist_completed(&context.effective_request, response)
+        .map(|_| ())
+}
+
+fn apply_local_response_history_parent(
+    response: &mut Value,
+    context: Option<&crate::protocol_proxy::UpstreamResponseHistory>,
+) {
+    let Some(context) = context.filter(|context| context.locally_resolved) else {
+        return;
+    };
+    if let Some(parent_id) = context.parent_id.as_ref() {
+        response["previous_response_id"] = Value::String(parent_id.clone());
+    }
+}
+
+fn response_history_failed_sse(
+    completed_response: &Value,
+    error: &crate::response_history::ResponseHistoryError,
+) -> Vec<u8> {
+    let mut response = completed_response.clone();
+    response["status"] = Value::String("failed".to_string());
+    response["error"] = json!({
+        "type": "response_history_error",
+        "message": "Response history persistence failed.",
+        "details": {"status": error.http_status(), "retryable": false}
+    });
+    let mut output = String::new();
+    output.push_str("event: response.failed\n");
+    output.push_str("data: ");
+    output.push_str(
+        &serde_json::to_string(&json!({"type":"response.failed","response":response}))
+            .unwrap_or_else(|_| "{\"type\":\"response.failed\"}".to_string()),
+    );
+    output.push_str("\n\n");
+    output.into_bytes()
+}
+
+async fn write_response_history_http_error(
+    stream: &mut tokio::net::TcpStream,
+    error: &crate::response_history::ResponseHistoryError,
+) -> anyhow::Result<()> {
+    let body = serde_json::to_vec(&error.response_body())?;
+    write_http_response(
+        stream,
+        response_history_status_line(error.http_status()),
+        "application/json; charset=utf-8",
+        &body,
+    )
+    .await
+}
+
+fn response_history_status_line(status: u16) -> &'static str {
+    match status {
+        400 => "400 Bad Request",
+        410 => "410 Gone",
+        _ => "500 Internal Server Error",
+    }
+}
