+use codex_plus_core::response_history::{
+    HydrationOutcome, MissingHistoryBehavior, PersistOutcome, ResponseHistoryError,
+    ResponseHistoryLimits, ResponseHistoryStore,
+};
+use serde_json::json;
+use std::sync::Arc;
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::thread;
+use std::time::Duration;
+use tempfile::TempDir;
+
+fn limits(max_entries: usize) -> ResponseHistoryLimits {
+    ResponseHistoryLimits {
+        max_entries,
+        max_total_bytes: 1024 * 1024,
+        max_entry_bytes: 256 * 1024,
+        ttl: Duration::from_secs(30),
+    }
+}
+
+fn store(
+    root: &TempDir,
+    authorization: Option<&str>,
+    limits: ResponseHistoryLimits,
+    now_ms: Arc<AtomicU64>,
+) -> ResponseHistoryStore {
+    ResponseHistoryStore::with_limits_and_clock(
+        root.path().to_path_buf(),
+        authorization,
+        limits,
+        Arc::new(move || now_ms.load(Ordering::SeqCst)),
+    )
+}
+
+fn parent_request() -> serde_json::Value {
+    json!({
+        "model": "model-a",
+        "instructions": "current-only setting",
+        "tools": [{"type":"function","name":"lookup","parameters":{"type":"object"}}],
+        "input": [{
+            "type": "message",
+            "role": "user",
+            "content": [{"type":"input_text","text":"remember cedar"}]
+        }]
+    })
+}
+
+fn parent_response() -> serde_json::Value {
+    json!({
+        "id": "resp_parent",
+        "object": "response",
+        "status": "completed",
+        "output": [{
+            "id": "msg_parent",
+            "type": "message",
+            "status": "completed",
+            "role": "assistant",
+            "content": [{"type":"output_text","text":"cedar","annotations":[]}]
+        }]
+    })
+}
+
+#[test]
+fn persisted_history_reopens_and_exact_normalized_prefix_is_not_duplicated() {
+    let root = TempDir::new().unwrap();
+    let now = Arc::new(AtomicU64::new(1_000));
+    let first = store(&root, Some("Bearer alpha-secret"), limits(8), now.clone());
+    assert_eq!(
+        first
+            .persist_completed(&parent_request(), &parent_response())
+            .unwrap(),
+        PersistOutcome::Saved
+    );
+    let stored_bytes = std::fs::read_dir(root.path().join("responses-history-v1"))
+        .unwrap()
+        .filter_map(Result::ok)
+        .filter(|entry| entry.path().extension().and_then(|value| value.to_str()) == Some("json"))
+        .flat_map(|entry| std::fs::read(entry.path()).unwrap_or_default())
+        .collect::<Vec<_>>();
+    let stored_text = String::from_utf8(stored_bytes).unwrap();
+    assert!(!stored_text.contains("alpha-secret"));
+    assert!(!stored_text.contains("current-only setting"));
+    assert!(!stored_text.contains("lookup"));
+    assert!(!stored_text.contains("model-a"));
+    drop(first);
+
+    let reopened = store(&root, Some("bearer   alpha-secret"), limits(8), now);
+    let mut request = json!({
+        "model": "model-b",
+        "previous_response_id": "resp_parent",
+        "instructions": "new instruction",
+        "tools": [],
+        "input": [
+            {"role":"user","content":"remember cedar"},
+            {"role":"assistant","content":"cedar"},
+            {"role":"user","content":"what was it?"}
+        ]
+    });
+    assert_eq!(
+        reopened
+            .hydrate_request(&mut request, MissingHistoryBehavior::Error)
+            .unwrap(),
+        HydrationOutcome {
+            parent_id: Some("resp_parent".to_string()),
+            locally_resolved: true,
+        }
+    );
+    let input = request["input"].as_array().unwrap();
+    assert_eq!(
+        input.len(),
+        3,
+        "the explicit full prefix must not be duplicated"
+    );
+    assert_eq!(request["instructions"], "new instruction");
+    assert_eq!(request["tools"], json!([]));
+}
+
+#[test]
+fn previous_response_scope_isolated_and_unknown_parent_behavior_is_explicit() {
+    let root = TempDir::new().unwrap();
+    let now = Arc::new(AtomicU64::new(10));
+    let alpha = store(&root, Some("Bearer alpha"), limits(8), now.clone());
+    alpha
+        .persist_completed(&parent_request(), &parent_response())
+        .unwrap();
+
+    let beta = store(&root, Some("Bearer beta"), limits(8), now);
+    let mut beta_request = json!({
+        "previous_response_id": "resp_parent",
+        "input": "continue"
+    });
+    let missing = beta
+        .hydrate_request(&mut beta_request, MissingHistoryBehavior::Error)
+        .unwrap_err();
+    assert!(matches!(
+        &missing,
+        ResponseHistoryError::Missing { previous_response_id }
+            if previous_response_id == "resp_parent"
+    ));
+    let body = missing.response_body();
+    assert_eq!(missing.http_status(), 410);
+    assert_eq!(body["error"]["type"], "response_history_missing");
+    assert_eq!(body["error"]["details"]["retryable"], false);
+    assert_eq!(
+        body["error"]["details"]["previous_response_id"],
+        "resp_parent"
+    );
+
+    let mut native_passthrough = beta_request.clone();
+    assert_eq!(
+        beta.hydrate_request(&mut native_passthrough, MissingHistoryBehavior::Passthrough)
+            .unwrap(),
+        HydrationOutcome {
+            parent_id: Some("resp_parent".to_string()),
+            locally_resolved: false,
+        }
+    );
+    assert_eq!(native_passthrough["previous_response_id"], "resp_parent");
+
+    let mut empty_parent = json!({"previous_response_id":"", "input":"continue"});
+    assert!(matches!(
+        beta.hydrate_request(&mut empty_parent, MissingHistoryBehavior::Passthrough),
+        Err(ResponseHistoryError::Missing { ref previous_response_id }) if previous_response_id.is_empty()
+    ));
+
+    let mut null_parent = json!({"previous_response_id":null, "input":"fresh"});
+    assert_eq!(
+        beta.hydrate_request(&mut null_parent, MissingHistoryBehavior::Error)
+            .unwrap(),
+        HydrationOutcome {
+            parent_id: None,
+            locally_resolved: false,
+        }
+    );
+    assert_eq!(null_parent["input"], "fresh");
+}
