+#[test]
+fn nested_business_identity_is_not_removed_by_prefix_normalization() {
+    let root = TempDir::new().unwrap();
+    let now = Arc::new(AtomicU64::new(15));
+    let history = store(&root, None, limits(8), now);
+    history
+        .persist_completed(
+            &json!({"input":"start"}),
+            &json!({
+                "id":"resp_nested",
+                "status":"completed",
+                "output":[{
+                    "id":"tool_item_transport",
+                    "status":"completed",
+                    "type":"function_call_output",
+                    "call_id":"call_1",
+                    "output":{"id":"business-a","status":"open","value":1}
+                }]
+            }),
+        )
+        .unwrap();
+    let mut child = json!({
+        "previous_response_id":"resp_nested",
+        "input":[
+            {"type":"message","role":"user","content":"start"},
+            {"type":"function_call_output","call_id":"call_1",
+             "output":{"id":"business-b","status":"open","value":1}},
+            {"type":"message","role":"user","content":"continue"}
+        ]
+    });
+    history
+        .hydrate_request(&mut child, MissingHistoryBehavior::Error)
+        .unwrap();
+    assert_eq!(child["input"].as_array().unwrap().len(), 5);
