+fn prepare_response_history_for_relay(
+    store: Option<&crate::response_history::ResponseHistoryStore>,
+    effective_request: &mut Value,
+    protocol: RelayProtocol,
+) -> Result<Option<UpstreamResponseHistory>, crate::response_history::ResponseHistoryError> {
+    let Some(store) = store else {
+        return Ok(None);
+    };
+    let missing_behavior = if protocol == RelayProtocol::Responses {
+        crate::response_history::MissingHistoryBehavior::Passthrough
+    } else {
+        crate::response_history::MissingHistoryBehavior::Error
+    };
+    let outcome = store.hydrate_request(effective_request, missing_behavior)?;
+    if protocol == RelayProtocol::Responses && outcome.locally_resolved {
+        if let Some(object) = effective_request.as_object_mut() {
+            object.remove("previous_response_id");
+        }
+    }
+    Ok(Some(UpstreamResponseHistory {
+        store: store.clone(),
+        effective_request: effective_request.clone(),
+        complete_chain: outcome.parent_id.is_none() || outcome.locally_resolved,
+        parent_id: outcome.parent_id,
+        locally_resolved: outcome.locally_resolved,
+    }))
+}
