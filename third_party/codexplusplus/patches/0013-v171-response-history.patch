+#[cfg(test)]
+mod response_history_routing_tests {
+    use std::sync::Arc;
+    use std::time::Duration;
+
+    use serde_json::json;
+
+    use super::{NativeResponsesSseObserver, RelayProtocol, prepare_response_history_for_relay};
+    use crate::response_history::{
+        ResponseHistoryError, ResponseHistoryLimits, ResponseHistoryStore,
+    };
+
+    fn store(root: &std::path::Path) -> ResponseHistoryStore {
+        ResponseHistoryStore::with_limits_and_clock(
+            root.to_path_buf(),
+            Some("Bearer scoped"),
+            ResponseHistoryLimits {
+                max_entries: 8,
+                max_total_bytes: 1024 * 1024,
+                max_entry_bytes: 256 * 1024,
+                ttl: Duration::from_secs(60),
+            },
+            Arc::new(|| 1_000),
+        )
+    }
+
+    #[test]
+    fn native_missing_parent_stays_upstream_owned_and_is_not_locally_persistable() {
+        let root = tempfile::tempdir().unwrap();
+        let store = store(root.path());
+        let mut request = json!({
+            "previous_response_id":"resp_upstream_only",
+            "input":"continue"
+        });
+        let history = prepare_response_history_for_relay(
+            Some(&store),
+            &mut request,
+            RelayProtocol::Responses,
+        )
+        .unwrap()
+        .unwrap();
+        assert!(!history.locally_resolved);
+        assert!(!history.complete_chain);
+        assert_eq!(request["previous_response_id"], "resp_upstream_only");
+        assert_eq!(
+            history.effective_request["previous_response_id"],
+            "resp_upstream_only"
+        );
+    }
+
+    #[test]
+    fn chat_missing_parent_fails_before_upstream_and_native_hit_removes_parent() {
+        let root = tempfile::tempdir().unwrap();
+        let store = store(root.path());
+        let mut missing = json!({"previous_response_id":"resp_missing","input":"continue"});
+        assert!(matches!(
+            prepare_response_history_for_relay(
+                Some(&store),
+                &mut missing,
+                RelayProtocol::ChatCompletions,
+            ),
+            Err(ResponseHistoryError::Missing { .. })
+        ));
+
+        store
+            .persist_completed(
+                &json!({"input":"remember"}),
+                &json!({
+                    "id":"resp_parent",
+                    "status":"completed",
+                    "output":[{"type":"message","role":"assistant","content":"stored"}]
+                }),
+            )
+            .unwrap();
+        let mut native = json!({"previous_response_id":"resp_parent","input":"continue"});
+        let history =
+            prepare_response_history_for_relay(Some(&store), &mut native, RelayProtocol::Responses)
+                .unwrap()
+                .unwrap();
+        assert!(history.locally_resolved);
+        assert!(history.complete_chain);
+        assert!(native.get("previous_response_id").is_none());
+        assert_eq!(native["input"].as_array().unwrap().len(), 3);
+    }
+
+    #[test]
+    fn native_history_observer_forwards_intermediate_events_and_holds_success_terminal() {
+        let stream = concat!(
+            "event: response.created\n",
+            "data: {\"type\":\"response.created\",\"response\":{\"id\":\"resp_native\"}}\n\n",
+            "event: response.output_text.delta\n",
+            "data: {\"type\":\"response.output_text.delta\",\"delta\":\"hello\"}\n\n",
+            "event: response.completed\n",
+            "data: {\"type\":\"response.completed\",\"response\":{\"id\":\"resp_native\",\"status\":\"completed\",\"output\":[]}}\n\n",
+            "data: [DONE]\n\n"
+        );
+        let mut observer = NativeResponsesSseObserver::default();
+        let forwarded = String::from_utf8(observer.push_bytes(stream.as_bytes())).unwrap();
+        assert!(forwarded.contains("response.created"));
+        assert!(forwarded.contains("response.output_text.delta"));
+        assert!(!forwarded.contains("response.completed"));
+        assert!(!forwarded.contains("[DONE]"));
+
+        let outcome = observer.finish();
+        assert!(outcome.failure.is_none());
+        assert_eq!(outcome.response_id.as_deref(), Some("resp_native"));
+        let response = outcome.completed_response.clone().unwrap();
+        let terminal = String::from_utf8(outcome.terminal_bytes(&response)).unwrap();
+        assert!(terminal.contains("event: response.completed"));
+        assert!(terminal.contains("data: [DONE]"));
+    }
