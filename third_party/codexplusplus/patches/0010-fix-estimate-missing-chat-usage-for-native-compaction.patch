+fn completed_response_from_sse(sse: &str) -> Value {
+    sse.lines()
+        .filter_map(|line| line.strip_prefix("data: "))
+        .filter_map(|data| serde_json::from_str::<Value>(data).ok())
+        .find(|event| event["type"] == "response.completed")
+        .and_then(|event| event.get("response").cloned())
+        .expect("response.completed event")
+}
+
+#[test]
+fn chat_sse_estimates_nonzero_usage_when_upstream_omits_it() {
+    let request = json!({
+        "model": "gemini-3.1-pro-low",
+        "instructions": "Continue the existing task.",
+        "input": [{
+            "type": "message",
+            "role": "user",
+            "content": [{ "type": "input_text", "text": "continue" }]
+        }],
+        "tools": [{
+            "type": "function",
+            "name": "shell_command",
+            "description": "Run a shell command",
+            "parameters": { "type": "object" }
+        }]
+    });
+    let converted = chat_sse_to_responses_sse_with_request(
+        r#"data: {"id":"chatcmpl_no_usage","created":1710000000,"model":"gemini-3.1-pro-low","choices":[{"delta":{"content":"working"},"finish_reason":"stop"}]}
+
+data: [DONE]
+
+"#,
+        &request,
+    );
+    let response = completed_response_from_sse(&converted);
+    let usage = &response["usage"];
+    let input_tokens = usage["input_tokens"].as_u64().unwrap();
+    let output_tokens = usage["output_tokens"].as_u64().unwrap();
+
+    assert!(input_tokens > 0);
+    assert!(output_tokens > 0);
+    assert_eq!(usage["total_tokens"], input_tokens + output_tokens);
+}
+
+#[test]
+fn chat_sse_real_usage_overrides_the_fallback_estimate() {
+    let request = json!({
+        "model": "gemini-3.1-pro-low",
+        "input": "This request is intentionally longer than three tokens."
+    });
+    let converted = chat_sse_to_responses_sse_with_request(
+        r#"data: {"id":"chatcmpl_real_usage","created":1710000000,"model":"gemini-3.1-pro-low","choices":[{"delta":{"content":"ok"},"finish_reason":"stop"}],"usage":{"prompt_tokens":3,"completion_tokens":2,"total_tokens":5}}
+
+data: [DONE]
+
+"#,
+        &request,
+    );
+    let response = completed_response_from_sse(&converted);
+
+    assert_eq!(response["usage"]["input_tokens"], 3);
+    assert_eq!(response["usage"]["output_tokens"], 2);
+    assert_eq!(response["usage"]["total_tokens"], 5);
+}
+
+#[test]
+fn chat_sse_usage_estimate_does_not_count_base64_images_as_text() {
+    fn usage_for_image_size(base64_len: usize) -> Value {
+        let image_url = format!("data:image/png;base64,{}", "A".repeat(base64_len));
+        let request = json!({
+            "model": "gemini-3.1-pro-low",
+            "input": [{
+                "type": "message",
+                "role": "user",
+                "content": [
+                    { "type": "input_text", "text": "inspect this image" },
+                    { "type": "input_image", "image_url": image_url }
+                ]
+            }]
+        });
+        let converted = chat_sse_to_responses_sse_with_request(
+            r#"data: {"id":"chatcmpl_image_no_usage","created":1710000000,"model":"gemini-3.1-pro-low","choices":[{"delta":{"content":"done"},"finish_reason":"stop"}]}
+
+data: [DONE]
+
+"#,
+            &request,
+        );
+        completed_response_from_sse(&converted)["usage"].clone()
+    }
+
+    let small_image_usage = usage_for_image_size(8);
+    let large_image_usage = usage_for_image_size(200_000);
+    let input_tokens = large_image_usage["input_tokens"].as_u64().unwrap();
+
+    assert!(input_tokens > 0);
+    assert!(input_tokens < 10_000, "base64 image was counted as text");
+    assert_eq!(large_image_usage, small_image_usage);
+}
