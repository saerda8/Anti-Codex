@@ -2422,6 +2425,30 @@ impl ChatSseState {
         })
     }
 
+    fn estimated_usage(&self) -> Option<Value> {
+        let request = self.original_request.as_ref()?;
+        let input_tokens = ["instructions", "input", "tools"]
+            .into_iter()
+            .filter_map(|key| request.get(key))
+            .map(estimated_json_tokens)
+            .fold(0_u64, u64::saturating_add)
+            .max(1);
+        let output_tokens = estimated_text_tokens(&self.reasoning.text)
+            .saturating_add(estimated_text_tokens(&self.text.text))
+            .saturating_add(self.tools.values().fold(0_u64, |total, tool| {
+                total
+                    .saturating_add(estimated_text_tokens(&tool.name))
+                    .saturating_add(estimated_text_tokens(&tool.arguments))
+            }))
+            .max(1);
+
+        Some(json!({
+            "input_tokens": input_tokens,
+            "output_tokens": output_tokens,
+            "total_tokens": input_tokens.saturating_add(output_tokens)
+        }))
+    }
+
     fn next_output_index(&mut self) -> u32 {
         let index = self.next_output_index;
         self.next_output_index += 1;
@@ -4167,6 +4194,54 @@ fn default_responses_usage() -> Value {
     json!({ "input_tokens": 0, "output_tokens": 0, "total_tokens": 0 })
 }
 
+fn estimated_text_tokens(text: &str) -> u64 {
+    if text.starts_with("data:image/") && text.contains(";base64,") {
+        return 1_024;
+    }
+    let trimmed = text.trim();
+    if (trimmed.starts_with('{') || trimmed.starts_with('['))
+        && let Ok(value) = serde_json::from_str::<Value>(trimmed)
+    {
+        return estimated_json_tokens(&value);
+    }
+    (text.len() as u64).saturating_add(1) / 2
+}
+
+fn estimated_json_tokens(value: &Value) -> u64 {
+    match value {
+        Value::Null | Value::Bool(_) | Value::Number(_) => 1,
+        Value::String(text) => estimated_text_tokens(text),
+        Value::Array(values) => values
+            .iter()
+            .map(estimated_json_tokens)
+            .fold(0_u64, u64::saturating_add),
+        Value::Object(values) => {
+            let image_payload = values
+                .get("type")
+                .and_then(Value::as_str)
+                .is_some_and(|kind| kind.contains("image"))
+                || ["mime_type", "mimeType"]
+                    .into_iter()
+                    .filter_map(|key| values.get(key).and_then(Value::as_str))
+                    .any(|mime| mime.starts_with("image/"));
+            values.iter().fold(
+                if image_payload { 1_024_u64 } else { 0_u64 },
+                |total, (key, value)| {
+                    let value_tokens =
+                        if image_payload && matches!(key.as_str(), "data" | "image_url" | "url") {
+                            0
+                        } else {
+                            estimated_json_tokens(value)
+                        };
+                    total
+                        .saturating_add(estimated_text_tokens(key))
+                        .saturating_add(value_tokens)
+                },
+            )
+        }
+    }
+}
