+                "legacy_probe"
+            ]
+        }));
+
+        assert_eq!(audit["count"], 4);
+        assert_eq!(
+            audit["names"],
+            json!([
+                "apply_patch",
+                "shell_command",
+                "nested_probe",
+                "legacy_probe"
+            ])
+        );
+        assert_eq!(
+            audit["types"],
+            json!(["custom", "function", "function", "string"])
+        );
+        assert!(!audit.to_string().contains("secret"));
+    }
