+    fn request_tool_audit_reports_names_and_types_without_arguments() {
+        let audit = request_tool_audit(&json!({
+            "tools": [
+                {"type": "custom", "name": "apply_patch", "format": {"type": "grammar", "syntax": "secret"}},
+                {"type": "function", "name": "shell_command", "parameters": {"token": "secret"}},
