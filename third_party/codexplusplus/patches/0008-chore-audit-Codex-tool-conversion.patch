+fn request_tool_audit(body: &Value) -> Value {
+    let tools = body
+        .get("tools")
+        .and_then(Value::as_array)
+        .map(Vec::as_slice)
+        .unwrap_or(&[]);
+    let names = tools
+        .iter()
+        .filter_map(|tool| {
+            tool.as_str()
+                .or_else(|| tool.get("name").and_then(Value::as_str))
+                .or_else(|| tool.pointer("/function/name").and_then(Value::as_str))
+        })
+        .filter(|name| !name.is_empty())
+        .collect::<Vec<_>>();
+    let types = tools
+        .iter()
+        .filter_map(|tool| {
+            tool.get("type")
+                .and_then(Value::as_str)
+                .or_else(|| tool.as_str().map(|_| "string"))
+        })
+        .filter(|tool_type| !tool_type.is_empty())
+        .collect::<Vec<_>>();
+    json!({
+        "count": tools.len(),
+        "names": names,
+        "types": types
+    })
+}
+
 pub fn chat_completion_to_response(body: Value) -> anyhow::Result<Value> {
