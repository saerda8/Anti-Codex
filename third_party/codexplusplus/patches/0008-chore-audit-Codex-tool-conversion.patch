     #[test]
     fn protocol_proxy_port_accepts_only_nonzero_u16_values() {
@@ -101,6 +102,34 @@ mod isolation_port_tests {
             DEFAULT_PROTOCOL_PROXY_PORT
         );
     }
+
+    #[test]
+    fn request_tool_audit_reports_names_and_types_without_arguments() {
+        let audit = request_tool_audit(&json!({
+            "tools": [
+                {"type": "custom", "name": "apply_patch", "format": {"type": "grammar", "syntax": "secret"}},
+                {"type": "function", "name": "shell_command", "parameters": {"token": "secret"}},
+                {"type": "function", "function": {"name": "nested_probe", "parameters": {"token": "secret"}}},
+                "legacy_probe"
+            ]
+        }));
+
+        assert_eq!(audit["count"], 4);
+        assert_eq!(
+            audit["names"],
+            json!([
+                "apply_patch",
+                "shell_command",
+                "nested_probe",
+                "legacy_probe"
+            ])
+        );
+        assert_eq!(
+            audit["types"],
+            json!(["custom", "function", "function", "string"])
+        );
+        assert!(!audit.to_string().contains("secret"));
+    }
 }
 
 #[derive(Debug, Clone, Copy, PartialEq, Eq)]
@@ -302,6 +331,37 @@ pub fn responses_to_chat_completions(body: Value) -> anyhow::Result<Value> {
     Ok(result)
 }
 
+fn request_tool_audit(body: &Value) -> Value {
+    let tools = body
+        .get("tools")
+        .and_then(Value::as_array)
+        .map(Vec::as_slice)
+        .unwrap_or(&[]);
+    let names = tools
+        .iter()
+        .filter_map(|tool| {
+            tool.as_str()
+                .or_else(|| tool.get("name").and_then(Value::as_str))
+                .or_else(|| tool.pointer("/function/name").and_then(Value::as_str))
+        })
+        .filter(|name| !name.is_empty())
+        .collect::<Vec<_>>();
+    let types = tools
+        .iter()
+        .filter_map(|tool| {
+            tool.get("type")
+                .and_then(Value::as_str)
+                .or_else(|| tool.as_str().map(|_| "string"))
+        })
+        .filter(|tool_type| !tool_type.is_empty())
+        .collect::<Vec<_>>();
+    json!({
+        "count": tools.len(),
+        "names": names,
+        "types": types
+    })
+}
+
 pub fn chat_completion_to_response(body: Value) -> anyhow::Result<Value> {
     chat_completion_to_response_with_context(body, &CodexToolContext::default(), None)
 }
