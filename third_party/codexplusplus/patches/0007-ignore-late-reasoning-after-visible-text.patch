+#[test]
+fn chat_sse_does_not_interleave_late_reasoning_with_started_text() {
+    let converted = chat_sse_to_responses_sse(
+        r#"data: {"id":"chatcmpl_late_reasoning","created":123,"model":"gpt-5.6-sol","choices":[{"delta":{"content":"Starting work. "}}]}
+
+data: {"id":"chatcmpl_late_reasoning","created":123,"model":"gpt-5.6-sol","choices":[{"delta":{"reasoning_content":"This arrived after visible text."}}]}
+
+data: {"id":"chatcmpl_late_reasoning","created":123,"model":"gpt-5.6-sol","choices":[{"delta":{"content":"Continuing now."},"finish_reason":"stop"}]}
+
+data: [DONE]
+
+"#,
+    );
+
+    assert_eq!(
+        converted
+            .matches("event: response.output_item.added")
+            .count(),
+        1
+    );
+    assert!(!converted.contains("event: response.reasoning_summary_part.added"));
+    assert!(!converted.contains("This arrived after visible text."));
+    assert!(converted.contains("\"delta\":\"Starting work. \""));
+    assert!(converted.contains("\"delta\":\"Continuing now.\""));
+    assert!(converted.contains("\"text\":\"Starting work. Continuing now.\""));
+}
