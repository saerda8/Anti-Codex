+                .map(|item| sanitize_response_output_images(item, image_urls))
+                .collect(),
+        ),
+        Value::Object(object) => {
+            let image_kind = object.get("type").and_then(Value::as_str).unwrap_or("");
+            let image_url = match image_kind {
+                "image" => object
+                    .get("data")
+                    .and_then(Value::as_str)
+                    .filter(|data| !data.is_empty())
+                    .map(|data| {
+                        if data.starts_with("data:image/") {
+                            data.to_string()
+                        } else {
+                            let mime_type = object
+                                .get("mimeType")
+                                .or_else(|| object.get("mime_type"))
+                                .and_then(Value::as_str)
+                                .filter(|mime| mime.starts_with("image/"))
+                                .unwrap_or("image/png");
+                            format!("data:{mime_type};base64,{data}")
+                        }
+                    }),
+                "input_image" | "image_url" => {
+                    object.get("image_url").and_then(response_output_image_url)
+                }
+                _ => object.get("image_url").and_then(response_output_image_url),
+            };
+
+            if let Some(image_url) = image_url.filter(|url| !url.is_empty()) {
+                if !image_urls.contains(&image_url) {
+                    image_urls.push(image_url);
+                }
+                let mut sanitized = object.clone();
+                if image_kind == "image" {
+                    sanitized.insert("data".to_string(), json!(TOOL_IMAGE_PLACEHOLDER));
+                } else {
+                    sanitized.insert("image_url".to_string(), json!(TOOL_IMAGE_PLACEHOLDER));
+                }
+                for (key, item) in object {
+                    if key == "data" || key == "image_url" {
+                        continue;
+                    }
+                    sanitized.insert(
+                        key.clone(),
