+            .unwrap_or("")
+            .trim();
+        let description = if current.is_empty() {
+            GUIDANCE.to_string()
+        } else {
+            format!("{current} {GUIDANCE}")
+        };
+        function.insert("description".to_string(), Value::String(description));
+    }
