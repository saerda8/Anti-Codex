+    task_ownership_id(tokens).is_some_and(|task_id| name == format!("anticodex-{task_id}"))
+}
+
+fn is_task_id(task_id: &str) -> bool {
+    let task_id = task_id.trim_matches(['\'', '"']);
+    task_id.len() == 36
+        && task_id.bytes().enumerate().all(|(index, byte)| {
+            if matches!(index, 8 | 13 | 18 | 23) {
+                byte == b'-'
+            } else {
+                byte.is_ascii_hexdigit()
+            }
+        })
+}
+
+fn has_quiet_option(tokens: &[String]) -> bool {
+    tokens.iter().any(|token| {
+        token == "--quiet"
+            || token == "-q"
+            || (token.starts_with('-')
+                && !token.starts_with("--")
+                && token.as_bytes()[1..].contains(&b'q'))
+    })
+}
+
+fn has_force_option(tokens: &[String]) -> bool {
+    tokens.iter().any(|token| {
+        token == "--force"
+            || token.starts_with("--force=")
+            || (token.starts_with('-')
+                && !token.starts_with("--")
+                && token.as_bytes()[1..].contains(&b'f'))
