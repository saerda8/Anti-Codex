+#[test]
+fn store_false_reads_parent_but_never_persists_child() {
+    let root = TempDir::new().unwrap();
+    let now = Arc::new(AtomicU64::new(20));
+    let history = store(&root, None, limits(8), now);
+    history
+        .persist_completed(&parent_request(), &parent_response())
+        .unwrap();
+
+    let mut child_request = json!({
+        "previous_response_id":"resp_parent",
+        "store":false,
+        "input":[{"type":"message","role":"user","content":"continue"}]
+    });
+    history
+        .hydrate_request(&mut child_request, MissingHistoryBehavior::Error)
+        .unwrap();
+    let child_response = json!({
+        "id":"resp_child",
+        "status":"completed",
+        "output":[{"type":"message","role":"assistant","content":"done"}]
+    });
+    assert_eq!(
+        history
+            .persist_completed(&child_request, &child_response)
+            .unwrap(),
+        PersistOutcome::SkippedStoreFalse
+    );
+    let mut lookup = json!({"previous_response_id":"resp_child","input":"again"});
+    assert!(matches!(
+        history.hydrate_request(&mut lookup, MissingHistoryBehavior::Error),
+        Err(ResponseHistoryError::Missing { .. })
+    ));
+}
+
+#[test]
+fn forked_tool_history_preserves_exact_order_and_opaque_content() {
+    let root = TempDir::new().unwrap();
+    let now = Arc::new(AtomicU64::new(30));
+    let history = store(&root, None, limits(8), now);
+    let request = json!({
+        "input":[{"type":"message","role":"user","content":"call it"}]
+    });
+    let response = json!({
+        "id":"resp_tool_parent",
+        "status":"completed",
+        "output":[
+            {"id":"rs_1","type":"reasoning","encrypted_content":"opaque"},
+            {"id":"fc_1","type":"function_call","call_id":"call_1","name":"lookup","arguments":"{\"x\":1}"}
+        ]
+    });
+    history.persist_completed(&request, &response).unwrap();
+
+    for suffix in ["a", "b"] {
+        let mut child = json!({
+            "previous_response_id":"resp_tool_parent",
+            "input":[
+                {"type":"function_call_output","call_id":"call_1","output":suffix},
+                {"type":"message","role":"user","content":"continue"}
+            ]
+        });
+        history
+            .hydrate_request(&mut child, MissingHistoryBehavior::Error)
+            .unwrap();
+        let items = child["input"].as_array().unwrap();
+        assert_eq!(
+            items
+                .iter()
+                .map(|item| item["type"].as_str().unwrap())
+                .collect::<Vec<_>>(),
+            [
+                "message",
+                "reasoning",
+                "function_call",
+                "function_call_output",
+                "message"
+            ]
+        );
+        assert_eq!(items[1]["encrypted_content"], "opaque");
+        assert_eq!(items[3]["output"], suffix);
+    }
+}
