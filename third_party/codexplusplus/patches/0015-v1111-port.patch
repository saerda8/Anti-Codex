+fn estimated_text_tokens(text: &str) -> u64 {
+    if text.starts_with("data:image/") && text.contains(";base64,") {
+        return 1_024;
+    }
+    let trimmed = text.trim();
+    if (trimmed.starts_with('{') || trimmed.starts_with('['))
+        && let Ok(value) = serde_json::from_str::<Value>(trimmed)
+    {
+        return estimated_json_tokens(&value);
+    }
+    (text.len() as u64).saturating_add(1) / 2
+}
+
+fn estimated_json_tokens(value: &Value) -> u64 {
+    match value {
+        Value::Null | Value::Bool(_) | Value::Number(_) => 1,
+        Value::String(text) => estimated_text_tokens(text),
+        Value::Array(values) => values
+            .iter()
+            .map(estimated_json_tokens)
+            .fold(0_u64, u64::saturating_add),
+        Value::Object(values) => {
+            let image_payload = values
+                .get("type")
+                .and_then(Value::as_str)
+                .is_some_and(|kind| kind.contains("image"))
+                || ["mime_type", "mimeType"]
+                    .into_iter()
+                    .filter_map(|key| values.get(key).and_then(Value::as_str))
+                    .any(|mime| mime.starts_with("image/"));
+            values.iter().fold(
+                if image_payload { 1_024_u64 } else { 0_u64 },
+                |total, (key, value)| {
+                    let value_tokens =
+                        if image_payload && matches!(key.as_str(), "data" | "image_url" | "url") {
+                            0
+                        } else {
+                            estimated_json_tokens(value)
+                        };
+                    total
+                        .saturating_add(estimated_text_tokens(key))
+                        .saturating_add(value_tokens)
+                },
+            )
+        }
+    }
+}
