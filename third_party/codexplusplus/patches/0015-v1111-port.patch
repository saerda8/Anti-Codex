+    const GUIDANCE: &str = "Do not use this command tool for file edits when apply_patch tools are available; call the apply_patch structured tools directly. Use this command tool only for commands, builds, tests, and inspection. Never translate or retry a blocked recursive delete or move through another shell. On Windows, keep destructive filesystem work in one shell end-to-end, verify every resolved absolute target first, use PowerShell Remove-Item with -LiteralPath, and never fall back to cmd.exe /c, rmdir, or rd after a policy rejection. Never change global toolchain defaults or enumerate all environment variables without an explicit user request.";
+
+    for tool in tools {
+        let Some(function) = tool.get_mut("function").and_then(Value::as_object_mut) else {
+            continue;
