diff --git a/crates/codex-plus-core/src/response_history.rs b/crates/codex-plus-core/src/response_history.rs
new file mode 100644
index 0000000..f4e58ec
--- /dev/null
+++ b/crates/codex-plus-core/src/response_history.rs
@@ -0,0 +1,716 @@
+use std::fs::{self, File, OpenOptions};
+use std::path::{Path, PathBuf};
+use std::sync::Arc;
+use std::time::{Duration, SystemTime, UNIX_EPOCH};
+
+use fs2::FileExt;
+use serde::{Deserialize, Serialize};
+use serde_json::{Map, Value, json};
+use sha2::{Digest, Sha256};
+use thiserror::Error;
+
+const HISTORY_SCHEMA: &str = "codex-plus-responses-history-v1";
+const HISTORY_DIRECTORY: &str = "responses-history-v1";
+const LOCK_FILE: &str = ".lock";
+const HASH_HEX_LEN: usize = 64;
+const MANAGED_FILE_NAME_LEN: usize = HASH_HEX_LEN + 1 + HASH_HEX_LEN + 5;
+
+pub const DEFAULT_MAX_ENTRIES: usize = 256;
+pub const DEFAULT_MAX_TOTAL_BYTES: u64 = 64 * 1024 * 1024;
+pub const DEFAULT_MAX_ENTRY_BYTES: u64 = 16 * 1024 * 1024;
+pub const DEFAULT_TTL: Duration = Duration::from_secs(30 * 24 * 60 * 60);
+
+#[derive(Debug, Clone, Copy)]
+pub struct ResponseHistoryLimits {
+    pub max_entries: usize,
+    pub max_total_bytes: u64,
+    pub max_entry_bytes: u64,
+    pub ttl: Duration,
+}
+
+impl Default for ResponseHistoryLimits {
+    fn default() -> Self {
+        Self {
+            max_entries: DEFAULT_MAX_ENTRIES,
+            max_total_bytes: DEFAULT_MAX_TOTAL_BYTES,
+            max_entry_bytes: DEFAULT_MAX_ENTRY_BYTES,
+            ttl: DEFAULT_TTL,
+        }
+    }
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct HydrationOutcome {
+    pub parent_id: Option<String>,
+    pub locally_resolved: bool,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum MissingHistoryBehavior {
+    Error,
+    Passthrough,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum PersistOutcome {
+    Saved,
+    AlreadyPresent,
+    SkippedStoreFalse,
+    SkippedNotCompleted,
+}
+
+#[derive(Debug, Error)]
+pub enum ResponseHistoryError {
+    #[error(
+        "Stored response history is unavailable for {previous_response_id:?}. Start a fresh request or reopen the original conversation context."
+    )]
+    Missing { previous_response_id: String },
+    #[error("Response history storage is unavailable: {reason}")]
+    Storage { reason: String },
+    #[error("Response history entry is invalid: {reason}")]
+    Invalid { reason: String },
+    #[error("Response history entry is corrupt: {reason}")]
+    Corrupt { reason: String },
+    #[error("Response history path is unsafe: {reason}")]
+    UnsafePath { reason: String },
+    #[error("Response history entry exceeds the {limit} byte limit ({actual} bytes).")]
+    EntryTooLarge { actual: u64, limit: u64 },
+    #[error("Response history capacity is exhausted: {reason}")]
+    Capacity { reason: String },
+    #[error("Response history ID collision for {response_id:?}.")]
+    Collision { response_id: String },
+}
+
+impl ResponseHistoryError {
+    pub fn http_status(&self) -> u16 {
+        match self {
+            Self::Missing { .. } => 410,
+            Self::Invalid { .. } => 400,
+            _ => 500,
+        }
+    }
+
+    pub fn response_body(&self) -> Value {
+        match self {
+            Self::Missing {
+                previous_response_id,
+            } => json!({
+                "error": {
+                    "type": "response_history_missing",
+                    "message": "Start a fresh request or reopen the original conversation context.",
+                    "details": {
+                        "status": 410,
+                        "retryable": false,
+                        "previous_response_id": previous_response_id,
+                    }
+                }
+            }),
+            _ => json!({
+                "error": {
+                    "type": "response_history_error",
+                    "message": "Response history storage failed.",
+                    "details": {
+                        "status": self.http_status(),
+                        "retryable": false,
+                    }
+                }
+            }),
+        }
+    }
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase")]
+struct StoredResponse {
+    schema: String,
+    scope_digest: String,
+    response_id: String,
+    created_at_ms: u64,
+    input: Vec<Value>,
+    output: Vec<Value>,
+}
+
+#[derive(Clone)]
+pub struct ResponseHistoryStore {
+    directory: PathBuf,
+    scope_digest: String,
+    limits: ResponseHistoryLimits,
+    now_ms: Arc<dyn Fn() -> u64 + Send + Sync>,
+}
+
+impl ResponseHistoryStore {
+    pub fn for_explicit_state(authorization: Option<&str>) -> Option<Self> {
+        crate::paths::configured_app_state_dir().map(|root| Self::new(root, authorization))
+    }
+
+    pub fn new(state_root: PathBuf, authorization: Option<&str>) -> Self {
+        Self::with_limits_and_clock(
+            state_root,
+            authorization,
+            ResponseHistoryLimits::default(),
+            Arc::new(system_now_ms),
+        )
+    }
+
+    pub fn with_limits_and_clock(
+        state_root: PathBuf,
+        authorization: Option<&str>,
+        limits: ResponseHistoryLimits,
+        now_ms: Arc<dyn Fn() -> u64 + Send + Sync>,
+    ) -> Self {
+        Self {
+            directory: state_root.join(HISTORY_DIRECTORY),
+            scope_digest: sha256_hex(&authorization_scope_material(authorization)),
+            limits,
+            now_ms,
+        }
+    }
+
+    pub fn hydrate_request(
+        &self,
+        request: &mut Value,
+        missing_behavior: MissingHistoryBehavior,
+    ) -> Result<HydrationOutcome, ResponseHistoryError> {
+        let Some(parent_value) = request.get("previous_response_id") else {
+            return Ok(HydrationOutcome {
+                parent_id: None,
+                locally_resolved: false,
+            });
+        };
+        if parent_value.is_null() {
+            return Ok(HydrationOutcome {
+                parent_id: None,
+                locally_resolved: false,
+            });
+        }
+        let parent_id = parent_value.as_str().unwrap_or_default().trim().to_string();
+        if parent_id.is_empty() {
+            return Err(ResponseHistoryError::Missing {
+                previous_response_id: parent_id,
+            });
+        }
+        let record = match self.load_record(&parent_id) {
+            Ok(record) => record,
+            Err(ResponseHistoryError::Missing { .. })
+                if missing_behavior == MissingHistoryBehavior::Passthrough =>
+            {
+                return Ok(HydrationOutcome {
+                    parent_id: Some(parent_id),
+                    locally_resolved: false,
+                });
+            }
+            Err(ResponseHistoryError::Corrupt { .. })
+            | Err(ResponseHistoryError::EntryTooLarge { .. }) => {
+                if missing_behavior == MissingHistoryBehavior::Passthrough {
+                    return Ok(HydrationOutcome {
+                        parent_id: Some(parent_id),
+                        locally_resolved: false,
+                    });
+                }
+                return Err(ResponseHistoryError::Missing {
+                    previous_response_id: parent_id,
+                });
+            }
+            Err(error) => return Err(error),
+        };
+
+        let mut stored_sequence = record.input;
+        stored_sequence.extend(record.output);
+        let current_input = request_input_items(request)?;
+        let effective_input = if normalized_prefix_matches(&stored_sequence, &current_input) {
+            current_input
+        } else {
+            stored_sequence.into_iter().chain(current_input).collect()
+        };
+        request["input"] = Value::Array(effective_input);
+        Ok(HydrationOutcome {
+            parent_id: Some(parent_id),
+            locally_resolved: true,
+        })
+    }
+
+    pub fn persist_completed(
+        &self,
+        effective_request: &Value,
+        response: &Value,
+    ) -> Result<PersistOutcome, ResponseHistoryError> {
+        if effective_request.get("store").and_then(Value::as_bool) == Some(false) {
+            return Ok(PersistOutcome::SkippedStoreFalse);
+        }
+        if response.get("status").and_then(Value::as_str) != Some("completed") {
+            return Ok(PersistOutcome::SkippedNotCompleted);
+        }
+        let response_id = response
+            .get("id")
+            .and_then(Value::as_str)
+            .map(str::trim)
+            .filter(|value| !value.is_empty())
+            .ok_or_else(|| ResponseHistoryError::Invalid {
+                reason: "completed response has no non-empty id".to_string(),
+            })?
+            .to_string();
+        let output = response
+            .get("output")
+            .and_then(Value::as_array)
+            .cloned()
+            .ok_or_else(|| ResponseHistoryError::Invalid {
+                reason: "completed response output is not an array".to_string(),
+            })?;
+        let record = StoredResponse {
+            schema: HISTORY_SCHEMA.to_string(),
+            scope_digest: self.scope_digest.clone(),
+            response_id,
+            created_at_ms: (self.now_ms)(),
+            input: request_input_items(effective_request)?,
+            output,
+        };
+        self.save_record(record)
+    }
+
+    pub fn committed_entry_count(&self) -> Result<usize, ResponseHistoryError> {
+        self.with_exclusive_lock(|_| {
+            let entries = self.scan_and_prune()?;
+            Ok(entries.len())
+        })
+    }
+
+    fn load_record(&self, response_id: &str) -> Result<StoredResponse, ResponseHistoryError> {
+        self.with_exclusive_lock(|_| {
+            let path = self.entry_path(response_id);
+            let record = match self.read_record(&path, response_id) {
+                Ok(record) => record,
+                Err(ResponseHistoryError::Missing { .. }) => {
+                    return Err(ResponseHistoryError::Missing {
+                        previous_response_id: response_id.to_string(),
+                    });
+                }
+                Err(error) => return Err(error),
+            };
+            if self.is_expired(&record) {
+                fs::remove_file(&path).map_err(storage_error)?;
+                return Err(ResponseHistoryError::Missing {
+                    previous_response_id: response_id.to_string(),
+                });
+            }
+            Ok(record)
+        })
+    }
+
+    fn save_record(&self, record: StoredResponse) -> Result<PersistOutcome, ResponseHistoryError> {
+        let bytes = serde_json::to_vec(&record).map_err(|error| ResponseHistoryError::Invalid {
+            reason: error.to_string(),
+        })?;
+        let actual = u64::try_from(bytes.len()).unwrap_or(u64::MAX);
+        if actual > self.limits.max_entry_bytes {
+            return Err(ResponseHistoryError::EntryTooLarge {
+                actual,
+                limit: self.limits.max_entry_bytes,
+            });
+        }
+        self.with_exclusive_lock(|_| {
+            let path = self.entry_path(&record.response_id);
+            if path.exists() {
+                let existing = self.read_record(&path, &record.response_id)?;
+                if self.is_expired(&existing) {
+                    fs::remove_file(&path).map_err(storage_error)?;
+                } else {
+                    if existing.scope_digest == record.scope_digest
+                        && existing.response_id == record.response_id
+                        && existing.input == record.input
+                        && existing.output == record.output
+                    {
+                        return Ok(PersistOutcome::AlreadyPresent);
+                    }
+                    return Err(ResponseHistoryError::Collision {
+                        response_id: record.response_id.clone(),
+                    });
+                }
+            }
+            let entries = self.scan_and_prune()?;
+            if entries.len() >= self.limits.max_entries {
+                return Err(ResponseHistoryError::Capacity {
+                    reason: format!("{} committed entries reached", self.limits.max_entries),
+                });
+            }
+            let total = entries
+                .iter()
+                .try_fold(0_u64, |sum, entry| sum.checked_add(entry.bytes))
+                .ok_or_else(|| ResponseHistoryError::Capacity {
+                    reason: "committed byte count overflowed".to_string(),
+                })?;
+            if total.saturating_add(actual) > self.limits.max_total_bytes {
+                return Err(ResponseHistoryError::Capacity {
+                    reason: format!(
+                        "{} byte total limit would be exceeded",
+                        self.limits.max_total_bytes
+                    ),
+                });
+            }
+            reject_symlink_or_irregular_if_present(&atomic_temp_path(&path), true)?;
+            crate::settings::atomic_write(&path, &bytes).map_err(storage_error)?;
+            Ok(PersistOutcome::Saved)
+        })
+    }
+
+    fn with_exclusive_lock<T>(
+        &self,
+        operation: impl FnOnce(&File) -> Result<T, ResponseHistoryError>,
+    ) -> Result<T, ResponseHistoryError> {
+        ensure_safe_directory(&self.directory)?;
+        let lock_path = self.directory.join(LOCK_FILE);
+        reject_symlink_or_irregular_if_present(&lock_path, true)?;
+        let lock = OpenOptions::new()
+            .read(true)
+            .write(true)
+            .create(true)
+            .truncate(false)
+            .open(&lock_path)
+            .map_err(storage_error)?;
+        reject_symlink_or_irregular_if_present(&lock_path, true)?;
+        FileExt::lock_exclusive(&lock).map_err(storage_error)?;
+        let result = operation(&lock);
+        let unlock = FileExt::unlock(&lock).map_err(storage_error);
+        match (result, unlock) {
+            (Ok(value), Ok(())) => Ok(value),
+            (Err(error), _) => Err(error),
+            (Ok(_), Err(error)) => Err(error),
+        }
+    }
+
+    fn scan_and_prune(&self) -> Result<Vec<CommittedEntry>, ResponseHistoryError> {
+        let mut committed = Vec::new();
+        for item in fs::read_dir(&self.directory).map_err(storage_error)? {
+            let item = item.map_err(storage_error)?;
+            let name = item.file_name();
+            let Some(name) = name.to_str() else {
+                continue;
+            };
+            if !is_managed_file_name(name) {
+                continue;
+            }
+            let path = item.path();
+            reject_symlink_or_irregular_if_present(&path, true)?;
+            let metadata = fs::metadata(&path).map_err(storage_error)?;
+            let bytes = metadata.len();
+            if bytes > self.limits.max_entry_bytes {
+                return Err(ResponseHistoryError::Corrupt {
+                    reason: "managed entry exceeds the configured single-entry limit".to_string(),
+                });
+            }
+            let record =
+                read_and_validate_record(&path, bytes, self.limits.max_entry_bytes, None, None)?;
+            if self.is_expired(&record) {
+                fs::remove_file(&path).map_err(storage_error)?;
+                continue;
+            }
+            committed.push(CommittedEntry { bytes });
+        }
+        Ok(committed)
+    }
+
+    fn read_record(
+        &self,
+        path: &Path,
+        response_id: &str,
+    ) -> Result<StoredResponse, ResponseHistoryError> {
+        match fs::symlink_metadata(path) {
+            Ok(_) => {}
+            Err(error) if error.kind() == std::io::ErrorKind::NotFound => {
+                return Err(ResponseHistoryError::Missing {
+                    previous_response_id: response_id.to_string(),
+                });
+            }
+            Err(error) => return Err(storage_error(error)),
+        }
+        reject_symlink_or_irregular_if_present(path, true)?;
+        let metadata = fs::metadata(path).map_err(storage_error)?;
+        read_and_validate_record(
+            path,
+            metadata.len(),
+            self.limits.max_entry_bytes,
+            Some(&self.scope_digest),
+            Some(response_id),
+        )
+    }
+
+    fn entry_path(&self, response_id: &str) -> PathBuf {
+        self.directory.join(format!(
+            "{}-{}.json",
+            self.scope_digest,
+            sha256_hex(response_id.as_bytes())
+        ))
+    }
+
+    fn is_expired(&self, record: &StoredResponse) -> bool {
+        let ttl_ms = u64::try_from(self.limits.ttl.as_millis()).unwrap_or(u64::MAX);
+        (self.now_ms)().saturating_sub(record.created_at_ms) >= ttl_ms
+    }
+}
+
+struct CommittedEntry {
+    bytes: u64,
+}
+
+fn system_now_ms() -> u64 {
+    SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .unwrap_or_default()
+        .as_millis()
+        .try_into()
+        .unwrap_or(u64::MAX)
+}
+
+fn authorization_scope_material(authorization: Option<&str>) -> Vec<u8> {
+    let Some(value) = authorization
+        .map(str::trim)
+        .filter(|value| !value.is_empty())
+    else {
+        return b"anonymous".to_vec();
+    };
+    let mut parts = value.split_whitespace();
+    let scheme = parts.next().unwrap_or_default();
+    let remainder = parts.collect::<Vec<_>>().join(" ");
+    if scheme.eq_ignore_ascii_case("bearer") && !remainder.is_empty() {
+        format!("bearer:{remainder}").into_bytes()
+    } else {
+        value.as_bytes().to_vec()
+    }
+}
+
+fn sha256_hex(value: &[u8]) -> String {
+    let digest = Sha256::digest(value);
+    digest.iter().map(|byte| format!("{byte:02x}")).collect()
+}
+
+fn ensure_safe_directory(path: &Path) -> Result<(), ResponseHistoryError> {
+    reject_symlink_or_irregular_if_present(path, false)?;
+    if !path.exists() {
+        fs::create_dir_all(path).map_err(storage_error)?;
+        reject_symlink_or_irregular_if_present(path, false)?;
+    }
+    Ok(())
+}
+
+fn reject_symlink_or_irregular_if_present(
+    path: &Path,
+    expect_file: bool,
+) -> Result<(), ResponseHistoryError> {
+    let metadata = match fs::symlink_metadata(path) {
+        Ok(metadata) => metadata,
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => return Ok(()),
+        Err(error) => return Err(storage_error(error)),
+    };
+    if metadata.file_type().is_symlink()
+        || (expect_file && !metadata.is_file())
+        || (!expect_file && !metadata.is_dir())
+    {
+        return Err(ResponseHistoryError::UnsafePath {
+            reason: "managed history path is a symlink or irregular filesystem entry".to_string(),
+        });
+    }
+    Ok(())
+}
+
+fn is_managed_file_name(name: &str) -> bool {
+    if name.len() != MANAGED_FILE_NAME_LEN || !name.ends_with(".json") {
+        return false;
+    }
+    let bytes = name.as_bytes();
+    bytes[HASH_HEX_LEN] == b'-'
+        && bytes[..HASH_HEX_LEN].iter().all(u8::is_ascii_hexdigit)
+        && bytes[HASH_HEX_LEN + 1..HASH_HEX_LEN + 1 + HASH_HEX_LEN]
+            .iter()
+            .all(u8::is_ascii_hexdigit)
+}
+
+fn atomic_temp_path(path: &Path) -> PathBuf {
+    let mut temp = path.to_path_buf();
+    match path.extension().and_then(|value| value.to_str()) {
+        Some(extension) => temp.set_extension(format!("{extension}.tmp")),
+        None => temp.set_extension("tmp"),
+    };
+    temp
+}
+
+fn read_and_validate_record(
+    path: &Path,
+    bytes: u64,
+    max_entry_bytes: u64,
+    expected_scope: Option<&str>,
+    expected_id: Option<&str>,
+) -> Result<StoredResponse, ResponseHistoryError> {
+    if bytes > max_entry_bytes {
+        return Err(ResponseHistoryError::EntryTooLarge {
+            actual: bytes,
+            limit: max_entry_bytes,
+        });
+    }
+    let contents = fs::read(path).map_err(storage_error)?;
+    let record: StoredResponse =
+        serde_json::from_slice(&contents).map_err(|_| ResponseHistoryError::Corrupt {
+            reason: "managed history entry is not valid JSON".to_string(),
+        })?;
+    if record.schema != HISTORY_SCHEMA
+        || record.response_id.trim().is_empty()
+        || record.scope_digest.len() != HASH_HEX_LEN
+        || !record
+            .scope_digest
+            .as_bytes()
+            .iter()
+            .all(u8::is_ascii_hexdigit)
+        || expected_scope.is_some_and(|scope| scope != record.scope_digest)
+        || expected_id.is_some_and(|id| id != record.response_id)
+    {
+        return Err(ResponseHistoryError::Corrupt {
+            reason: "managed history entry identity does not match its lookup scope".to_string(),
+        });
+    }
+    let expected_name = format!(
+        "{}-{}.json",
+        record.scope_digest,
+        sha256_hex(record.response_id.as_bytes())
+    );
+    if path.file_name().and_then(|value| value.to_str()) != Some(expected_name.as_str()) {
+        return Err(ResponseHistoryError::Corrupt {
+            reason: "managed history filename does not match its response identity".to_string(),
+        });
+    }
+    Ok(record)
+}
+
+fn storage_error(error: impl std::fmt::Display) -> ResponseHistoryError {
+    ResponseHistoryError::Storage {
+        reason: error.to_string(),
+    }
+}
+
+fn request_input_items(request: &Value) -> Result<Vec<Value>, ResponseHistoryError> {
+    match request.get("input") {
+        Some(Value::Array(items)) => Ok(items.clone()),
+        Some(Value::String(text)) => Ok(vec![json!({
+            "type": "message",
+            "role": "user",
+            "content": [{"type":"input_text","text":text}]
+        })]),
+        Some(Value::Object(_)) => Ok(vec![request["input"].clone()]),
+        Some(Value::Null) | None => Ok(Vec::new()),
+        Some(_) => Err(ResponseHistoryError::Invalid {
+            reason: "request input must be a string, object, or array".to_string(),
+        }),
+    }
+}
+
+fn normalized_prefix_matches(stored: &[Value], current: &[Value]) -> bool {
+    current.len() >= stored.len()
+        && stored
+            .iter()
+            .zip(current)
+            .all(|(left, right)| normalize_for_prefix(left) == normalize_for_prefix(right))
+}
+
+fn normalize_for_prefix(value: &Value) -> Value {
+    let Value::Object(object) = value else {
+        return value.clone();
+    };
+    let item_type = object.get("type").and_then(Value::as_str);
+    if object.get("role").and_then(Value::as_str).is_some() || item_type == Some("message") {
+        return normalize_message_item(object);
+    }
+    if item_type.is_some_and(is_known_responses_item_type) {
+        let mut normalized = object.clone();
+        normalized.remove("id");
+        normalized.remove("status");
+        return Value::Object(normalized);
+    }
+    value.clone()
+}
+
+fn normalize_message_item(object: &Map<String, Value>) -> Value {
+    let role = object.get("role").and_then(Value::as_str);
+    let mut normalized = Map::new();
+    for (key, value) in object {
+        if matches!(key.as_str(), "id" | "status") {
+            continue;
+        }
+        if key == "type" {
+            continue;
+        }
+        if key == "content" {
+            normalized.insert(
+                key.clone(),
+                normalize_message_content(value, role.unwrap_or_default()),
+            );
+            continue;
+        }
+        normalized.insert(key.clone(), value.clone());
+    }
+    normalized.insert("type".to_string(), Value::String("message".to_string()));
+    Value::Object(normalized)
+}
+
+fn normalize_message_content(value: &Value, role: &str) -> Value {
+    let default_type = if role.eq_ignore_ascii_case("assistant") {
+        "output_text"
+    } else {
+        "input_text"
+    };
+    let items = match value {
+        Value::String(text) => vec![json!({"type":default_type,"text":text})],
+        Value::Array(items) => items
+            .iter()
+            .map(|item| match item {
+                Value::String(text) => json!({"type":default_type,"text":text}),
+                Value::Object(object)
+                    if object
+                        .get("type")
+                        .and_then(Value::as_str)
+                        .is_none_or(is_text_content_type) =>
+                {
+                    let mut object = object.clone();
+                    object
+                        .entry("type".to_string())
+                        .or_insert_with(|| Value::String(default_type.to_string()));
+                    object.remove("id");
+                    object.remove("status");
+                    if object
+                        .get("annotations")
+                        .and_then(Value::as_array)
+                        .is_some_and(Vec::is_empty)
+                    {
+                        object.remove("annotations");
+                    }
+                    Value::Object(object)
+                }
+                _ => item.clone(),
+            })
+            .collect(),
+        other => vec![other.clone()],
+    };
+    Value::Array(items)
+}
+
+fn is_text_content_type(value: &str) -> bool {
+    matches!(value, "input_text" | "output_text" | "text")
+}
+
+fn is_known_responses_item_type(value: &str) -> bool {
+    matches!(
+        value,
+        "reasoning"
+            | "function_call"
+            | "function_call_output"
+            | "custom_tool_call"
+            | "custom_tool_call_output"
+            | "tool_search_call"
+            | "tool_search_output"
+            | "web_search_call"
+            | "computer_call"
+            | "computer_call_output"
+            | "local_shell_call"
+            | "local_shell_call_output"
+            | "mcp_call"
+            | "mcp_list_tools"
+            | "mcp_approval_request"
+            | "compaction"
+    )
+}
