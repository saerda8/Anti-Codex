+#[test]
+fn responses_input_preserves_mcp_image_tool_output_as_multimodal_content() {
+    let image_data = "QUJDREVGR0hJSktMTU5PUFFSU1RVVldYWVo=";
+    let expected_url = format!("data:image/png;base64,{image_data}");
+    let converted = responses_to_chat_completions(json!({
+        "model": "gpt-5.6-sol",
+        "input": [
+            {
+                "type": "function_call",
+                "call_id": "call_image",
+                "name": "view_image",
+                "arguments": "{\"path\":\"contact-sheet.png\"}"
+            },
+            {
+                "type": "function_call_output",
+                "call_id": "call_image",
+                "output": {
+                    "content": [
+                        { "type": "text", "text": "Contact sheet loaded." },
+                        { "type": "image", "data": image_data, "mimeType": "image/png" }
+                    ],
+                    "detail": "high"
+                }
+            }
+        ]
+    }))
+    .unwrap();
+
+    let tool_content = converted["messages"][1]["content"].as_str().unwrap();
+    assert!(!tool_content.contains(image_data));
+    let content = converted["messages"][2]["content"].as_array().unwrap();
+    assert_eq!(content[0]["type"], "text");
+    assert!(!content[0]["text"].as_str().unwrap().contains(image_data));
+    assert_eq!(content[1]["type"], "image_url");
+    assert_eq!(content[1]["image_url"]["url"], expected_url);
+}
