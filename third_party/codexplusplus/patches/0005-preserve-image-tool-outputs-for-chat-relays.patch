+const TOOL_IMAGE_PLACEHOLDER: &str = "[image output forwarded as image_url]";
+
+fn response_output_to_chat_content(value: &Value) -> Value {
+    let parsed = value.as_str().and_then(|text| {
+        let trimmed = text.trim();
+        if trimmed.starts_with('{') || trimmed.starts_with('[') {
+            serde_json::from_str::<Value>(trimmed).ok()
+        } else {
+            None
+        }
+    });
+    let source = parsed.as_ref().unwrap_or(value);
+    let mut image_urls = Vec::new();
+    let sanitized = sanitize_response_output_images(source, &mut image_urls);
+    if image_urls.is_empty() {
+        return Value::String(response_output_text(value));
+    }
+
+    let mut parts = Vec::with_capacity(image_urls.len() + 1);
+    let text = match sanitized {
+        Value::Null => String::new(),
+        Value::String(text) => text,
+        other => canonical_json_string(&other),
+    };
+    if !text.trim().is_empty() {
+        parts.push(json!({ "type": "text", "text": text }));
+    }
+    for image_url in image_urls {
+        parts.push(json!({
+            "type": "image_url",
+            "image_url": { "url": image_url }
+        }));
+    }
+    Value::Array(parts)
+}
+
+fn sanitize_response_output_images(value: &Value, image_urls: &mut Vec<String>) -> Value {
+    match value {
+        Value::Array(items) => Value::Array(
+            items
+                .iter()
+                .map(|item| sanitize_response_output_images(item, image_urls))
+                .collect(),
+        ),
+        Value::Object(object) => {
+            let image_kind = object.get("type").and_then(Value::as_str).unwrap_or("");
+            let image_url = match image_kind {
+                "image" => object
+                    .get("data")
+                    .and_then(Value::as_str)
+                    .filter(|data| !data.is_empty())
+                    .map(|data| {
+                        if data.starts_with("data:image/") {
+                            data.to_string()
+                        } else {
+                            let mime_type = object
+                                .get("mimeType")
+                                .or_else(|| object.get("mime_type"))
+                                .and_then(Value::as_str)
+                                .filter(|mime| mime.starts_with("image/"))
+                                .unwrap_or("image/png");
+                            format!("data:{mime_type};base64,{data}")
+                        }
+                    }),
+                "input_image" | "image_url" => {
+                    object.get("image_url").and_then(response_output_image_url)
+                }
+                _ => object.get("image_url").and_then(response_output_image_url),
+            };
+
+            if let Some(image_url) = image_url.filter(|url| !url.is_empty()) {
+                if !image_urls.contains(&image_url) {
+                    image_urls.push(image_url);
+                }
+                let mut sanitized = object.clone();
+                if image_kind == "image" {
+                    sanitized.insert("data".to_string(), json!(TOOL_IMAGE_PLACEHOLDER));
+                } else {
+                    sanitized.insert("image_url".to_string(), json!(TOOL_IMAGE_PLACEHOLDER));
+                }
+                for (key, item) in object {
+                    if key == "data" || key == "image_url" {
+                        continue;
+                    }
+                    sanitized.insert(
+                        key.clone(),
+                        sanitize_response_output_images(item, image_urls),
+                    );
+                }
+                return Value::Object(sanitized);
+            }
+
+            Value::Object(
+                object
+                    .iter()
+                    .map(|(key, item)| {
+                        (
+                            key.clone(),
+                            sanitize_response_output_images(item, image_urls),
+                        )
+                    })
+                    .collect(),
+            )
+        }
+        Value::String(text) if response_output_image_url(value).is_some() => {
+            let image_url = text.to_string();
+            if !image_urls.contains(&image_url) {
+                image_urls.push(image_url);
+            }
+            json!(TOOL_IMAGE_PLACEHOLDER)
+        }
+        _ => value.clone(),
+    }
+}
+
+fn response_output_image_url(value: &Value) -> Option<String> {
+    match value {
+        Value::String(url)
+            if url.starts_with("data:image/")
+                || url.starts_with("https://")
+                || url.starts_with("http://") =>
+        {
+            Some(url.clone())
+        }
+        Value::Object(object) => object.get("url").and_then(response_output_image_url),
+        _ => None,
+    }
+}
