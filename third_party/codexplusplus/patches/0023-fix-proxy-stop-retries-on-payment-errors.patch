+pub fn responses_terminal_failure_sse_from_upstream(
+    request: Option<&Value>,
+    status_code: u16,
+    content_type: &str,
+    body: &[u8],
+) -> Option<Vec<u8>> {
+    if status_code != 402
+        || request
+            .and_then(|value| value.get("stream"))
+            .and_then(Value::as_bool)
+            != Some(true)
+    {
+        return None;
+    }
+
+    let envelope = responses_error_from_upstream(status_code, content_type, body);
+    let message = envelope
+        .pointer("/error/message")
+        .and_then(Value::as_str)
+        .filter(|value| !value.trim().is_empty())
+        .unwrap_or("Payment required")
+        .to_string();
+    let mut converter = request
+        .map(ChatSseToResponsesConverter::with_request)
+        .unwrap_or_default();
+    Some(converter.fail_with_code(message, "insufficient_quota".to_string()))
+}
