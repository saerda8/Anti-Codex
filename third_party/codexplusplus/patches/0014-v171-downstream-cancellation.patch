+    struct CancellationSettingsRestore(Option<PathBuf>);
+
+    impl Drop for CancellationSettingsRestore {
+        fn drop(&mut self) {
+            crate::paths::set_settings_path_for_tests(self.0.take());
+        }
+    }
+
+    fn install_cancellation_relay(settings_path: &Path, upstream_addr: SocketAddr) {
+        let settings = serde_json::json!({
+            "relayProfilesEnabled": true,
+            "relayProfiles": [{
+                "id": "cancellation-fixture",
+                "name": "Cancellation Fixture",
+                "baseUrl": format!("http://{upstream_addr}/v1"),
+                "upstreamBaseUrl": format!("http://{upstream_addr}/v1"),
+                "apiKey": "fixture-key",
+                "protocol": "responses",
+                "relayMode": "pureApi"
+            }],
+            "activeRelayId": "cancellation-fixture"
+        });
+        std::fs::write(settings_path, serde_json::to_vec_pretty(&settings).unwrap()).unwrap();
+    }
+
+    async fn cancellation_helper_client(
+        streaming: bool,
+    ) -> (tokio::net::TcpStream, tokio::task::JoinHandle<()>) {
+        let listener = tokio::net::TcpListener::bind(("127.0.0.1", 0))
+            .await
+            .unwrap();
+        let address = listener.local_addr().unwrap();
+        let helper = tokio::spawn(async move {
+            let (stream, remote_addr) = listener.accept().await.unwrap();
+            handle_helper_connection(stream, Some(remote_addr))
+                .await
+                .unwrap();
+        });
+        let mut client = tokio::net::TcpStream::connect(address).await.unwrap();
+        let body = serde_json::to_vec(&serde_json::json!({
+            "model": "fixture-model",
+            "input": "probe",
+            "stream": streaming
+        }))
+        .unwrap();
+        let headers = format!(
+            "POST /v1/responses HTTP/1.1\r\nHost: {address}\r\nContent-Type: application/json\r\nContent-Length: {}\r\nConnection: close\r\n\r\n",
+            body.len()
+        );
+        client.write_all(headers.as_bytes()).await.unwrap();
+        client.write_all(&body).await.unwrap();
+        (client, helper)
+    }
+
+    async fn wait_for_helper_response_headers(client: &mut tokio::net::TcpStream) {
+        let mut response = Vec::new();
+        let mut byte = [0_u8; 1];
+        while !response.ends_with(b"\r\n\r\n") {
+            let read = client.read(&mut byte).await.unwrap();
+            assert!(read > 0, "helper closed before writing response headers");
+            response.extend_from_slice(&byte[..read]);
+        }
+        assert!(String::from_utf8_lossy(&response).starts_with("HTTP/1.1 200 OK"));
+    }
+
+    async fn wait_for_cancelled_tasks(
+        helper: tokio::task::JoinHandle<()>,
+        upstream: tokio::task::JoinHandle<usize>,
+    ) {
+        tokio::time::timeout(std::time::Duration::from_secs(2), helper)
+            .await
+            .expect("helper must stop promptly after downstream disconnect")
+            .unwrap();
+        let upstream_read = tokio::time::timeout(std::time::Duration::from_secs(2), upstream)
+            .await
+            .expect("dropping the upstream future must release its socket")
+            .unwrap();
+        assert_eq!(upstream_read, 0, "upstream socket must observe EOF");
+    }
+
