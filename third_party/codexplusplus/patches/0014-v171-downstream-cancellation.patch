+async fn wait_for_downstream_disconnect<R>(reader: &mut R)
+where
+    R: tokio::io::AsyncRead + Unpin,
+{
+    let mut probe = [0_u8; 1];
+    loop {
+        match reader.read(&mut probe).await {
+            Ok(0) | Err(_) => return,
+            Ok(_) => {}
+        }
+    }
+}
+
+async fn await_upstream_or_downstream_disconnect<R, F>(
+    downstream_reader: &mut R,
+    upstream_future: F,
+) -> Option<F::Output>
+where
+    R: tokio::io::AsyncRead + Unpin,
+    F: Future,
+{
+    tokio::select! {
+        output = upstream_future => Some(output),
+        _ = wait_for_downstream_disconnect(downstream_reader) => None,
+    }
+}
