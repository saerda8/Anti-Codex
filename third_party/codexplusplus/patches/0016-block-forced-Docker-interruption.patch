From 185987d71c8e47272ed63e3da2d573cf9bc40fdb Mon Sep 17 00:00:00 2001
From: Anti-Codex Diagnostic <anticodex@example.invalid>
Date: Fri, 14 Aug 2026 13:05:39 +0800
Subject: [PATCH] block forced Docker interruption

---
 crates/codex-plus-core/src/protocol_proxy.rs  | 32 ++++++++++++++++++-
 .../codex-plus-core/tests/protocol_proxy.rs   | 11 +++++++
 2 files changed, 42 insertions(+), 1 deletion(-)

diff --git a/crates/codex-plus-core/src/protocol_proxy.rs b/crates/codex-plus-core/src/protocol_proxy.rs
index 1e95a68..507b7f6 100644
--- a/crates/codex-plus-core/src/protocol_proxy.rs
+++ b/crates/codex-plus-core/src/protocol_proxy.rs
@@ -4765,6 +4765,16 @@ fn command_policy_violation(command: &str) -> Option<&'static str> {
                             "docker run/create container name and ownership label must identify the same current task; use --name anticodex-<current task id>",
                         );
                     }
+                    if matches!(nested, "kill" | "stop" | "restart")
+                        || (nested == "rm" && has_force_option(nested_arguments))
+                    {
+                        return Some(
+                            "stopping or force-removing a Docker container is forbidden; wait for it to exit",
+                        );
+                    }
+                    if nested == "rm" {
+                        has_container_mutation = true;
+                    }
                     if nested == "ls" && has_quiet_option(nested_arguments) {
                         has_quiet_container_list = true;
                     }
@@ -4775,7 +4785,17 @@ fn command_policy_violation(command: &str) -> Option<&'static str> {
                     return Some("global Docker cleanup is forbidden");
                 }
                 "ps" if has_quiet_option(arguments) => has_quiet_container_list = true,
-                "kill" | "stop" | "rm" => has_container_mutation = true,
+                "kill" | "stop" | "restart" => {
+                    return Some(
+                        "stopping or force-removing a Docker container is forbidden; wait for it to exit",
+                    );
+                }
+                "rm" if has_force_option(arguments) => {
+                    return Some(
+                        "stopping or force-removing a Docker container is forbidden; wait for it to exit",
+                    );
+                }
+                "rm" => has_container_mutation = true,
                 _ => {}
             }
         }
@@ -5087,6 +5107,16 @@ fn has_quiet_option(tokens: &[String]) -> bool {
     })
 }
 
+fn has_force_option(tokens: &[String]) -> bool {
+    tokens.iter().any(|token| {
+        token == "--force"
+            || token.starts_with("--force=")
+            || (token.starts_with('-')
+                && !token.starts_with("--")
+                && token.as_bytes()[1..].contains(&b'f'))
+    })
+}
+
 fn request_has_apply_patch_tool(tools: Option<&Value>) -> bool {
     tools.and_then(Value::as_array).is_some_and(|tools| {
         tools.iter().any(|tool| {
diff --git a/crates/codex-plus-core/tests/protocol_proxy.rs b/crates/codex-plus-core/tests/protocol_proxy.rs
index d78592b..3908ee7 100644
--- a/crates/codex-plus-core/tests/protocol_proxy.rs
+++ b/crates/codex-plus-core/tests/protocol_proxy.rs
@@ -2223,6 +2223,9 @@ fn chat_completion_response_command_policy_enforces_safety_when_apply_patch_is_a
         "docker container prune -f",
         "docker ps --quiet | ForEach-Object { docker stop $_ }",
         "docker run --name cv_test --label com.anticodex.task-id=not-a-task alpine",
+        "docker stop cv_check",
+        "docker rm -f cv_check cv_test_final",
+        "docker container rm --force cv_check",
         r#"[System.IO.File]::WriteAllText(\"src/main.rs\", \"unsafe\")"#,
     ] {
         let arguments = convert_arguments(blocked);
@@ -2234,6 +2237,14 @@ fn chat_completion_response_command_policy_enforces_safety_when_apply_patch_is_a
     let allowed = "docker run --rm --name anticodex-019ffc57-6a72-7f81-8ce8-8796485ca06d --label com.anticodex.task-id=019ffc57-6a72-7f81-8ce8-8796485ca06d alpine echo ok";
     assert_eq!(convert_arguments(allowed)["command"], allowed);
     assert_eq!(convert_arguments("cargo test")["command"], "cargo test");
+    assert_eq!(
+        convert_arguments("docker wait cv_check")["command"],
+        "docker wait cv_check"
+    );
+    assert_eq!(
+        convert_arguments("docker rm cv_check")["command"],
+        "docker rm cv_check"
+    );
 }
 
 #[test]
