+#[test]
+fn native_codex_title_helper_drops_project_tools() {
+    let prompt = concat!(
+        "You are a helpful assistant. You will be presented with a user prompt, and your job is to provide a short title for a task that will be created from that prompt.\n\n",
+        "Generate a concise UI title (up to 36 characters) for this task.\n",
+        "Fill the structured title field with plain text.\n",
+        "Fill the structured description field with a compact, search-oriented summary (up to 100 characters).\n",
+        "Do NOT respond to the user, answer questions, or attempt to solve the problem; just write a title.\n",
+        "User prompt: build the project"
+    );
+    let converted = responses_to_chat_completions(json!({
+        "model": "gpt-5.6-terra",
+        "input": [
+            {
+                "type": "message",
+                "role": "user",
+                "content": [{ "type": "input_text", "text": "older user history" }]
+            },
+            {
+                "type": "message",
+                "role": "user",
+                "content": [{ "type": "input_text", "text": prompt }]
+            }
+        ],
+        "tools": [{
+            "type": "function",
+            "name": "shell_command",
+            "description": "Run a command",
+            "parameters": { "type": "object" }
+        }],
+        "tool_choice": "required",
+        "parallel_tool_calls": true
+    }))
+    .unwrap();
+
+    assert!(converted.get("tools").is_none());
+    assert!(converted.get("tool_choice").is_none());
+    assert!(converted.get("parallel_tool_calls").is_none());
+    assert_eq!(converted["messages"].as_array().unwrap().len(), 2);
+    assert_eq!(converted["messages"][0]["content"], "older user history");
+    assert_eq!(converted["messages"][1]["content"], prompt);
+}
+
+#[test]
+fn native_codex_task_suggestions_helper_drops_project_tools() {
+    let prompt = concat!(
+        "# Overview\n\nGenerate 0 to 3 hyperpersonalized suggestions for what this user can do with Codex in this local project:\n\n",
+        "Return 0 to 3 fresh suggestions.\n",
+        "# Response format\n",
+        "Each suggestion must include:\n",
+        "- prompt: the user message to send\n",
+        "- appId: the single most relevant app id\n",
+        "- write the prompt as something that should launch as a new Codex task in this project"
+    );
+    let converted = responses_to_chat_completions(json!({
+        "model": "gpt-5.6-terra",
+        "input": [{
+            "type": "message",
+            "role": "user",
+            "content": [{ "type": "input_text", "text": prompt }]
+        }],
+        "tools": [{
+            "type": "function",
+            "name": "shell_command",
+            "description": "Run a command",
+            "parameters": { "type": "object" }
+        }],
+        "tool_choice": "required",
+        "parallel_tool_calls": true
+    }))
+    .unwrap();
+
+    assert!(converted.get("tools").is_none());
+    assert!(converted.get("tool_choice").is_none());
+    assert!(converted.get("parallel_tool_calls").is_none());
+    assert_eq!(converted["messages"][0]["content"], prompt);
+}
