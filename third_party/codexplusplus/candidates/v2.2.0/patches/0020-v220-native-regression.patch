+fn local_proxy_bearer_token() -> anyhow::Result<String> {
+    let config_path = crate::relay_config::default_codex_home_dir().join("config.toml");
+    let config = std::fs::read_to_string(config_path).context("local proxy config unavailable")?;
+    crate::relay_config::active_provider_string_from_config(&config, "experimental_bearer_token")
+        .ok_or_else(|| anyhow::anyhow!("local proxy bearer token is missing"))
+}
+
+fn authorize_local_proxy_request(headers: &str, expected_token: &str) -> Result<(), &'static str> {
+    if expected_token.trim().is_empty() {
+        return Err("403 Forbidden");
+    }
+    let Some(authorization) = header_value_from_headers(headers, "authorization") else {
+        return Err("401 Unauthorized");
+    };
+    let Some((scheme, token)) = authorization.split_once(' ') else {
+        return Err("403 Forbidden");
+    };
+    let token = token.trim();
+    if !scheme.eq_ignore_ascii_case("bearer")
+        || token.len() != expected_token.len()
+        || token
+            .as_bytes()
+            .iter()
+            .zip(expected_token.as_bytes())
+            .fold(0u8, |diff, (a, b)| diff | (a ^ b))
+            != 0
+    {
+        return Err("403 Forbidden");
+    }
+    Ok(())
+}
