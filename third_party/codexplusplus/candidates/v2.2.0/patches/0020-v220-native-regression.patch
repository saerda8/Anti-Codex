+#[derive(Default)]
+struct ChatSseDoneMarker {
+    line: Vec<u8>,
+    overflow: bool,
+    done: bool,
+}
+
+impl ChatSseDoneMarker {
+    fn observe(&mut self, bytes: &[u8]) {
+        for &byte in bytes {
+            if byte == b'\n' {
+                if !self.overflow {
+                    self.done |= std::str::from_utf8(&self.line)
+                        .ok()
+                        .and_then(|line| line.trim_end_matches('\r').strip_prefix("data:"))
+                        .is_some_and(|value| value.trim() == "[DONE]");
+                }
+                self.line.clear();
+                self.overflow = false;
+            } else if self.line.len() < 64 {
+                self.line.push(byte);
+            } else {
+                self.overflow = true;
+            }
+        }
+    }
+}
