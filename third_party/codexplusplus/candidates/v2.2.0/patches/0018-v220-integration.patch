+pub(crate) fn is_docker_token(token: &str) -> bool {
+    token == "docker"
+        || token == "docker.exe"
+        || token.ends_with("/docker")
+        || token.ends_with("\\docker.exe")
+}
+
+pub(crate) fn docker_subcommand(tokens: &[String], docker_index: usize) -> Option<(usize, &str)> {
+    let mut index = docker_index + 1;
+    while index < tokens.len() {
+        let token = tokens[index].as_str();
+        if docker_global_option_takes_value(token) {
+            index += 2;
+        } else if token.starts_with('-') {
+            index += 1;
+        } else {
+            return Some((index, token));
+        }
+    }
+    None
+}
+
+pub(crate) fn docker_global_option_takes_value(option: &str) -> bool {
+    matches!(
+        option,
+        "--config"
+            | "--context"
+            | "--host"
+            | "-h"
+            | "--log-level"
+            | "--tlscacert"
+            | "--tlscert"
+            | "--tlskey"
+    )
+}
+
+pub(crate) fn first_non_option(tokens: &[String]) -> Option<(usize, &str)> {
+    tokens
+        .iter()
+        .enumerate()
+        .find(|(_, token)| !token.starts_with('-'))
+        .map(|(index, token)| (index, token.as_str()))
+}
+
+pub(crate) fn option_value<'a>(tokens: &'a [String], option: &str) -> Option<&'a str> {
+    let prefix = format!("{option}=");
+    tokens.iter().enumerate().find_map(|(index, token)| {
+        let token = token.trim_matches(['\'', '"']);
+        let value = token.strip_prefix(&prefix).or_else(|| {
+            (token == option).then(|| tokens.get(index + 1).map_or("", String::as_str))
+        })?;
+        let value = value.trim_matches(['\'', '"']);
+        (!value.is_empty() && !value.starts_with('-')).then_some(value)
+    })
+}
+
+pub(crate) fn task_ownership_id(tokens: &[String]) -> Option<&str> {
+    tokens.iter().enumerate().find_map(|(index, token)| {
+        let token = token.trim_matches(['\'', '"']);
+        let value = token.strip_prefix("--label=").or_else(|| {
+            (token == "--label").then(|| tokens.get(index + 1).map_or("", String::as_str))
+        })?;
+        let task_id = value
+            .trim_matches(['\'', '"'])
+            .strip_prefix("com.anticodex.task-id=")?;
+        is_task_id(task_id).then_some(task_id)
+    })
+}
+
+pub(crate) fn task_container_name_matches_label(tokens: &[String]) -> bool {
+    let Some(name) = option_value(tokens, "--name") else {
+        return false;
+    };
+    task_ownership_id(tokens).is_some_and(|task_id| name == format!("anticodex-{task_id}"))
+}
+
+pub(crate) fn is_task_id(task_id: &str) -> bool {
+    let task_id = task_id.trim_matches(['\'', '"']);
+    task_id.len() == 36
+        && task_id.bytes().enumerate().all(|(index, byte)| {
+            if matches!(index, 8 | 13 | 18 | 23) {
+                byte == b'-'
+            } else {
+                byte.is_ascii_hexdigit()
+            }
+        })
+}
+
+pub(crate) fn has_quiet_option(tokens: &[String]) -> bool {
+    tokens.iter().any(|token| {
+        token == "--quiet"
+            || token == "-q"
+            || (token.starts_with('-')
+                && !token.starts_with("--")
+                && token.as_bytes()[1..].contains(&b'q'))
+    })
+}
+
+pub(crate) fn has_force_option(tokens: &[String]) -> bool {
+    tokens.iter().any(|token| {
+        token == "--force"
+            || token.starts_with("--force=")
+            || (token.starts_with('-')
+                && !token.starts_with("--")
+                && token.as_bytes()[1..].contains(&b'f'))
+    })
+}
