+pub(crate) fn metadata_marks_codex_compaction(metadata: &Value) -> bool {
+    metadata.get("request_kind").and_then(Value::as_str) == Some(CODEX_COMPACTION_REQUEST_KIND)
+}
+
+pub(crate) fn serialized_metadata_marks_codex_compaction(serialized: &str) -> bool {
+    serde_json::from_str::<Value>(serialized)
+        .ok()
+        .as_ref()
+        .is_some_and(metadata_marks_codex_compaction)
+}
+
+pub(crate) fn request_is_codex_compaction(
+    request_json: &Value,
+    turn_metadata: Option<&str>,
+) -> bool {
+    if turn_metadata.is_some_and(serialized_metadata_marks_codex_compaction) {
+        return true;
+    }
+    let Some(metadata) = request_json
+        .get("client_metadata")
+        .and_then(Value::as_object)
+        .and_then(|items| items.get(CODEX_TURN_METADATA_KEY))
+    else {
+        return false;
+    };
+    match metadata {
+        Value::String(serialized) => serialized_metadata_marks_codex_compaction(serialized),
+        Value::Object(_) => metadata_marks_codex_compaction(metadata),
+        _ => false,
+    }
+}
+
+pub(crate) fn codex_turn_metadata_value(
+    request_json: &Value,
+    turn_metadata: Option<&str>,
+) -> Option<Value> {
+    if let Some(metadata) = turn_metadata.and_then(|value| serde_json::from_str(value).ok()) {
+        return Some(metadata);
+    }
+    let metadata = request_json
+        .get("client_metadata")
+        .and_then(Value::as_object)
+        .and_then(|items| items.get(CODEX_TURN_METADATA_KEY))?;
+    match metadata {
+        Value::String(serialized) => serde_json::from_str(serialized).ok(),
+        Value::Object(_) => Some(metadata.clone()),
+        _ => None,
+    }
+}
+
+pub(crate) fn codex_compaction_thread_id(
+    request_json: &Value,
+    turn_metadata: Option<&str>,
+) -> Option<String> {
+    let metadata = codex_turn_metadata_value(request_json, turn_metadata)?;
+    if !metadata_marks_codex_compaction(&metadata) {
+        return None;
+    }
+    metadata
+        .get("thread_id")
+        .or_else(|| metadata.get("session_id"))
+        .and_then(Value::as_str)
+        .and_then(|value| uuid::Uuid::parse_str(value).ok())
+        .map(|value| value.to_string())
+}
+
+fn thread_rollout_filename_matches(filename: &str, thread_id: &str) -> bool {
+    let Ok(thread) = uuid::Uuid::parse_str(thread_id) else {
+        return false;
+    };
+    let Some(stem) = filename.strip_suffix(".jsonl") else {
+        return false;
+    };
+    let suffix = format!("-{thread}");
+    let matches_thread = |value: &str| {
+        value
+            .get(value.len().saturating_sub(suffix.len())..)
+            .is_some_and(|tail| tail.eq_ignore_ascii_case(&suffix))
+    };
+    if matches_thread(stem) {
+        return true;
+    }
+    let Some((thread_stem, turn)) = stem.rsplit_once('_') else {
+        return false;
+    };
+    matches_thread(thread_stem)
+        && uuid::Uuid::parse_str(turn)
+            .ok()
+            .is_some_and(|id| turn.eq_ignore_ascii_case(&id.to_string()))
+}
