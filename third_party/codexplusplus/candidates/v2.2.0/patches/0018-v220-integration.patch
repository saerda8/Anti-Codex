+pub(crate) fn git_worktree_mutation(command: &str) -> bool {
+    command_segments(command).iter().any(|segment| {
+        segment
+            .iter()
+            .enumerate()
+            .filter_map(|(index, token)| is_git_token(token).then_some(index))
+            .any(|git_index| {
+                let Some((subcommand_index, subcommand)) = git_subcommand(segment, git_index)
+                else {
+                    return false;
+                };
+                if subcommand == "apply" {
+                    let arguments = &segment[subcommand_index + 1..];
+                    let explicitly_applies = arguments.iter().any(|argument| argument == "--apply");
+                    let read_only = arguments.iter().any(|argument| {
+                        matches!(
+                            argument.as_str(),
+                            "--check" | "--stat" | "--numstat" | "--summary"
+                        )
+                    });
+                    return explicitly_applies || !read_only;
+                }
+                matches!(
+                    subcommand,
+                    "am" | "checkout"
+                        | "checkout-index"
+                        | "cherry-pick"
+                        | "clean"
+                        | "merge"
+                        | "mv"
+                        | "rebase"
+                        | "reset"
+                        | "restore"
+                        | "revert"
+                        | "rm"
+                        | "stash"
+                        | "switch"
+                )
+            })
+    })
+}
