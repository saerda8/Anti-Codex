+
+pub fn isolated_instance_mode() -> bool {
+    isolation_requested_from(
+        std::env::var_os("ANTICODEX_ISOLATED_INSTANCE").as_deref(),
+        std::env::var_os("CODEX_PLUS_APP_EXECUTABLE").as_deref(),
+        std::env::var_os(STATE_DIR_ENV).as_deref(),
+        std::env::var_os("CODEX_PLUS_MULTI_INSTANCE").as_deref(),
+    )
+    .unwrap_or(true)
+}
+
+fn isolation_requested_from(
+    product: Option<&std::ffi::OsStr>,
+    executable: Option<&std::ffi::OsStr>,
+    state: Option<&std::ffi::OsStr>,
+    multi: Option<&std::ffi::OsStr>,
+) -> anyhow::Result<bool> {
+    if let Some(value) = product {
+        anyhow::ensure!(
+            value == std::ffi::OsStr::new("1"),
+            "ANTICODEX_ISOLATED_INSTANCE must be 1"
+        );
+    }
+    if let Some(value) = state {
+        anyhow::ensure!(
+            explicit_app_state_dir(Some(value.to_os_string())).is_some(),
+            "CODEX_PLUS_STATE_DIR must be a non-empty absolute path"
+        );
+    }
+    let requested = product.is_some()
+        || executable.is_some()
+        || (state.is_some() && multi != Some(std::ffi::OsStr::new("1")));
+    anyhow::ensure!(
+        !requested || state.is_some(),
+        "CODEX_PLUS_STATE_DIR is required for an isolated instance"
+    );
+    Ok(requested)
+}
+
+pub fn validate_isolated_environment() -> anyhow::Result<bool> {
+    let state = std::env::var_os(STATE_DIR_ENV);
+    let requested = isolation_requested_from(
+        std::env::var_os("ANTICODEX_ISOLATED_INSTANCE").as_deref(),
+        std::env::var_os("CODEX_PLUS_APP_EXECUTABLE").as_deref(),
+        state.as_deref(),
+        std::env::var_os("CODEX_PLUS_MULTI_INSTANCE").as_deref(),
+    )?;
+    if !requested {
+        return Ok(false);
+    }
+    validate_protocol_proxy_port_value(
+        true,
+        std::env::var_os("CODEX_PLUS_PROTOCOL_PROXY_PORT").as_deref(),
+        false,
+    )?;
+    let home = std::env::var_os("CODEX_HOME");
+    let sqlite = std::env::var_os("CODEX_SQLITE_HOME");
+    let user = directories::BaseDirs::new()
+        .ok_or_else(|| anyhow::anyhow!("cannot locate the user home for isolation validation"))?;
+    validate_isolation_values(
+        state.as_deref(),
+        home.as_deref(),
+        sqlite.as_deref(),
+        user.home_dir(),
+    )
+}
+
+/// Require a managed proxy port only in isolated modes that actually use it.
+pub fn validate_isolated_protocol_proxy_port(required: bool) -> anyhow::Result<()> {
+    validate_protocol_proxy_port_value(
+        validate_isolated_environment()?,
+        std::env::var_os("CODEX_PLUS_PROTOCOL_PROXY_PORT").as_deref(),
+        required,
+    )
+}
+
+fn validate_protocol_proxy_port_value(
+    isolated: bool,
+    value: Option<&std::ffi::OsStr>,
+    required: bool,
+) -> anyhow::Result<()> {
+    if !isolated || (value.is_none() && !required) {
+        return Ok(());
+    }
+    anyhow::ensure!(
+        value
+            .and_then(std::ffi::OsStr::to_str)
+            .and_then(|value| value.trim().parse::<u16>().ok())
+            .is_some_and(|port| port != 0),
+        "CODEX_PLUS_PROTOCOL_PROXY_PORT must be an explicitly configured nonzero port"
+    );
+    Ok(())
+}
+
+fn validate_isolation_values(
+    state: Option<&std::ffi::OsStr>,
+    home: Option<&std::ffi::OsStr>,
+    sqlite: Option<&std::ffi::OsStr>,
+    user: &Path,
+) -> anyhow::Result<bool> {
+    let Some(state) = state else { return Ok(false) };
+    let home =
+        home.ok_or_else(|| anyhow::anyhow!("CODEX_HOME is required for an isolated instance"))?;
+    let official = isolation_comparison_path(&user.join(".codex"))?;
+    let default_state = isolation_comparison_path(&user.join(APP_STATE_DIR))?;
+    for value in [Some(state), Some(home), sqlite].into_iter().flatten() {
+        let path = Path::new(value);
+        anyhow::ensure!(
+            !path.as_os_str().is_empty()
+                && path.is_absolute()
+                && !path
+                    .components()
+                    .any(|part| matches!(part, std::path::Component::ParentDir)),
+            "isolated state and home paths must be absolute and contain no parent traversal"
+        );
+        reject_isolation_links(path)?;
+        let path = isolation_comparison_path(path)?;
+        anyhow::ensure!(
+            !isolation_path_is_within(&path, &official)
+                && !isolation_path_is_within(&path, &default_state),
+            "isolated state or home path points into an official user directory"
+        );
+    }
+    Ok(true)
+}
+
+fn reject_isolation_links(path: &Path) -> anyhow::Result<()> {
+    let mut current = PathBuf::new();
+    for part in path.components() {
+        current.push(part.as_os_str());
+        if matches!(
+            part,
+            std::path::Component::Prefix(_) | std::path::Component::RootDir
+        ) {
+            continue;
+        }
+        let metadata = match fs::symlink_metadata(&current) {
+            Ok(metadata) => metadata,
+            Err(error) if error.kind() == std::io::ErrorKind::NotFound => break,
+            Err(error) => return Err(error.into()),
+        };
+        anyhow::ensure!(
+            !metadata.file_type().is_symlink(),
+            "isolated state and home paths may not contain symlinks"
+        );
+        #[cfg(windows)]
+        {
+            use std::os::windows::fs::MetadataExt;
+            anyhow::ensure!(
+                metadata.file_attributes() & 0x400 == 0,
+                "isolated state and home paths may not contain reparse points"
+            );
+        }
+    }
+    Ok(())
+}
+
+fn isolation_comparison_path(path: &Path) -> anyhow::Result<PathBuf> {
+    let mut current = path;
+    let mut tail = Vec::new();
+    loop {
+        match fs::canonicalize(current) {
+            Ok(mut resolved) => {
+                for part in tail.iter().rev() {
+                    resolved.push(part);
+                }
+                return Ok(resolved);
+            }
+            Err(error) if error.kind() == std::io::ErrorKind::NotFound => {
+                tail.push(current.file_name().ok_or(error)?);
+                current = current
+                    .parent()
+                    .ok_or_else(|| anyhow::anyhow!("path has no existing ancestor"))?;
+            }
+            Err(error) => return Err(error.into()),
+        }
+    }
+}
+
+fn isolation_path_is_within(path: &Path, root: &Path) -> bool {
+    #[cfg(windows)]
+    {
+        let normalize = |value: &Path| {
+            value
+                .to_string_lossy()
+                .replace('/', "\\")
+                .trim_end_matches('\\')
+                .to_ascii_lowercase()
+        };
+        let path = normalize(path);
+        let root = normalize(root);
+        path == root || path.starts_with(&format!("{root}\\"))
+    }
+    #[cfg(not(windows))]
+    path.starts_with(root)
+}
