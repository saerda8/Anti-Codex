+#[cfg(windows)]
+pub fn stop_codex_processes_and_wait_for_app_path(target_app_path: &Path) -> anyhow::Result<()> {
+    crate::app_paths::validate_isolated_copied_app_dir(target_app_path)?;
+    let executable = crate::app_paths::build_codex_executable(target_app_path);
+    anyhow::ensure!(
+        executable.is_absolute() && executable.is_file(),
+        "isolated executable is invalid"
+    );
+    let snapshot = crate::windows_integration::enumerate_processes();
+    ensure_isolated_processes_visible(&snapshot, &executable)?;
+    let mut handles = Vec::new();
+    for process in snapshot {
+        if !process
+            .executable_path
+            .as_deref()
+            .is_some_and(|path| same_isolated_executable(path, &executable))
+        {
+            continue;
+        }
+        let Some(handle) =
+            crate::windows_integration::VerifiedStopProcess::capture(process.process_id, true)?
+        else {
+            continue;
+        };
+        if !same_isolated_executable(&handle.image()?, &executable) {
+            continue;
+        }
+        handle.terminate()?;
+        handles.push(handle);
+    }
+    let deadline =
+        std::time::Instant::now() + std::time::Duration::from_millis(RESTART_STOP_WAIT_TIMEOUT_MS);
+    loop {
+        let mut alive = false;
+        for process in &handles {
+            alive |= process.is_alive()?;
+        }
+        if !alive {
+            return Ok(());
+        }
+        anyhow::ensure!(
+            std::time::Instant::now() < deadline,
+            "isolated Codex process did not exit"
+        );
+        std::thread::sleep(std::time::Duration::from_millis(
+            RESTART_STOP_WAIT_INTERVAL_MS,
+        ));
+    }
+}
+
+#[cfg(not(windows))]
+pub fn stop_codex_processes_and_wait_for_app_path(_target_app_path: &Path) -> anyhow::Result<()> {
+    anyhow::bail!("isolated process stop is not supported on this platform")
+}
