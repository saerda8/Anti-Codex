+pub(crate) fn newest_thread_rollout_in(
+    directory: &Path,
+    thread_id: &str,
+    remaining_depth: usize,
+    newest: &mut Option<(SystemTime, PathBuf)>,
+) {
+    let Ok(entries) = std::fs::read_dir(directory) else {
+        return;
+    };
+    for entry in entries.flatten() {
+        let Ok(file_type) = entry.file_type() else {
+            continue;
+        };
+        let path = entry.path();
+        if file_type.is_dir() && remaining_depth > 0 {
+            newest_thread_rollout_in(&path, thread_id, remaining_depth - 1, newest);
+            continue;
+        }
+        if !file_type.is_file()
+            || !entry
+                .file_name()
+                .to_str()
+                .is_some_and(|name| thread_rollout_filename_matches(name, thread_id))
+        {
+            continue;
+        }
+        let modified = entry
+            .metadata()
+            .and_then(|metadata| metadata.modified())
+            .unwrap_or(UNIX_EPOCH);
+        if newest
+            .as_ref()
+            .is_none_or(|(current, _)| modified > *current)
+        {
+            *newest = Some((modified, path));
+        }
+    }
+}
