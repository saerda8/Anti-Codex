+struct HistoryResponseSink<'a, S> {
+    inner: &'a mut S,
+    history: Option<&'a crate::protocol_proxy::UpstreamResponseHistory>,
+    observer: Option<crate::protocol_proxy::HistoryResponsesSseObserver>,
+}
+
+impl<'a, S: SseSink> HistoryResponseSink<'a, S> {
+    fn new(
+        inner: &'a mut S,
+        history: Option<&'a crate::protocol_proxy::UpstreamResponseHistory>,
+    ) -> Self {
+        let observer = history.map(|history| {
+            let persist = history.complete_chain
+                && history
+                    .effective_request
+                    .get("store")
+                    .and_then(Value::as_bool)
+                    != Some(false);
+            crate::protocol_proxy::HistoryResponsesSseObserver::for_history_capture(persist)
+        });
+        Self {
+            inner,
+            history,
+            observer,
+        }
+    }
+
+    async fn finish(&mut self, upstream_succeeded: bool) -> std::io::Result<Option<String>> {
+        let Some(observer) = self.observer.take() else {
+            return Ok(None);
+        };
+        if !upstream_succeeded {
+            return Ok(None);
+        }
+        let outcome = observer.finish();
+        if let Some(failure) = outcome.failure.as_ref() {
+            return Ok(Some(failure.clone()));
+        }
+        let Some(mut completed) = outcome.completed_response.clone() else {
+            let error = crate::response_history::ResponseHistoryError::Invalid {
+                reason: "completed stream has no response object".to_string(),
+            };
+            let response = serde_json::json!({"id": outcome.response_id, "output": []});
+            self.inner
+                .send(&response_history_failed_sse(&response, &error))
+                .await?;
+            return Ok(Some(error.to_string()));
+        };
+        if completed.get("status").and_then(Value::as_str) != Some("completed") {
+            let error = crate::response_history::ResponseHistoryError::Invalid {
+                reason: "stream completion did not contain a completed response".to_string(),
+            };
+            let response = if completed.is_object() {
+                completed
+            } else {
+                serde_json::json!({"id": outcome.response_id, "output": []})
+            };
+            self.inner
+                .send(&response_history_failed_sse(&response, &error))
+                .await?;
+            return Ok(Some(error.to_string()));
+        }
+        apply_local_response_history_parent(&mut completed, self.history);
+        if let Err(error) = persist_response_history(self.history, &completed) {
+            self.inner
+                .send(&response_history_failed_sse(&completed, &error))
+                .await?;
+            return Ok(Some(error.to_string()));
+        }
+        self.inner.send(&outcome.terminal_bytes(&completed)).await?;
+        Ok(None)
+    }
+}
+
+impl<S: SseSink> SseSink for HistoryResponseSink<'_, S> {
+    async fn send(&mut self, bytes: &[u8]) -> std::io::Result<()> {
+        match self.observer.as_mut() {
+            Some(observer) => {
+                let forward = observer.push_bytes(bytes);
+                if !forward.is_empty() {
+                    self.inner.send(&forward).await?;
+                }
+                Ok(())
+            }
+            None => self.inner.send(bytes).await,
+        }
+    }
+
+    async fn wait_for_disconnect(&mut self) {
+        self.inner.wait_for_disconnect().await;
+    }
+}
+
+fn persist_response_history(
+    context: Option<&crate::protocol_proxy::UpstreamResponseHistory>,
+    response: &Value,
+) -> Result<(), crate::response_history::ResponseHistoryError> {
+    let Some(context) = context else {
+        return Ok(());
+    };
+    if !context.complete_chain {
+        return Ok(());
+    }
+    context
+        .store
+        .persist_completed(&context.effective_request, response)
+        .map(|_| ())
+}
+
+fn apply_local_response_history_parent(
+    response: &mut Value,
+    context: Option<&crate::protocol_proxy::UpstreamResponseHistory>,
+) {
+    if let (Some(object), Some(parent_id)) = (
+        response.as_object_mut(),
+        context
+            .filter(|value| value.locally_resolved)
+            .and_then(|value| value.parent_id.as_ref()),
+    ) {
+        object.insert(
+            "previous_response_id".to_string(),
+            Value::String(parent_id.clone()),
+        );
+    }
+}
+
+fn response_history_failed_sse(
+    completed_response: &Value,
+    error: &crate::response_history::ResponseHistoryError,
+) -> Vec<u8> {
+    let mut response = completed_response.clone();
+    response["status"] = Value::String("failed".to_string());
+    response["error"] = serde_json::json!({
+        "type": "response_history_error",
+        "message": "Response history persistence failed.",
+        "details": {"status": error.http_status(), "retryable": false}
+    });
+    format!(
+        "event: response.failed\ndata: {}\n\n",
+        serde_json::json!({"type":"response.failed", "response":response})
+    )
+    .into_bytes()
+}
+
+async fn write_response_history_http_error(
+    stream: &mut tokio::net::TcpStream,
+    error: &crate::response_history::ResponseHistoryError,
+) -> anyhow::Result<()> {
+    let status = response_history_status_line(error.http_status());
+    write_http_response(
+        stream,
+        status,
+        "application/json; charset=utf-8",
+        &serde_json::to_vec(&error.response_body())?,
+    )
+    .await
+}
+
+fn response_history_status_line(status: u16) -> &'static str {
+    match status {
+        400 => "400 Bad Request",
+        410 => "410 Gone",
+        _ => "500 Internal Server Error",
+    }
 }
 
