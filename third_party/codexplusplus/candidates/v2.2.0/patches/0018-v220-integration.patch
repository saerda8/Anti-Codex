+pub(crate) fn select_anticodex_relay_for_model(
+    settings: &BackendSettings,
+    request_json: &mut Value,
+) -> anyhow::Result<Option<RelayProfile>> {
+    let Some(requested_model) = request_json
+        .get("model")
+        .and_then(Value::as_str)
+        .map(str::trim)
+        .filter(|model| !model.is_empty())
+    else {
+        return Ok(None);
+    };
+    if requested_model == ANTICODEX_THIRD_PARTY_MODEL_SLOT
+        || requested_model.starts_with(ANTICODEX_THIRD_PARTY_MODEL_PREFIX)
+    {
+        let relay = relay_profile_by_id(settings, ANTICODEX_THIRD_PARTY_RELAY_ID)
+            .ok_or_else(|| anyhow::anyhow!("Anti-Codex third-party relay is not configured"))?;
+        let upstream = requested_model
+            .strip_prefix(ANTICODEX_THIRD_PARTY_MODEL_PREFIX)
+            .filter(|model| !model.is_empty())
+            .unwrap_or(relay.test_model.trim());
+        if upstream.is_empty() {
+            anyhow::bail!("Anti-Codex third-party model is not configured")
+        }
+        request_json["model"] = Value::String(upstream.to_string());
+        return Ok(Some(relay));
+    }
+    let Some(relay) = relay_profile_by_id(settings, ANTICODEX_ANTIGRAVITY_RELAY_ID) else {
+        if requested_model == ANTICODEX_ANTIGRAVITY_MODEL_SLOT {
+            anyhow::bail!("Anti-Codex Antigravity relay is not configured")
+        }
+        return Ok(None);
+    };
+    if requested_model == ANTICODEX_ANTIGRAVITY_MODEL_SLOT {
+        let upstream = relay.test_model.trim();
+        if upstream.is_empty() {
+            anyhow::bail!("Anti-Codex Antigravity model is not configured")
+        }
+        request_json["model"] = Value::String(upstream.to_string());
+        return Ok(Some(relay));
+    }
+    Ok(relay_model_list_contains(&relay, requested_model).then_some(relay))
+}
