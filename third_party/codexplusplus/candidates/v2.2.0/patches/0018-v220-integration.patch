+pub(crate) fn parse_prompt_layer(value: &Value, nullable: bool) -> Option<AntiCodexPromptLayer> {
+    let value = value.as_object()?;
+    let enabled = match value.get("enabled") {
+        Some(Value::Bool(enabled)) => *enabled,
+        None => true,
+        Some(_) => return None,
+    };
+    let content = match value.get("content")? {
+        Value::Null if nullable => None,
+        Value::String(content) if content.chars().count() <= ANTICODEX_PROMPT_LAYER_MAX_CHARS => {
+            Some(content.clone())
+        }
+        _ => return None,
+    };
+    Some(AntiCodexPromptLayer { enabled, content })
+}
+
+pub(crate) fn supported_instruction_carrier(body: &Value) -> bool {
+    match body.get("instructions") {
+        None | Some(Value::Null | Value::String(_)) => true,
+        Some(Value::Array(parts)) => parts.iter().all(|part| {
+            part.as_str().is_some() || part.get("text").and_then(Value::as_str).is_some()
+        }),
+        Some(_) => false,
+    }
+}
+
+pub(crate) fn remove_instruction_carriers(body: &mut Value) {
+    if let Some(object) = body.as_object_mut() {
+        object.remove("instructions");
+    }
+    remove_developer_carriers(body);
+}
+
+pub(crate) fn remove_developer_carriers(body: &mut Value) {
+    for key in ["input", "messages"] {
+        let Some(value) = body.get_mut(key) else {
+            continue;
+        };
+        match value {
+            Value::Array(items) => items.retain(|item| !is_editable_instruction_message(item)),
+            Value::Object(_) if is_editable_instruction_message(value) => {
+                *value = Value::Array(Vec::new());
+            }
+            _ => {}
+        }
+    }
+}
+
+pub(crate) fn is_editable_instruction_message(message: &Value) -> bool {
+    message
+        .get("role")
+        .and_then(Value::as_str)
+        .is_some_and(|role| {
+            role.eq_ignore_ascii_case("system") || role.eq_ignore_ascii_case("developer")
+        })
+}
+
+pub(crate) fn set_instructions(body: &mut Value, content: &str) {
+    let Some(body) = body.as_object_mut() else {
+        return;
+    };
+    if content.is_empty() {
+        body.remove("instructions");
+    } else {
+        body.insert("instructions".to_string(), json!(content));
+    }
+}
+
+pub(crate) fn append_instructions(body: &mut Value, content: &str) {
+    if content.is_empty() {
+        return;
+    }
+    let current = body
+        .get("instructions")
+        .map(instruction_text)
+        .unwrap_or_default();
+    let combined = if current.is_empty() {
+        content.to_string()
+    } else {
+        format!("{current}\n\n{content}")
+    };
+    set_instructions(body, &combined);
+}
