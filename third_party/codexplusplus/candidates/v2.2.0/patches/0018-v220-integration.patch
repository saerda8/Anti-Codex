+        assert!(thread_rollout_filename_matches(&old, THREAD));
+        assert!(thread_rollout_filename_matches(&shard, THREAD));
+        for bad in [
+            format!("rollout-x{THREAD}.jsonl"),
+            format!("rollout-{THREAD}0.jsonl"),
+            format!("rollout-{THREAD}_{TURN}0.jsonl"),
+            format!("rollout-{THREAD}_bad.jsonl"),
+            format!("rollout-{THREAD}_{}.jsonl", TURN.replace('-', "")),
+            format!("rollout-11234567-89ab-cdef-0123-456789abcdef_{TURN}.jsonl"),
+            format!("rollout-{THREAD}_{TURN}.jsonl.bak"),
+            format!("rollout-{THREAD}_{TURN}_extra.jsonl"),
+        ] {
+            assert!(!thread_rollout_filename_matches(&bad, THREAD), "{bad}");
+        }
+        let temp = tempfile::tempdir().unwrap();
+        write_rollout(temp.path(), &format!("rollout-{THREAD}_{TURN}0.jsonl"), OLD);
+        assert_eq!(latest_thread_model_from_rollout(temp.path(), THREAD), None);
+        for name in [old, shard] {
+            let temp = tempfile::tempdir().unwrap();
+            write_rollout(temp.path(), &name, SELECTED);
+            assert_eq!(
+                latest_thread_model_from_rollout(temp.path(), THREAD).as_deref(),
+                Some(SELECTED)
+            );
+        }
+    }
