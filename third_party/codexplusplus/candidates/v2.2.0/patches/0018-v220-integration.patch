diff --git a/apps/codex-plus-launcher/src/anticodex-helper.rs b/apps/codex-plus-launcher/src/anticodex-helper.rs
new file mode 100644
index 0000000..d9f23b5
--- /dev/null
+++ b/apps/codex-plus-launcher/src/anticodex-helper.rs
@@ -0,0 +1,155 @@
+#![cfg_attr(all(windows, not(test)), windows_subsystem = "windows")]
+
+use std::path::PathBuf;
+
+#[derive(Debug, PartialEq)]
+struct Arguments {
+    helper_only: bool,
+    app_dir: Option<PathBuf>,
+    debug_port: u16,
+    helper_port: u16,
+    helper_port_explicit: bool,
+}
+
+fn parse_args(args: impl IntoIterator<Item = String>) -> Result<Arguments, String> {
+    let mut result = Arguments {
+        helper_only: false,
+        app_dir: None,
+        debug_port: 9229,
+        helper_port: 57321,
+        helper_port_explicit: false,
+    };
+    let mut args = args.into_iter();
+    while let Some(arg) = args.next() {
+        match arg.as_str() {
+            "--helper-only" => result.helper_only = true,
+            "--app-path" => {
+                result.app_dir = Some(PathBuf::from(
+                    args.next().ok_or("Missing --app-path value")?,
+                ))
+            }
+            "--debug-port" | "--helper-port" => {
+                let value = args.next().ok_or_else(|| format!("Missing {arg} value"))?;
+                let port = value
+                    .parse::<u16>()
+                    .map_err(|_| format!("Invalid {arg} value"))?;
+                if arg == "--helper-port" {
+                    result.helper_port = port;
+                    result.helper_port_explicit = true;
+                } else {
+                    result.debug_port = port;
+                }
+            }
+            _ => return Err(format!("Unknown argument: {arg}")),
+        }
+    }
+    if result.helper_only == result.app_dir.is_some() {
+        return Err("Choose --helper-only or an explicit --app-path".into());
+    }
+    Ok(result)
+}
+
+fn validate_helper_port_for_isolation(args: &Arguments, isolated: bool) -> Result<(), String> {
+    if isolated && args.helper_only && !args.helper_port_explicit {
+        return Err("An isolated helper requires an explicit --helper-port".into());
+    }
+    Ok(())
+}
+
+#[cfg(not(test))]
+fn main() {
+    if let Err(error) = run() {
+        eprintln!("{error:#}");
+        std::process::exit(1);
+    }
+}
+
+#[cfg(not(test))]
+fn run() -> anyhow::Result<()> {
+    let args: Vec<_> = std::env::args().skip(1).collect();
+    if args == ["--version"] {
+        println!("codex-plus-plus {}", env!("CARGO_PKG_VERSION"));
+        return Ok(());
+    }
+    if args == ["--help"] {
+        println!(
+            "codex-plus-plus --helper-only [--helper-port PORT] | --app-path PATH [--debug-port PORT] [--helper-port PORT]"
+        );
+        return Ok(());
+    }
+    let args = parse_args(args).map_err(anyhow::Error::msg)?;
+    let isolated = codex_plus_core::paths::validate_isolated_environment()?;
+    validate_helper_port_for_isolation(&args, isolated).map_err(anyhow::Error::msg)?;
+    if args.helper_only {
+        codex_plus_core::resident_helper::ensure_resident_helper(args.helper_port)?;
+    } else {
+        codex_plus_core::paths::validate_isolated_protocol_proxy_port(true)?;
+        codex_plus_launcher::start(codex_plus_launcher::LaunchOptions {
+            app_dir: args.app_dir,
+            debug_port: args.debug_port,
+            helper_port: args.helper_port,
+            ..Default::default()
+        })?;
+    }
+    // The fixed-route supervisor owns termination; this process needs neither a GUI nor a console.
+    loop {
+        std::thread::park();
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn parse(args: &[&str]) -> Result<Arguments, String> {
+        parse_args(args.iter().map(|value| value.to_string()))
+    }
+
+    #[test]
+    fn helper_mode_accepts_the_managed_port_and_ephemeral_probe() {
+        for port in ["18484", "0"] {
+            let args = parse(&["--helper-only", "--helper-port", port]).unwrap();
+            assert!(args.helper_only);
+            assert_eq!(args.helper_port, port.parse::<u16>().unwrap());
+            assert!(validate_helper_port_for_isolation(&args, true).is_ok());
+            assert!(args.app_dir.is_none());
+        }
+    }
+
+    #[test]
+    fn isolated_helper_never_uses_the_shared_default_port() {
+        let args = parse(&["--helper-only"]).unwrap();
+        assert!(validate_helper_port_for_isolation(&args, true).is_err());
+        assert!(validate_helper_port_for_isolation(&args, false).is_ok());
+    }
+
+    #[test]
+    fn invalid_or_ambiguous_arguments_fail_before_starting_any_service() {
+        for args in [
+            vec![],
+            vec!["--unknown"],
+            vec!["--helper-only", "--helper-port"],
+            vec!["--helper-only", "--helper-port", "65536"],
+            vec!["--helper-only", "--app-path", "app"],
+        ] {
+            assert!(parse(&args).is_err(), "{args:?}");
+        }
+    }
+
+    #[test]
+    fn explicit_desktop_launch_keeps_the_original_arguments() {
+        let args = parse(&[
+            "--app-path",
+            "isolated-app",
+            "--debug-port",
+            "18318",
+            "--helper-port",
+            "18484",
+        ])
+        .unwrap();
+        assert!(!args.helper_only);
+        assert_eq!(args.app_dir, Some(PathBuf::from("isolated-app")));
+        assert_eq!(args.debug_port, 18318);
+        assert_eq!(args.helper_port, 18484);
+    }
+}
