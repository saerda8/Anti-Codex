+pub fn find_codex_processes_for_app_path(target_app_path: &Path) -> anyhow::Result<Vec<u32>> {
+    crate::app_paths::validate_isolated_copied_app_dir(target_app_path)?;
+    let executable = crate::app_paths::build_codex_executable(target_app_path);
+    anyhow::ensure!(
+        executable.is_absolute() && executable.is_file(),
+        "isolated executable is invalid"
+    );
+    let snapshot = crate::windows_integration::enumerate_processes();
+    ensure_isolated_processes_visible(&snapshot, &executable)?;
+    Ok(find_isolated_processes_from_snapshot(
+        &snapshot,
+        &executable,
+    ))
+}
+
+#[cfg(windows)]
+fn ensure_isolated_processes_visible(
+    processes: &[crate::windows_integration::WindowsProcessInfo],
+    executable: &Path,
+) -> anyhow::Result<()> {
+    let name = executable
+        .file_name()
+        .ok_or_else(|| anyhow::anyhow!("isolated executable name is missing"))?
+        .to_string_lossy();
+    anyhow::ensure!(
+        !processes
+            .iter()
+            .any(|p| p.exe_file.eq_ignore_ascii_case(&name) && p.executable_path.is_none()),
+        "cannot identify an isolated executable process safely"
+    );
+    Ok(())
+}
+
+#[cfg(windows)]
+fn find_isolated_processes_from_snapshot(
+    processes: &[crate::windows_integration::WindowsProcessInfo],
+    executable: &Path,
+) -> Vec<u32> {
+    processes
+        .iter()
+        .filter(|process| {
+            process
+                .executable_path
+                .as_deref()
+                .is_some_and(|path| same_isolated_executable(path, executable))
+        })
+        .map(|process| process.process_id)
+        .collect()
+}
