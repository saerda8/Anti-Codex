+pub(crate) fn anticodex_model_is_routable(settings: &BackendSettings, model: &str) -> bool {
+    if model == ANTICODEX_THIRD_PARTY_MODEL_SLOT
+        || model.starts_with(ANTICODEX_THIRD_PARTY_MODEL_PREFIX)
+    {
+        return true;
+    }
+    relay_profile_by_id(settings, ANTICODEX_ANTIGRAVITY_RELAY_ID)
+        .as_ref()
+        .is_some_and(|relay| {
+            model == ANTICODEX_ANTIGRAVITY_MODEL_SLOT || relay_model_list_contains(relay, model)
+        })
+}
+
+pub(crate) fn align_codex_compaction_model_with_live_selection(
+    settings: &BackendSettings,
+    request_json: &mut Value,
+    turn_metadata: Option<&str>,
+) -> bool {
+    if !request_is_codex_compaction(request_json, turn_metadata) {
+        return false;
+    }
+    let codex_home = crate::codex_home::default_codex_home_dir();
+    align_codex_compaction_model_with_live_selection_in(
+        settings,
+        request_json,
+        turn_metadata,
+        &codex_home,
+    )
+}
+
+fn align_codex_compaction_model_with_live_selection_in(
+    settings: &BackendSettings,
+    request_json: &mut Value,
+    turn_metadata: Option<&str>,
+    codex_home: &Path,
+) -> bool {
+    if !request_is_codex_compaction(request_json, turn_metadata) {
+        return false;
+    }
+    let thread_model = codex_compaction_thread_id(request_json, turn_metadata)
+        .and_then(|thread_id| latest_thread_model_from_rollout(codex_home, &thread_id))
+        .filter(|model| anticodex_model_is_routable(settings, model));
+    if thread_model.is_none()
+        && request_json
+            .get("model")
+            .and_then(Value::as_str)
+            .is_some_and(|model| anticodex_model_is_routable(settings, model.trim()))
+    {
+        return false;
+    }
+    let selected = thread_model.or_else(|| {
+        std::fs::read_to_string(codex_home.join("config.toml"))
+            .ok()
+            .and_then(|contents| crate::relay_config::root_key_string(&contents, "model"))
+            .filter(|model| anticodex_model_is_routable(settings, model))
+    });
+    let Some(selected) = selected else {
+        return false;
+    };
+    if request_json.get("model").and_then(Value::as_str) == Some(selected.as_str()) {
+        return false;
+    }
+    request_json["model"] = Value::String(selected);
+    true
+}
