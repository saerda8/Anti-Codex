 /// 上游 → Responses 的整条归一化链路（Chat / Anthropic / 原生 Responses）因此只有一份。
 pub(crate) trait SseSink {
     async fn send(&mut self, bytes: &[u8]) -> std::io::Result<()>;
+
+    async fn wait_for_disconnect(&mut self) {
+        std::future::pending::<()>().await;
+    }
+}
+
+#[derive(Debug)]
+struct DownstreamDisconnected;
+
+impl std::fmt::Display for DownstreamDisconnected {
+    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        formatter.write_str("downstream disconnected")
+    }
+}
+
+impl std::error::Error for DownstreamDisconnected {}
+
+async fn wait_for_tcp_downstream_disconnect(stream: &tokio::net::TcpStream) {
+    // shortcut: unread extra bytes delay FIN detection; upgrade this for pipelined requests.
+    let mut probe = [0u8; 1];
+    loop {
+        match stream.peek(&mut probe).await {
+            Ok(0) | Err(_) => return,
+            Ok(_) => tokio::time::sleep(std::time::Duration::from_millis(25)).await,
+        }
+    }
+}
+
+async fn await_tcp_upstream_or_downstream_disconnect<F>(
+    downstream: &tokio::net::TcpStream,
+    upstream: F,
+) -> Result<F::Output, DownstreamDisconnected>
+where
+    F: std::future::Future,
+{
+    tokio::select! {
+        biased;
+        _ = wait_for_tcp_downstream_disconnect(downstream) => Err(DownstreamDisconnected),
+        output = upstream => Ok(output),
+    }
+}
+
+async fn await_upstream_or_downstream_disconnect<S, F>(
+    downstream: &mut S,
+    upstream: F,
+) -> Result<F::Output, DownstreamDisconnected>
+where
+    S: SseSink,
+    F: std::future::Future,
+{
+    tokio::select! {
+        biased;
+        _ = downstream.wait_for_disconnect() => Err(DownstreamDisconnected),
+        output = upstream => Ok(output),
+    }
+}
